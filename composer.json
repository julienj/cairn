{
    "name": "julienj/cairn",
    "description": "An issue tracker for a web agency and its clients: one instance, a workspace per client, each seeing what their role allows.",
    "type": "project",
    "license": "MIT",
    "keywords": ["issue tracker", "symfony", "helpdesk", "kanban"],
    "homepage": "https://github.com/julienj/cairn",
    "support": {
        "issues": "https://github.com/julienj/cairn/issues",
        "source": "https://github.com/julienj/cairn"
    },
    "minimum-stability": "beta",
    "prefer-stable": true,
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-zip": "*",
        "api-platform/mcp": "^5.0",
        "api-platform/symfony": "^5.0.8",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.7",
        "endroid/qr-code": "^6.2",
        "league/commonmark": "^2.10",
        "nelmio/security-bundle": "^3.9",
        "nyholm/psr7": "^1.8",
        "phpdocumentor/reflection-docblock": "^6.0",
        "phpstan/phpdoc-parser": "^2.4.1",
        "scheb/2fa-bundle": "^8.8",
        "scheb/2fa-totp": "^8.8",
        "symfony/asset": "8.2.*",
        "symfony/console": "8.2.*",
        "symfony/doctrine-messenger": "8.2.*",
        "symfony/dotenv": "8.2.*",
        "symfony/expression-language": "8.2.*",
        "symfony/flex": "^2.12",
        "symfony/form": "8.2.*",
        "symfony/framework-bundle": "8.2.*",
        "symfony/http-client": "8.2.*",
        "symfony/intl": "8.2.*",
        "symfony/lock": "8.2.*",
        "symfony/mailer": "8.2.*",
        "symfony/mcp-bundle": "^0.15.0",
        "symfony/mercure-bundle": "^0.7.0",
        "symfony/mime": "8.2.*",
        "symfony/monolog-bundle": "^3.0|^4.0",
        "symfony/notifier": "8.2.*",
        "symfony/polyfill-php86": "^1.43",
        "symfony/process": "8.2.*",
        "symfony/property-access": "8.2.*",
        "symfony/property-info": "8.2.*",
        "symfony/rate-limiter": "8.2.*",
        "symfony/reprise": "^1.4",
        "symfony/runtime": "8.2.*",
        "symfony/scheduler": "8.2.*",
        "symfony/security-bundle": "8.2.*",
        "symfony/serializer": "8.2.*",
        "symfony/stimulus-bundle": "^3.7",
        "symfony/string": "8.2.*",
        "symfony/translation": "8.2.*",
        "symfony/twig-bundle": "8.2.*",
        "symfony/uid": "8.2.*",
        "symfony/ux-icons": "^3.7",
        "symfony/ux-live-component": "^3.7.2",
        "symfony/ux-turbo": "^3.7",
        "symfony/ux-twig-component": "^3.7",
        "symfony/validator": "8.2.*",
        "symfony/web-link": "8.2.*",
        "symfony/webhook": "8.2.*",
        "symfony/workflow": "8.2.*",
        "symfony/yaml": "8.2.*",
        "symfonycasts/reset-password-bundle": "^1.26",
        "tales-from-a-dev/twig-tailwind-extra": "^1.5",
        "twig/extra-bundle": "^2.12|^3.0",
        "twig/intl-extra": "^3.31",
        "twig/twig": "^2.12|^3.0",
        "web-token/jwt-library": "^4.2"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "phpstan/extension-installer": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*",
        "symfony/polyfill-php85": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": "true",
            "require": "8.2.*"
        }
    },
    "require-dev": {
        "brianium/paratest": "^7.29",
        "dama/doctrine-test-bundle": "^8.7",
        "friendsofphp/php-cs-fixer": "^3.95.32",
        "iq2i/storia-bundle": "^0.7.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-symfony": "^2.1",
        "phpunit/phpunit": "^13.4",
        "symfony/browser-kit": "8.2.*",
        "symfony/css-selector": "8.2.*",
        "symfony/debug-bundle": "8.2.*",
        "symfony/maker-bundle": "^1.0",
        "symfony/stopwatch": "8.2.*",
        "symfony/web-profiler-bundle": "8.2.*",
        "zenstruck/foundry": "^2.17"
    }
}
