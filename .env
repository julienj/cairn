# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost:8000
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# Inside the Docker stack, compose.yaml overrides this with the "database" service; this value is for a PHP running on the host.
DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=18&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
# Inside the Docker stack, compose.yaml points this to Mailpit (http://localhost:8025).
MAILER_DSN=null://null
# Sender of the notification mails.
MAILER_FROM="Cairn <no-reply@cairn.test>"
###< symfony/mailer ###

###> cairn ###
# Language of the instance: the UI is translated into it, and all content
# (configuration labels, projects, issues, comments) is written in it.
# English (en) and French (fr) are shipped.
CAIRN_LOCALE=en
# Hours in a day of work, for the whole instance: budgets are stored in
# minutes and shown in days or in hours, per project. Changing it changes
# every quantity shown in days.
CAIRN_HOURS_PER_DAY=7
# Who must sign in with a second factor (TOTP): optional (each account chooses), internal (internal users must,
# external ones choose) or all. The accounts of the identity provider are never asked: it has its own.
CAIRN_TWO_FACTOR=optional
# Files sent with descriptions and comments, outside public/: served with access checks.
ATTACHMENTS_DIR=%kernel.project_dir%/var/attachments_%kernel.environment%
###< cairn ###

###> cairn forge ###
# Instance-level access to the forges, used to install the webhooks of the
# repositories linked to projects. An empty token means the webhooks are
# installed by hand, with the URL and secret the settings page shows.
# Real values go in .env.local.
FORGE_GITLAB_URL=https://gitlab.com
FORGE_GITLAB_TOKEN=
# The secret of a system hook of the GitLab instance, which then delivers
# every repository: nothing is installed per repository, and Cairn needs no
# token. Empty means there is none. Its limits are in the README.
FORGE_GITLAB_HOOK_SECRET=
###< cairn forge ###

###> cairn sso ###
# Single sign-on, optional: an OpenID Connect provider (Google, Entra,
# Keycloak...) that signs in the accounts an administrator told to use it.
# Without OIDC_PROVIDER_URI nobody signs in that way and no page offers it.
# OIDC_PROVIDER_URI is the issuer (https://accounts.google.com); the
# redirect URI to register there is DEFAULT_URI + /login/sso/callback.
# OIDC_NAME is how the button of the sign-in page names it.
# Real values go in .env.local.
OIDC_PROVIDER_URI=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_NAME=SSO
###< cairn sso ###

###> cairn import ###
# Where the archives to import wait (Administration > Imports): a zip sent
# from the administration lands there, a large one is dropped there by
# hand. Imported archives move to its `archive/` folder.
IMPORTS_DIR=%kernel.project_dir%/var/imports_%kernel.environment%
###< cairn import ###

###> symfony/mercure-bundle ###
# Real time, optional: with a Mercure hub, issue lists and kanbans follow what
# others change. Without MERCURE_URL nothing is published and no page listens.
# MERCURE_URL is where the application publishes (may be a local address),
# MERCURE_PUBLIC_URL where browsers subscribe. The hub must trust the tokens
# signed with MERCURE_JWT_SECRET by MERCURE_JWT_ISSUER, which say what each
# page may listen to, and refuse anonymous subscribers.
# MERCURE_JWT_SECRET has no default: a random string of 32 characters or
# more, in .env.local, shared with the hub and with nobody else.
MERCURE_URL=
MERCURE_PUBLIC_URL=/.well-known/mercure
MERCURE_JWT_SECRET=
MERCURE_JWT_ISSUER=https://localhost
###< symfony/mercure-bundle ###
