{% extends 'layout/account.html.twig' %}

{% block page_title %}{{ 'api_token.title'|trans }}{% endblock %}

{% block page_intro %}{{ 'api_token.intro'|trans }}{% endblock %}

{% block page_actions %}<twig:Ui:Button icon="book-open" href="{{ path('api_doc') }}" data-turbo="false">{{ 'api_token.documentation'|trans }}</twig:Ui:Button>{% endblock %}

{% block page_width %}max-w-5xl{% endblock %}

{# The API tokens of the signed-in user: the `active` ones, each revoked after confirming in place, the `past` ones (revoked or expired) kept as a trace, and the form creating one.
   The secret of the token just created arrives once in the `api_token_secret` flash, read here before the toaster sees the flashes, with a request to copy and try. #}
{% block content %}
    {% set tokenSecrets = app.flashes('api_token_secret') %}
        {% for tokenSecret in tokenSecrets %}
            <section class="rounded-lg border border-emerald-line bg-emerald-soft/60 p-4" role="status">
                <div class="flex items-center gap-2 text-emerald">
                    <twig:ux:icon name="lucide:key-round" class="h-4 w-4" />
                    <h2 class="font-semibold">{{ 'api_token.created.title'|trans }}</h2>
                </div>
                <p class="mt-1 text-sm text-emerald/80">{{ 'api_token.created.hint'|trans }}</p>
                <div class="mt-3 flex items-stretch gap-2" data-controller="clipboard">
                    <code class="min-w-0 flex-1 select-all break-all rounded-md bg-surface px-3 py-2 font-mono text-sm text-strong ring-1 ring-inset ring-emerald-line" data-clipboard-target="source" data-test="api-token-secret">{{ tokenSecret }}</code>
                    <twig:Ui:Button variant="primary" icon="copy" data-action="clipboard#copy">
                        <span data-clipboard-target="idle">{{ 'api_token.created.copy'|trans }}</span>
                        <span data-clipboard-target="done" hidden>{{ 'api_token.created.copied'|trans }}</span>
                    </twig:Ui:Button>
                </div>
                <p class="mt-3 text-xs text-emerald/80">{{ 'api_token.created.usage'|trans }}</p>
                <div class="mt-1 flex items-start gap-2" data-controller="clipboard">
                    <pre class="min-w-0 flex-1 overflow-x-auto rounded-md bg-slate-900 px-3 py-2 font-mono text-xs text-slate-100" data-clipboard-target="source">curl -H "Authorization: Bearer {{ tokenSecret }}" {{ url('app_home') }}api/me</pre>
                    <twig:Ui:CopyButton :label="'api_token.created.copy'|trans" :copiedLabel="'api_token.created.copied'|trans" />
                </div>
            </section>
        {% endfor %}

        <div class="grid gap-5 items-start lg:grid-cols-[1fr_22rem]">
            <div class="space-y-5 min-w-0">
                <twig:Ui:Panel :title="'api_token.active'|trans" :count="active|length">
                    <ul class="divide-y divide-line-subtle">
                        {% for token in active %}
                            <li class="px-4 py-3">
                                <div class="flex flex-wrap items-center gap-2">
                                    <twig:ux:icon name="lucide:key-round" class="h-4 w-4 shrink-0 text-faint" />
                                    <span class="font-medium text-strong">{{ token.name }}</span>
                                    <twig:Ui:Badge :tone="token.scope.value == 'write' ? 'amber' : 'gray'" size="sm">{{ ('api_token.scope.' ~ token.scope.value)|trans }}</twig:Ui:Badge>
                                    <span class="ml-auto text-xs text-muted">{{ token.expiresAt ? 'api_token.expires_on'|trans({ '%date%': token.expiresAt|format_date('short') }) : 'api_token.no_expiry'|trans }}</span>
                                </div>
                                <p class="mt-1 pl-6 text-xs text-muted">
                                    {{ 'api_token.created_on'|trans({ '%date%': token.createdAt|format_date('short') }) }}
                                    · {{ token.lastUsedAt ? 'api_token.last_used'|trans({ '%date%': token.lastUsedAt|format_datetime('short', 'short') }) : 'api_token.never_used'|trans }}
                                </p>
                                <twig:Ui:Disclosure :closedLabel="'api_token.revoke'|trans" :openLabel="'issue.edit.cancel'|trans" class="mt-1.5 pl-6">
                                    <twig:Ui:Callout tone="danger" size="sm" class="mt-2 flex flex-wrap items-center gap-2" role="alertdialog">
                                        <span class="flex-1">{{ 'api_token.revoke_confirm'|trans }}</span>
                                        <form method="post" action="{{ path('app_api_token_revoke', { token: token.id }) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('submit') }}" data-controller="csrf-protection">
                                            <twig:Ui:Button type="submit" size="sm" variant="danger" icon="trash-2">{{ 'api_token.revoke'|trans }}</twig:Ui:Button>
                                        </form>
                                    </twig:Ui:Callout>
                                </twig:Ui:Disclosure>
                            </li>
                        {% else %}
                            <li><twig:Ui:EmptyState :title="'api_token.empty'|trans" icon="key-round">{{ 'api_token.empty_hint'|trans }}</twig:Ui:EmptyState></li>
                        {% endfor %}
                    </ul>
                </twig:Ui:Panel>

                {% if past is not empty %}
                    <twig:Ui:Panel :title="'api_token.past'|trans" :count="past|length" muted>
                        <ul class="divide-y divide-line-subtle text-sm" data-test="api-tokens-past">
                            {% for token in past %}
                                <li class="flex flex-wrap items-center gap-2 px-4 py-2 text-muted">
                                    <span class="font-medium line-through decoration-line-strong">{{ token.name }}</span>
                                    <twig:Ui:Badge size="sm">{{ ('api_token.scope.' ~ token.scope.value)|trans }}</twig:Ui:Badge>
                                    <span class="ml-auto text-xs">
                                        {{ token.revoked ? 'api_token.revoked_on'|trans({ '%date%': token.revokedAt|format_date('short') }) : 'api_token.expired_on'|trans({ '%date%': token.expiresAt|format_date('short') }) }}
                                    </span>
                                </li>
                            {% endfor %}
                        </ul>
                    </twig:Ui:Panel>
                {% endif %}
            </div>

            {{ form_start(form, { attr: { class: 'rounded-lg border border-line bg-surface p-4 space-y-4 lg:sticky lg:top-16' } }) }}
                <h2 class="font-semibold text-strong">{{ 'api_token.new'|trans }}</h2>
                {{ form_errors(form) }}
                {{ form_row(form.name) }}
                {{ form_row(form.scope) }}
                {{ form_row(form.lifetime) }}
                <twig:Ui:Button type="submit" variant="primary" size="lg" icon="plus" class="w-full justify-center">{{ 'api_token.create'|trans }}</twig:Ui:Button>
            {{ form_end(form) }}
        </div>
{% endblock %}
