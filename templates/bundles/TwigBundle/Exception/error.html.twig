{# What a person reads when a page fails (403, 404, 500…), instead of the page of the framework.
   A skeleton of its own on purpose: an error may come from a database that does not answer, so
   nothing here reads the session, the signed-in user, the navigation nor the configuration. #}
{% set errorThemeChoice = theme_choice() %}
{% set errorKey = status_code in [403, 404, 500] ? status_code : 'other' %}
<!DOCTYPE html>
<html lang="{{ app.locale }}"{% if errorThemeChoice != 'system' %} data-theme="{{ errorThemeChoice }}"{% endif %}>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="color-scheme" content="{{ errorThemeChoice == 'system' ? 'light dark' : errorThemeChoice }}">
        <meta name="robots" content="noindex">
        <title>{{ ('error.' ~ errorKey ~ '.title')|trans }} · Cairn</title>
        {# The same tags as base.html.twig: Turbo shows the answer in place instead of loading the failing address again. #}
        {{ reprise_entry_link_tags('styles', attributes={'data-turbo-track': 'reload'}) }}
        {{ reprise_entry_script_tags('app', attributes={'data-turbo-track': 'reload'}) }}
    </head>
    <body class="min-h-screen bg-canvas text-body text-sm antialiased">
        <main class="min-h-screen grid place-items-center px-4">
            <div class="w-full max-w-sm">
                <div class="mb-6 flex items-center justify-center gap-2">
                    <span class="h-8 w-8 rounded bg-brand-solid grid place-items-center text-white font-bold">C</span>
                    <span class="text-lg font-semibold text-strong">Cairn</span>
                </div>
                <div class="rounded-lg border border-line bg-surface p-6 space-y-4 text-center">
                    <p class="text-xs text-muted">{{ 'error.code'|trans({'%code%': status_code}) }}</p>
                    <h1 class="text-base font-semibold text-strong">{{ ('error.' ~ errorKey ~ '.title')|trans }}</h1>
                    <p class="text-sm text-muted">{{ ('error.' ~ errorKey ~ '.text')|trans }}</p>
                    <twig:Ui:Button variant="primary" size="lg" href="{{ path('app_home') }}" class="w-full">{{ 'error.home'|trans }}</twig:Ui:Button>
                </div>
            </div>
        </main>
    </body>
</html>
