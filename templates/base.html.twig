<!DOCTYPE html>
{% set themeChoice = theme_choice() %}
<html lang="{{ app.locale }}"{% if themeChoice != 'system' %} data-theme="{{ themeChoice }}"{% endif %}{% if sidebar_collapsed() %} data-sidebar="collapsed"{% endif %}>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="color-scheme" content="{{ themeChoice == 'system' ? 'light dark' : themeChoice }}">
        <title>{% block title %}Cairn{% endblock %}</title>
        <link rel="icon" href="{{ asset('favicon.svg') }}" type="image/svg+xml">
        {% block stylesheets %}
            {{ reprise_entry_link_tags('styles', attributes={'data-turbo-track': 'reload'}) }}
        {% endblock %}

        {% block javascripts %}
            {{ reprise_entry_script_tags('app', attributes={'data-turbo-track': 'reload'}) }}
        {% endblock %}
    </head>
    <body class="min-h-screen bg-canvas text-body text-sm antialiased">
        {% block body %}{% endblock %}
        <twig:Ui:Toaster>
            {% for messages in app.flashes %}
                {% for message in messages %}
                    <twig:Ui:Toast>{{ message }}</twig:Ui:Toast>
                {% endfor %}
            {% endfor %}
        </twig:Ui:Toaster>
    </body>
</html>
