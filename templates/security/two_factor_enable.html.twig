{# Sets the second factor up, in the layout of the sign-in: `form`, `qrCode`, `secret`; `required` says the instance holds the account to it. #}
{% extends 'security/layout.html.twig' %}

{% block title %}{{ 'account.two_factor.setup.title'|trans }} · Cairn{% endblock %}

{% block card %}
    {{ form_start(form, { attr: { class: 'rounded-lg border border-line bg-surface p-6 space-y-4' } }) }}
        <div>
            <h1 class="text-base font-semibold text-strong">{{ 'account.two_factor.setup.title'|trans }}</h1>
            <p class="mt-1 text-sm text-muted">{{ 'account.two_factor.setup.intro'|trans }}</p>
        </div>

        {% if required %}
            <twig:Ui:Callout tone="amber" size="sm" role="alert">{{ 'account.two_factor.required_notice'|trans }}</twig:Ui:Callout>
        {% endif %}

        <img src="{{ qrCode }}" alt="{{ 'account.two_factor.setup.qr_alt'|trans }}" width="200" height="200" class="mx-auto rounded-md border border-line" data-test="totp-qr">
        <div class="text-sm">
            <p class="text-muted">{{ 'account.two_factor.setup.manual'|trans }}</p>
            <code class="mt-1 block select-all break-all rounded-md bg-subtle px-3 py-2 font-mono text-strong" data-test="totp-secret">{{ secret }}</code>
        </div>

        {{ form_errors(form) }}
        {{ form_row(form.code) }}

        <twig:Ui:Button type="submit" variant="primary" size="lg" class="w-full">{{ 'account.two_factor.setup.submit'|trans }}</twig:Ui:Button>

        {% if required %}
            <a href="{{ path('app_logout') }}" class="block text-center text-xs text-brand hover:underline">{{ 'auth.two_factor.cancel'|trans }}</a>
        {% else %}
            <a href="{{ path('app_account_two_factor') }}" class="block text-center text-xs text-brand hover:underline">{{ 'account.two_factor.setup.cancel'|trans }}</a>
        {% endif %}
    {{ form_end(form) }}
{% endblock %}
