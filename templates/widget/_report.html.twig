{# What the widget noted on the site a problem is reported from, as the issue keeps it (`report`, a Widget/TechnicalReport, or null): the page, the environment, the errors of the console, the Ajax requests that failed, the pages seen. Shown to the reporter before sending, then on the page of the issue. Everything in it is what a site said: text, never markup nor a link. #}
{% if report is null %}
    <p class="text-sm text-muted">{{ 'widget.report.none'|trans }}</p>
{% else %}
    {% set reportEnvironment = report.environment %}
    <div class="space-y-4 text-sm">
        <p class="text-xs text-muted">{{ 'widget.report.intro'|trans }}</p>

        <section class="space-y-1">
            <h3 class="text-xs font-semibold text-strong">{{ 'widget.report.page'|trans }}</h3>
            {% if report.page.title %}<div class="text-strong">{{ report.page.title }}</div>{% endif %}
            <div class="break-all font-mono text-xs text-body">{{ report.page.url }}</div>
        </section>

        <section class="space-y-1">
            <h3 class="text-xs font-semibold text-strong">{{ 'widget.report.environment'|trans }}</h3>
            <dl class="grid grid-cols-[7rem_1fr] gap-x-2 gap-y-1">
                {% if reportEnvironment.userAgent %}
                    <dt class="text-muted">{{ 'widget.report.browser'|trans }}</dt>
                    <dd class="min-w-0">
                        {% if report.browser %}<div class="text-strong">{{ report.browser }}</div>{% endif %}
                        <div class="break-words font-mono text-xs text-muted">{{ reportEnvironment.userAgent }}</div>
                    </dd>
                {% endif %}
                {% if reportEnvironment.viewport %}
                    <dt class="text-muted">{{ 'widget.report.viewport'|trans }}</dt>
                    <dd class="text-strong">{{ reportEnvironment.viewport.width }} × {{ reportEnvironment.viewport.height }}</dd>
                {% endif %}
                {% if reportEnvironment.screen %}
                    <dt class="text-muted">{{ 'widget.report.screen'|trans }}</dt>
                    <dd class="text-strong">{{ reportEnvironment.screen.width }} × {{ reportEnvironment.screen.height }}{% if reportEnvironment.pixelRatio %} · ×{{ reportEnvironment.pixelRatio }}{% endif %}</dd>
                {% endif %}
                {% if reportEnvironment.language %}
                    <dt class="text-muted">{{ 'widget.report.language'|trans }}</dt>
                    <dd class="text-strong">{{ reportEnvironment.language }}</dd>
                {% endif %}
                {% if reportEnvironment.version %}
                    <dt class="text-muted">{{ 'widget.report.version'|trans }}</dt>
                    <dd class="font-mono text-xs text-strong">{{ reportEnvironment.version }}</dd>
                {% endif %}
            </dl>
        </section>

        <section class="space-y-1">
            <h3 class="text-xs font-semibold text-strong">{{ 'widget.report.errors'|trans({ '%count%': report.errors|length }) }}</h3>
            {% if report.errors is empty %}
                <p class="text-xs text-muted">{{ 'widget.report.none'|trans }}</p>
            {% else %}
                <ul class="space-y-1.5 rounded-md border border-red-line bg-red-soft px-2.5 py-2 font-mono text-xs text-red">
                    {% for error in report.errors %}
                        <li class="break-words">
                            {{ error.message }}
                            {% if error.source or error.at %}<div class="opacity-80">{{ error.source }}{% if error.source and error.at %} · {% endif %}{% if error.at %}{{ error.at|date('H:i:s') }}{% endif %}</div>{% endif %}
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>

        <section class="space-y-1">
            <h3 class="text-xs font-semibold text-strong">{{ 'widget.report.requests'|trans({ '%count%': report.requests|length }) }}</h3>
            <p class="text-xs text-muted">{{ 'widget.report.requests_help'|trans }}</p>
            {% if report.requests is empty %}
                <p class="text-xs text-muted">{{ 'widget.report.none'|trans }}</p>
            {% else %}
                <ul class="space-y-1 font-mono text-xs">
                    {% for request in report.requests %}
                        <li class="flex items-start gap-2">
                            <twig:Ui:Badge tone="red" size="sm">{{ request.status ?: 'widget.report.network'|trans }}</twig:Ui:Badge>
                            <span class="min-w-0 break-all text-strong">{{ request.method }} {{ request.url }}</span>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>

        <section class="space-y-1">
            <h3 class="text-xs font-semibold text-strong">{{ 'widget.report.pages'|trans({ '%count%': report.pages|length }) }}</h3>
            <p class="text-xs text-muted">{{ 'widget.report.pages_help'|trans }}</p>
            {% if report.pages is empty %}
                <p class="text-xs text-muted">{{ 'widget.report.none'|trans }}</p>
            {% else %}
                <ul class="space-y-1 font-mono text-xs">
                    {% for page in report.pages %}
                        <li class="flex items-start gap-2">
                            <span class="w-12 shrink-0 text-muted">{{ page.at ? page.at|date('H:i') : '' }}</span>
                            <span class="min-w-0 break-all text-strong">{{ page.url }}</span>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>
    </div>
{% endif %}
