{# What the widget noted on the site a problem is reported from, as the issue keeps it (`report`, a Widget/TechnicalReport, or null): the page, the environment, what the site says of itself, what happened in its order (the pages seen, what the reporter did, the errors of the console, what failed on the network). Shown to the reporter before sending, then on the page of the issue. Everything in it is what a site said: text, never markup nor a link. #}
{% if report is null %}
    <p class="text-sm text-muted">{{ 'widget.report.none'|trans }}</p>
{% else %}
    {% set reportEnvironment = report.environment %}
    <div class="space-y-4 text-sm">
        <p class="text-xs text-muted">{{ 'widget.report.intro'|trans }}</p>

        <section class="space-y-1">
            <h3 class="text-xs font-semibold text-strong">{{ 'widget.report.page'|trans }}</h3>
            {% if report.page.title %}<div class="text-strong">{{ report.page.title }}</div>{% endif %}
            <div class="break-all font-mono text-xs text-body">{{ report.page.url }}</div>
        </section>

        <section class="space-y-1">
            <h3 class="text-xs font-semibold text-strong">{{ 'widget.report.environment'|trans }}</h3>
            <dl class="grid grid-cols-[7rem_1fr] gap-x-2 gap-y-1">
                {% if reportEnvironment.userAgent %}
                    <dt class="text-muted">{{ 'widget.report.browser'|trans }}</dt>
                    <dd class="min-w-0">
                        {% if report.browser %}<div class="text-strong">{{ report.browser }}</div>{% endif %}
                        <div class="break-words font-mono text-xs text-muted">{{ reportEnvironment.userAgent }}</div>
                    </dd>
                {% endif %}
                {% if reportEnvironment.viewport %}
                    <dt class="text-muted">{{ 'widget.report.viewport'|trans }}</dt>
                    <dd class="text-strong">{{ reportEnvironment.viewport.width }} × {{ reportEnvironment.viewport.height }}</dd>
                {% endif %}
                {% if reportEnvironment.screen %}
                    <dt class="text-muted">{{ 'widget.report.screen'|trans }}</dt>
                    <dd class="text-strong">{{ reportEnvironment.screen.width }} × {{ reportEnvironment.screen.height }}{% if reportEnvironment.pixelRatio %} · ×{{ reportEnvironment.pixelRatio }}{% endif %}</dd>
                {% endif %}
                {% if reportEnvironment.zoom %}
                    <dt class="text-muted">{{ 'widget.report.zoom'|trans }}</dt>
                    <dd class="text-strong">{{ (reportEnvironment.zoom * 100)|round }} %</dd>
                {% endif %}
                {% if reportEnvironment.language %}
                    <dt class="text-muted">{{ 'widget.report.language'|trans }}</dt>
                    <dd class="text-strong">{{ reportEnvironment.language }}</dd>
                {% endif %}
                {% set reportPreferences = reportEnvironment.preferences %}
                {% if reportPreferences %}
                    {# Each preference the system holds, as people name it: what is the default (light, fine pointer, no request) is said only for the theme and the pointer. #}
                    {% set preferenceTexts = [
                        reportPreferences.colorScheme ? ('widget.report.preference.' ~ reportPreferences.colorScheme)|trans,
                        reportPreferences.pointer ? ('widget.report.preference.pointer_' ~ reportPreferences.pointer)|trans,
                        reportPreferences.reducedMotion ? 'widget.report.preference.reduced_motion'|trans,
                        reportPreferences.contrast ? ('widget.report.preference.contrast_' ~ reportPreferences.contrast)|trans,
                        reportPreferences.forcedColors ? 'widget.report.preference.forced_colors'|trans,
                    ]|filter(text => text) %}
                    {% if preferenceTexts is not empty %}
                        <dt class="text-muted">{{ 'widget.report.preferences'|trans }}</dt>
                        <dd class="text-strong">{{ preferenceTexts|join(' · ') }}</dd>
                    {% endif %}
                {% endif %}
            </dl>
        </section>

        {% if report.context is not empty %}
            <section class="space-y-1">
                <h3 class="text-xs font-semibold text-strong">{{ 'widget.report.context'|trans }}</h3>
                <dl class="grid grid-cols-[7rem_1fr] gap-x-2 gap-y-1">
                    {% for contextName, contextValue in report.context %}
                        <dt class="truncate text-muted" title="{{ contextName }}">{{ contextName }}</dt>
                        <dd class="min-w-0 break-words text-strong">{{ contextValue }}</dd>
                    {% endfor %}
                </dl>
            </section>
        {% endif %}

        {# What happened, in its order: the pages seen, what the reporter did, the errors of the console and what failed on the network, read together from the lists of the report (`timeline`); what has no moment comes last. #}
        {% set reportTimeline = report.timeline %}
        {# Each kind with its count is a filter: pressed while its lines show, struck through once they are hidden. #}
        {% set activityKinds = { page: report.pages|length, action: report.actions|length, error: report.errors|length, request: report.network|length } %}
        <section class="space-y-1" data-controller="timeline">
            <h3 class="flex flex-wrap items-baseline gap-x-1.5 text-xs font-semibold text-strong">
                {{ 'widget.report.activity'|trans }}
                {% for activityKind, activityCount in activityKinds|filter(count => count > 0) %}
                    <span class="font-normal text-muted" aria-hidden="true">·</span>
                    <button type="button" class="cursor-pointer rounded-sm font-normal text-muted hover:text-strong aria-[pressed=false]:line-through aria-[pressed=false]:opacity-60" aria-pressed="true" title="{{ 'widget.report.filter'|trans }}" data-kind="{{ activityKind }}" data-action="timeline#toggle">{{ ('widget.report.count.' ~ activityKind)|trans({ '%count%': activityCount }) }}</button>
                {% endfor %}
            </h3>
            <p class="text-xs text-muted">{{ 'widget.report.activity_help'|trans }}</p>
            {% if reportTimeline is empty %}
                <p class="text-xs text-muted">{{ 'widget.report.none'|trans }}</p>
            {% else %}
                <ol class="space-y-1.5 text-xs">
                    {% for event in reportTimeline %}
                        {% set eventEntry = event.entry %}
                        <li class="flex items-start gap-2" data-timeline-target="line" data-kind="{{ event.type }}">
                            <span class="w-14 shrink-0 font-mono text-muted">{{ event.at ? event.at|date('H:i:s') : '' }}</span>
                            {% if event.type == 'action' %}
                                <twig:Ui:Badge tone="indigo" size="sm" class="shrink-0">{{ ('widget.report.action.' ~ eventEntry.kind)|trans }}</twig:Ui:Badge>
                                <span class="min-w-0 break-words">
                                    <span class="text-strong">{% if eventEntry.name %}{{ eventEntry.name }}{% else %}{{ eventEntry.role ?? 'widget.report.action.unnamed'|trans }}{% endif %}</span>
                                    {% if eventEntry.name and eventEntry.role %}<span class="text-muted">· {{ eventEntry.role }}</span>{% endif %}
                                    {% if eventEntry.count > 1 %}<span class="text-muted">· ×{{ eventEntry.count }}</span>{% endif %}
                                    {% if eventEntry.selector %}<span class="block break-all font-mono text-muted">{{ eventEntry.selector }}</span>{% endif %}
                                </span>
                            {% elseif event.type == 'page' %}
                                <twig:Ui:Badge size="sm" class="shrink-0">{{ 'widget.report.event.page'|trans }}</twig:Ui:Badge>
                                <span class="min-w-0 break-all font-mono text-body">{{ eventEntry.url }}</span>
                            {% elseif event.type == 'request' %}
                                <twig:Ui:Badge size="sm" class="shrink-0">{{ ('widget.report.kind.' ~ eventEntry.kind)|trans }}</twig:Ui:Badge>
                                {% if eventEntry.status is not null %}<twig:Ui:Badge tone="red" size="sm" class="shrink-0">{{ eventEntry.status ?: 'widget.report.no_answer'|trans }}</twig:Ui:Badge>{% endif %}
                                <span class="min-w-0 break-all font-mono text-strong">{% if eventEntry.method %}{{ eventEntry.method }} {% endif %}{{ eventEntry.url }}</span>
                            {% else %}
                                <twig:Ui:Badge tone="red" size="sm" class="shrink-0">{{ 'widget.report.event.error'|trans }}</twig:Ui:Badge>
                                <span class="min-w-0 break-words font-mono text-red">
                                    {{ eventEntry.message }}
                                    {% if eventEntry.source %}<span class="block break-all opacity-80">{{ eventEntry.source }}</span>{% endif %}
                                </span>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ol>
            {% endif %}
        </section>
    </div>
{% endif %}
