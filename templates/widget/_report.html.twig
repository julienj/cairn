{# What the widget noted on the site a problem is reported from, as the issue keeps it (`report`, a Widget/TechnicalReport, or null): the page, the environment, what the site says of itself, the errors of the console, what failed on the network (Ajax requests and files, in their order), how the page performed, the pages seen. Shown to the reporter before sending, then on the page of the issue. Everything in it is what a site said: text, never markup nor a link. #}
{% if report is null %}
    <p class="text-sm text-muted">{{ 'widget.report.none'|trans }}</p>
{% else %}
    {% set reportEnvironment = report.environment %}
    <div class="space-y-4 text-sm">
        <p class="text-xs text-muted">{{ 'widget.report.intro'|trans }}</p>

        <section class="space-y-1">
            <h3 class="text-xs font-semibold text-strong">{{ 'widget.report.page'|trans }}</h3>
            {% if report.page.title %}<div class="text-strong">{{ report.page.title }}</div>{% endif %}
            <div class="break-all font-mono text-xs text-body">{{ report.page.url }}</div>
        </section>

        <section class="space-y-1">
            <h3 class="text-xs font-semibold text-strong">{{ 'widget.report.environment'|trans }}</h3>
            <dl class="grid grid-cols-[7rem_1fr] gap-x-2 gap-y-1">
                {% if reportEnvironment.userAgent %}
                    <dt class="text-muted">{{ 'widget.report.browser'|trans }}</dt>
                    <dd class="min-w-0">
                        {% if report.browser %}<div class="text-strong">{{ report.browser }}</div>{% endif %}
                        <div class="break-words font-mono text-xs text-muted">{{ reportEnvironment.userAgent }}</div>
                    </dd>
                {% endif %}
                {% if reportEnvironment.viewport %}
                    <dt class="text-muted">{{ 'widget.report.viewport'|trans }}</dt>
                    <dd class="text-strong">{{ reportEnvironment.viewport.width }} × {{ reportEnvironment.viewport.height }}</dd>
                {% endif %}
                {% if reportEnvironment.screen %}
                    <dt class="text-muted">{{ 'widget.report.screen'|trans }}</dt>
                    <dd class="text-strong">{{ reportEnvironment.screen.width }} × {{ reportEnvironment.screen.height }}{% if reportEnvironment.pixelRatio %} · ×{{ reportEnvironment.pixelRatio }}{% endif %}</dd>
                {% endif %}
                {% if reportEnvironment.zoom %}
                    <dt class="text-muted">{{ 'widget.report.zoom'|trans }}</dt>
                    <dd class="text-strong">{{ (reportEnvironment.zoom * 100)|round }} %</dd>
                {% endif %}
                {% if reportEnvironment.language %}
                    <dt class="text-muted">{{ 'widget.report.language'|trans }}</dt>
                    <dd class="text-strong">{{ reportEnvironment.language }}</dd>
                {% endif %}
                {% set reportPreferences = reportEnvironment.preferences %}
                {% if reportPreferences %}
                    {# Each preference the system holds, as people name it: what is the default (light, fine pointer, no request) is said only for the theme and the pointer. #}
                    {% set preferenceTexts = [
                        reportPreferences.colorScheme ? ('widget.report.preference.' ~ reportPreferences.colorScheme)|trans,
                        reportPreferences.pointer ? ('widget.report.preference.pointer_' ~ reportPreferences.pointer)|trans,
                        reportPreferences.reducedMotion ? 'widget.report.preference.reduced_motion'|trans,
                        reportPreferences.contrast ? ('widget.report.preference.contrast_' ~ reportPreferences.contrast)|trans,
                        reportPreferences.forcedColors ? 'widget.report.preference.forced_colors'|trans,
                    ]|filter(text => text) %}
                    {% if preferenceTexts is not empty %}
                        <dt class="text-muted">{{ 'widget.report.preferences'|trans }}</dt>
                        <dd class="text-strong">{{ preferenceTexts|join(' · ') }}</dd>
                    {% endif %}
                {% endif %}
            </dl>
        </section>

        {% if report.context is not empty %}
            <section class="space-y-1">
                <h3 class="text-xs font-semibold text-strong">{{ 'widget.report.context'|trans }}</h3>
                <dl class="grid grid-cols-[7rem_1fr] gap-x-2 gap-y-1">
                    {% for contextName, contextValue in report.context %}
                        <dt class="truncate text-muted" title="{{ contextName }}">{{ contextName }}</dt>
                        <dd class="min-w-0 break-words text-strong">{{ contextValue }}</dd>
                    {% endfor %}
                </dl>
            </section>
        {% endif %}

        <section class="space-y-1">
            <h3 class="text-xs font-semibold text-strong">{{ 'widget.report.errors'|trans({ '%count%': report.errors|length }) }}</h3>
            {% if report.errors is empty %}
                <p class="text-xs text-muted">{{ 'widget.report.none'|trans }}</p>
            {% else %}
                <ul class="space-y-1.5 rounded-md border border-red-line bg-red-soft px-2.5 py-2 font-mono text-xs text-red">
                    {% for error in report.errors %}
                        <li class="break-words">
                            {{ error.message }}
                            {% if error.source or error.at %}<div class="opacity-80">{{ error.source }}{% if error.source and error.at %} · {% endif %}{% if error.at %}{{ error.at|date('H:i:s') }}{% endif %}</div>{% endif %}
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>

        {% set reportNetwork = report.network %}
        <section class="space-y-1">
            <h3 class="text-xs font-semibold text-strong">{{ 'widget.report.network'|trans({ '%count%': reportNetwork|length }) }}</h3>
            <p class="text-xs text-muted">{{ 'widget.report.network_help'|trans }}</p>
            {% if reportNetwork is empty %}
                <p class="text-xs text-muted">{{ 'widget.report.none'|trans }}</p>
            {% else %}
                <ul class="space-y-1 font-mono text-xs">
                    {% for request in reportNetwork %}
                        <li class="flex items-start gap-2">
                            <span class="w-14 shrink-0 text-muted">{{ request.at ? request.at|date('H:i:s') : '' }}</span>
                            <twig:Ui:Badge size="sm" class="shrink-0">{{ ('widget.report.kind.' ~ request.kind)|trans }}</twig:Ui:Badge>
                            {% if request.status is not null %}<twig:Ui:Badge tone="red" size="sm" class="shrink-0">{{ request.status ?: 'widget.report.no_answer'|trans }}</twig:Ui:Badge>{% endif %}
                            <span class="min-w-0 break-all text-strong">{% if request.method %}{{ request.method }} {% endif %}{{ request.url }}</span>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>

        {% set reportMeasures = report.measures %}
        {% if reportMeasures is not empty %}
            <section class="space-y-2">
                <h3 class="text-xs font-semibold text-strong">{{ 'widget.report.performance'|trans }}</h3>
                <p class="text-xs text-muted">{{ 'widget.report.performance_help'|trans }}</p>
                <div class="grid grid-cols-2 gap-2 sm:grid-cols-3">
                    {% for measure in reportMeasures %}
                        {# a time in milliseconds, in seconds from one; the CLS is a score #}
                        {% set measureValue = measure.name == 'cls' ? measure.value|format_number({ fraction_digit: 2 }) : (measure.value < 1000 ? measure.value ~ ' ms' : (measure.value / 1000)|format_number({ fraction_digit: 1 }) ~ ' s') %}
                        <twig:Ui:Measure :label="('widget.report.measure.' ~ measure.name ~ '.label')|trans" :value="measureValue" :rating="measure.rating" :position="measure.position" :caption="('widget.report.measure.' ~ measure.name ~ '.help')|trans" />
                    {% endfor %}
                </div>
            </section>
        {% endif %}

        <section class="space-y-1">
            <h3 class="text-xs font-semibold text-strong">{{ 'widget.report.pages'|trans({ '%count%': report.pages|length }) }}</h3>
            <p class="text-xs text-muted">{{ 'widget.report.pages_help'|trans }}</p>
            {% if report.pages is empty %}
                <p class="text-xs text-muted">{{ 'widget.report.none'|trans }}</p>
            {% else %}
                <ul class="space-y-1 font-mono text-xs">
                    {% for page in report.pages %}
                        <li class="flex items-start gap-2">
                            <span class="w-12 shrink-0 text-muted">{{ page.at ? page.at|date('H:i') : '' }}</span>
                            <span class="min-w-0 break-all text-strong">{{ page.url }}</span>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>
    </div>
{% endif %}
