{#
 # Application form theme, registered globally in config/packages/twig.yaml.
 # Every block delegates to a Form:* component, so a field looks the same
 # whether it is written by hand or rendered by form_row().
 #}
{% use 'form_div_layout.html.twig' %}

{# Label, help and errors around the widget. #}
{% block form_row %}
    {% set rowLabel = label is same as(false) ? null : (label is empty ? (label_format ? label_format|replace({'%name%': name, '%id%': id}) : name|humanize) : label) %}
    {% set rowWidgetAttributes = help is not empty ? { attr: attr|merge({ 'aria-describedby': id ~ '_help' }) } : {} %}
    <twig:Ui:Form:Field
        :label="rowLabel is not null and translation_domain is not same as(false) ? rowLabel|trans(label_translation_parameters, translation_domain) : rowLabel"
        :for="compound ? null : id"
        :required="required"
        :help="help is not empty ? (translation_domain is same as(false) or help_translation_parameters is not defined ? help : help|trans(help_translation_parameters, translation_domain)) : null"
        :helpId="id ~ '_help'"
        {{ ...row_attr }}
    >
        {{ form_widget(form, rowWidgetAttributes) }}
        <twig:block name="errors">{{ form_errors(form) }}</twig:block>
    </twig:Ui:Form:Field>
{% endblock %}

{% block form_errors %}
    {% if errors|length > 0 %}
        <ul class="mt-1 space-y-0.5 text-xs text-red">
            {% for error in errors %}<li>{{ error.message }}</li>{% endfor %}
        </ul>
    {% endif %}
{% endblock %}

{% block form_widget_simple %}
    {% set controlAttributes = { id: id, name: full_name, required: required, disabled: disabled }|merge(attr) %}
    {% if attr.placeholder is defined and translation_domain is not same as(false) %}{% set controlAttributes = controlAttributes|merge({ placeholder: attr.placeholder|trans({}, translation_domain) }) %}{% endif %}
    {% set controlAttributes = type|default('text') == 'file' or value is empty ? controlAttributes : controlAttributes|merge({ value: value }) %}
    <twig:Ui:Form:Input :type="type|default('text')" :invalid="not valid" {{ ...controlAttributes }} />
{% endblock %}

{% block textarea_widget %}
    {% set controlAttributes = { id: id, name: full_name, required: required, disabled: disabled }|merge(attr) %}
    {% if attr.placeholder is defined and translation_domain is not same as(false) %}{% set controlAttributes = controlAttributes|merge({ placeholder: attr.placeholder|trans({}, translation_domain) }) %}{% endif %}
    <twig:Ui:Form:Textarea :invalid="not valid" {{ ...controlAttributes }}>{{ value }}</twig:Ui:Form:Textarea>
{% endblock %}

{% block choice_widget_collapsed %}
    {% set controlAttributes = { id: id, name: full_name, required: required, disabled: disabled }|merge(attr) %}
    {% set controlAttributes = multiple ? controlAttributes|merge({ name: full_name, multiple: true }) : controlAttributes %}
    {% set selectOptions %}
        {%- if placeholder is not none -%}
            <option value=""{% if placeholder_attr|default({}) %}{% with { attr: placeholder_attr } %}{{ block('attributes') }}{% endwith %}{% endif %}{% if required and value is empty %} selected="selected"{% endif %}>{{ placeholder != '' ? (translation_domain is same as(false) ? placeholder : placeholder|trans({}, translation_domain)) }}</option>
        {%- endif -%}
        {%- if preferred_choices|length > 0 -%}
            {% set options = preferred_choices %}
            {% set render_preferred_choices = true %}
            {{- block('choice_widget_options') -}}
            {%- if choices|length > 0 and separator is not none -%}
                <option disabled="disabled">{{ separator }}</option>
            {%- endif -%}
        {%- endif -%}
        {%- set options = choices -%}
        {%- set render_preferred_choices = false -%}
        {{- block('choice_widget_options') -}}
    {% endset %}
    <twig:Ui:Form:Select :invalid="not valid" {{ ...controlAttributes }}>{{ selectOptions }}</twig:Ui:Form:Select>
{% endblock %}

{# Radios render as segments, checkboxes as a stack of Form:Checkbox, one per line; a field whose choices are short asks for a row with its `attr` class (`flex-row flex-wrap gap-x-5`). #}
{% block choice_widget_expanded %}
    {% if multiple %}
        <div class="{{ html_cva(base: 'mt-1 flex flex-col gap-1.5').apply({}, attr.class ?? null)|tailwind_merge }}">
            {% for child in form %}
                <twig:Ui:Form:Checkbox
                    :label="translation_domain is same as(false) ? child.vars.label : child.vars.label|trans(child.vars.label_translation_parameters, choice_translation_domain)"
                    :checked="child.vars.checked"
                    :id="child.vars.id"
                    :name="child.vars.full_name"
                    :value="child.vars.value"
                    :disabled="child.vars.disabled"
                />
                {% do child.setRendered %}
            {% endfor %}
        </div>
    {% else %}
        {% set segmentedOptions = {} %}
        {% for child in form %}
            {% set segmentedOptions = segmentedOptions|merge({ (child.vars.value): (choice_translation_domain is same as(false) ? child.vars.label : child.vars.label|trans(child.vars.label_translation_parameters, choice_translation_domain)) }) %}
            {% do child.setRendered %}
        {% endfor %}
        <twig:Ui:Form:Segmented :options="segmentedOptions" :value="value" :name="full_name" :required="required" :disabled="disabled" />
    {% endif %}
{% endblock %}

{# A single checkbox carries its own label: no separate label above it. #}
{% block checkbox_row %}
    <twig:Ui:Form:Field :help="help is not empty ? help|trans(help_translation_parameters, translation_domain) : null" :helpId="id ~ '_help'">
        {{ form_widget(form) }}
        <twig:block name="errors">{{ form_errors(form) }}</twig:block>
    </twig:Ui:Form:Field>
{% endblock %}

{% block checkbox_widget %}
    <twig:Ui:Form:Checkbox
        :label="label is same as(false) ? '' : (translation_domain is same as(false) ? (label ?? name|humanize) : (label ?? name|humanize)|trans(label_translation_parameters, translation_domain))"
        :checked="checked"
        :id="id"
        :name="full_name"
        :value="value"
        :required="required"
        :disabled="disabled"
    />
{% endblock %}

{% block button_widget %}
    <twig:Ui:Button :type="type|default('button')" :id="id" :name="full_name" :disabled="disabled">{{ translation_domain is same as(false) ? (label ?? name|humanize) : (label ?? name|humanize)|trans(label_translation_parameters, translation_domain) }}</twig:Ui:Button>
{% endblock %}

{% block submit_widget %}
    <twig:Ui:Button variant="primary" type="submit" :id="id" :name="full_name" :disabled="disabled">{{ translation_domain is same as(false) ? (label ?? name|humanize) : (label ?? name|humanize)|trans(label_translation_parameters, translation_domain) }}</twig:Ui:Button>
{% endblock %}

{% block button_row %}
    <div class="mt-2">{{ form_widget(form) }}</div>
{% endblock %}

{# MarkdownType: the rich editor over a hidden textarea. #}
{% block markdown_widget %}
    {% set editorPlaceholder = attr.placeholder is defined ? (translation_domain is same as(false) ? attr.placeholder : attr.placeholder|trans({}, translation_domain)) : '' %}
    <twig:Ui:Form:Editor
        :id="id"
        :name="full_name"
        :required="required"
        :invalid="not valid"
        :disabled="disabled"
        :rows="attr.rows ?? 4"
        :placeholder="editorPlaceholder"
        :issuesUrl="editor_urls.issues"
        :usersUrl="editor_urls.users"
        :uploadUrl="editor_urls.upload"
        {{ ...attr|filter((value, key) => key not in ['placeholder', 'rows']) }}
    >{{ value }}</twig:Ui:Form:Editor>
{% endblock %}

{# ToggleType: a checkbox drawn as a switch, label included. #}
{% block toggle_row %}
    {{ block('checkbox_row') }}
{% endblock %}

{% block toggle_widget %}
    <twig:Ui:Form:Toggle
        :label="label is same as(false) ? '' : (translation_domain is same as(false) ? (label ?? name|humanize) : (label ?? name|humanize)|trans(label_translation_parameters, translation_domain))"
        :checked="checked"
        :id="id"
        :name="full_name"
        :value="value"
        :required="required"
        :disabled="disabled"
    />
{% endblock %}

{# PickerType: a choice among many, searched in a list; the `picker` controller writes it into the hidden field. With a `search_url` the choices (the one chosen, at most) stand in the element the answers of that address replace. #}
{% block picker_widget %}
    {% set pickerChosen = null %}{% set pickerChosenData = null %}{% set pickerNothing = placeholder is not none and placeholder != '' ? (translation_domain is same as(false) ? placeholder : placeholder|trans({}, translation_domain)) : 'form.choose'|trans %}
    {% for choice in choices %}
        {% for option in choice.choices is defined ? choice.choices : [choice] %}
            {% if option.value == value %}{% set pickerChosen = option.label %}{% set pickerChosenData = option.data %}{% endif %}
        {% endfor %}
    {% endfor %}
    <div data-controller="picker" class="mt-1">
        <input type="hidden" id="{{ id }}" name="{{ full_name }}" value="{{ value }}" data-picker-target="input">
        <twig:Ui:Picker :label="pickerChosen" :placeholder="pickerNothing" :searchPlaceholder="'form.search'|trans" :empty="'form.no_match'|trans" :invalid="not valid" :src="search_url">
            {# with `avatars`, the choices are people and teams: each is drawn as who it is, on its line and on the button, nobody included: the button reads the same before a choice and after choosing nobody #}
            <twig:block name="chosen">{% if avatars %}{{ include('form/_picker_line.html.twig', { who: pickerChosenData, nothing: pickerNothing, chosen: true }) }}{% endif %}</twig:block>
            {# a field that may stay empty offers to choose nothing again; on the line of the loop, so that a required field renders as before #}{% if not required %}<twig:Ui:Dropdown:Item :active="value is empty" data-list-filter-target="item" data-text="{{ pickerNothing }}" data-action="picker#choose dropdown#close" data-picker-value-param="" data-picker-label-param="{{ pickerNothing }}">{% if avatars %}{{ include('form/_picker_line.html.twig', { who: null, nothing: pickerNothing }) }}{% else %}<span class="truncate text-muted">{{ pickerNothing }}</span>{% endif %}</twig:Ui:Dropdown:Item>{% endif %}{% if search_url %}<div data-list-filter-target="results">{% endif %}{% for choice in choices %}
                {% if choice.choices is defined %}
                    <twig:Ui:Picker:Group :label="choice.label">
                        {% for option in choice.choices %}
                            <twig:Ui:Dropdown:Item :active="option.value == value" data-list-filter-target="item" data-text="{{ option.label }} {{ choice.label }}" data-action="picker#choose dropdown#close" data-picker-value-param="{{ option.value }}" data-picker-label-param="{{ option.label }}">{% if avatars %}{{ include('form/_picker_line.html.twig', { who: option.data, nothing: pickerNothing }) }}{% else %}<span class="truncate">{{ option.label }}</span>{% endif %}</twig:Ui:Dropdown:Item>
                        {% endfor %}
                    </twig:Ui:Picker:Group>
                {% else %}
                    <twig:Ui:Dropdown:Item :active="choice.value == value" data-list-filter-target="item" data-text="{{ choice.label }}" data-action="picker#choose dropdown#close" data-picker-value-param="{{ choice.value }}" data-picker-label-param="{{ choice.label }}">{% if avatars %}{{ include('form/_picker_line.html.twig', { who: choice.data, nothing: pickerNothing }) }}{% else %}<span class="truncate">{{ choice.label }}</span>{% endif %}</twig:Ui:Dropdown:Item>
                {% endif %}
            {% endfor %}{% if search_url %}</div>{% endif %}
        </twig:Ui:Picker>
    </div>
{% endblock %}

{# CompanyType: free text with the companies already known as suggestions. #}
{% block company_widget %}
    {% set controlAttributes = { id: id, name: full_name, required: required, disabled: disabled }|merge(attr) %}
    {% if attr.placeholder is defined and translation_domain is not same as(false) %}{% set controlAttributes = controlAttributes|merge({ placeholder: attr.placeholder|trans({}, translation_domain) }) %}{% endif %}
    {% set controlAttributes = value is empty ? controlAttributes : controlAttributes|merge({ value: value }) %}
    <twig:Ui:Form:Combobox :suggestions="suggestions" :invalid="not valid" {{ ...controlAttributes }} />
{% endblock %}
