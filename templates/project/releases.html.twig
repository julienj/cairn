{% extends 'layout/project.html.twig' %}

{% block page_title %}{{ 'release.title'|trans }}{% endblock %}

{# The releases of the project: the open ones as cards with their progress (the share of finished issues: statuses are never named), the delivered and abandoned ones as a history. Those who manage releases create and change them in a dialog that has its own address (the `modal` block). #}
{% block content %}
    {% set releasesRoute = { workspaceKey: project.workspace.key, projectKey: project.key } %}
    {% set releasesOpen = summaries|filter(summary => summary.release.open) %}
    {% set releasesPast = summaries|filter(summary => not summary.release.open) %}
    {% set releasesManage = is_granted('release.manage', project) %}
    {% set releasesActions %}
        {% if releasesManage %}<twig:Ui:Button variant="primary" icon="plus" href="{{ path('app_project_release_new', releasesRoute) }}" data-turbo-frame="modal">{{ 'release.new'|trans }}</twig:Ui:Button>{% endif %}
    {% endset %}
    <twig:Ui:PageHeader :title="'release.title'|trans" :count="releasesOpen|length">
        <twig:block name="actions">{{ releasesActions }}</twig:block>
        <twig:block name="description">{{ 'release.intro'|trans }}</twig:block>
    </twig:Ui:PageHeader>

    <div class="px-4 sm:px-6 py-5 max-w-5xl space-y-4">
        {% for summary in releasesOpen %}
            {% set release = summary.release %}
            <section class="rounded-lg border border-line bg-surface px-4 py-3">
                <div class="flex flex-wrap items-center gap-3">
                    <h2 class="font-mono text-lg font-semibold text-strong">{{ release.name }}</h2>
                    {% if release.plannedOn %}
                        <span class="inline-flex items-center gap-1 text-xs text-muted"><twig:ux:icon name="lucide:clock" class="h-3.5 w-3.5" />{{ 'release.planned_on'|trans({ '%date%': release.plannedOn|format_date('short') }) }}</span>
                    {% endif %}
                    {% if releasesManage %}
                        <div class="ml-auto flex items-center gap-2">
                            {{ include('project/_release_status.html.twig', { status: 'delivered', variant: summary.total > 0 and summary.progress == 100 ? 'success' : 'secondary' }) }}
                            <twig:Ui:Button size="sm" icon="pencil" href="{{ path('app_project_release_edit', releasesRoute|merge({ release: release.id })) }}" data-turbo-frame="modal">{{ 'release.edit'|trans }}</twig:Ui:Button>
                        </div>
                    {% endif %}
                </div>
                {% if release.description %}<p class="mt-1.5 text-sm text-muted whitespace-pre-line">{{ release.description }}</p>{% endif %}
                <div class="mt-3 flex items-center gap-3">
                    <twig:Ui:StackedBar :segments="summary.segments" size="sm" class="flex-1" />
                    <span class="w-10 text-right text-xs tabular-nums text-body">{{ summary.progress }} %</span>
                </div>
                <div class="mt-1.5 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-muted">
                    <span>{{ 'issue.list.count'|trans({ '%count%': summary.total }) }}</span>
                    <span>{{ 'release.finished'|trans({ '%count%': summary.byStatus.closed }) }}</span>
                    <a href="{{ path('app_project_issues', releasesRoute|merge({ releases: [release.id], closed: 1 })) }}" class="ml-auto text-brand hover:underline">{{ 'release.see_issues'|trans }}</a>
                </div>
            </section>
        {% else %}
            <twig:Ui:EmptyState :title="'release.empty'|trans" icon="milestone" bordered>{{ (releasesManage ? 'release.empty_hint_manager' : 'release.empty_hint')|trans }}</twig:Ui:EmptyState>
        {% endfor %}

        {% if releasesPast is not empty %}
            <twig:Ui:Panel :title="'release.past'|trans" :count="releasesPast|length">
                <ul class="divide-y divide-line-subtle text-sm">
                    {% for summary in releasesPast %}
                        {% set release = summary.release %}
                        <li class="flex flex-wrap items-center gap-3 px-4 py-2.5">
                            <span class="w-24 shrink-0 font-mono font-medium text-body">{{ release.name }}</span>
                            <twig:Ui:Badge :tone="release.status.value == 'delivered' ? 'emerald' : 'gray'" size="sm">{{ ('release.status.' ~ release.status.value)|trans }}</twig:Ui:Badge>
                            <span class="flex-1 min-w-0 truncate text-muted">{{ release.description }}</span>
                            <span class="text-xs tabular-nums text-muted">{{ 'issue.list.count'|trans({ '%count%': summary.total }) }}</span>
                            {% if release.deliveredAt %}<span class="text-xs text-muted">{{ 'release.delivered_on'|trans({ '%date%': release.deliveredAt|format_date('short') }) }}</span>{% endif %}
                            <a href="{{ path('app_project_issues', releasesRoute|merge({ releases: [release.id], closed: 1 })) }}" class="text-faint hover:text-brand" title="{{ 'release.see_issues'|trans }}"><twig:ux:icon name="lucide:list" class="h-4 w-4" /></a>
                            {% if releasesManage %}
                                {{ include('project/_release_status.html.twig', { status: 'open', variant: 'ghost' }) }}
                                <twig:Ui:IconButton icon="pencil" :label="'release.edit'|trans" href="{{ path('app_project_release_edit', releasesRoute|merge({ release: release.id })) }}" data-turbo-frame="modal" />
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            </twig:Ui:Panel>
        {% endif %}
    </div>

{% endblock %}

{# The dialog creating a release, or changing `dialogRelease`: answered alone to a request made for the frame, so it reads only `project`, `form`, `dialogRelease` and `dialogIssueCount`. The forms abandoning and deleting the release sit beside the one of the dialog, in the frame: their buttons name them. #}
{% block modal %}
    {% set modalRoute = { workspaceKey: project.workspace.key, projectKey: project.key } %}
    {% set modalAbandonForm = '' %}
    {% set modalAbandon = '' %}
    {% if form and dialogRelease %}
        {% set modalAbandonForm %}
            <form id="release-delete" method="post" action="{{ path('app_project_release_delete', modalRoute|merge({ release: dialogRelease.id })) }}" class="hidden">
                <input type="hidden" name="_token" value="{{ csrf_token('submit') }}" data-controller="csrf-protection">
            </form>
            {% if dialogRelease.open %}
            <form id="release-abandon" method="post" action="{{ path('app_project_release_status', modalRoute|merge({ release: dialogRelease.id })) }}" class="hidden">
                <input type="hidden" name="_token" value="{{ csrf_token('submit') }}" data-controller="csrf-protection">
                <input type="hidden" name="status" value="abandoned">
            </form>
            {% endif %}
        {% endset %}
        {% set modalAbandon %}
            {% if dialogRelease.open %}
            <twig:Ui:Callout tone="danger" size="sm" class="mt-4 flex flex-wrap items-center gap-3">
                <p class="flex-1 basis-48">{{ 'release.abandon_help'|trans }}</p>
                <twig:Ui:Button type="submit" variant="danger" size="sm" form="release-abandon">{{ 'release.to_status.abandoned'|trans }}</twig:Ui:Button>
            </twig:Ui:Callout>
            {% endif %}
            <twig:Ui:Callout tone="danger" size="sm" class="mt-3">
                <p>{{ 'release.delete_help'|trans({ '%count%': dialogIssueCount }) }}</p>
                <twig:Ui:Disclosure :closedLabel="'release.delete'|trans" :openLabel="'issue.edit.cancel'|trans" class="mt-1.5">
                    <div class="mt-2 flex flex-wrap items-center gap-3" role="alertdialog">
                        <span class="flex-1 basis-48">{{ 'release.delete_confirm'|trans }}</span>
                        <twig:Ui:Button type="submit" variant="danger" size="sm" icon="trash-2" form="release-delete">{{ 'release.delete'|trans }}</twig:Ui:Button>
                    </div>
                </twig:Ui:Disclosure>
            </twig:Ui:Callout>
        {% endset %}
    {% endif %}
    {{ include('project/_form_dialog.html.twig', {
        title: dialogRelease ? dialogRelease.name : 'release.new'|trans,
        closeHref: path('app_project_releases', modalRoute),
        submitLabel: (dialogRelease ? 'release.save' : 'release.create')|trans,
        before: modalAbandonForm,
        after: modalAbandon,
    }) }}
{% endblock %}
