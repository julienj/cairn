{% extends 'layout/project.html.twig' %}

{% block page_title %}{{ 'release.title'|trans }}{% endblock %}

{# The releases of the project. An open one is a card that answers two questions apart: how far it went (a bar that only counts what is finished, out of what there is), and where the rest stands, by the names of the steps, in the order the instance declares them, each a way to the list of those issues; what is blocking or high among them is told beside. Its date turns amber once passed. The delivered and abandoned ones are a history, a line each, which leads to its issues. Those who manage releases create and change them in a dialog that has its own address (the `modal` block). #}
{% block content %}
    {% set releasesRoute = { workspaceKey: project.workspace.key, projectKey: project.key } %}
    {% set releasesOpen = summaries|filter(summary => summary.release.open) %}
    {% set releasesPast = summaries|filter(summary => not summary.release.open) %}
    {% set releasesManage = is_granted('release.manage', project) %}
    {% set releasesActions %}
        {% if releasesManage %}<twig:Ui:Button variant="primary" icon="plus" href="{{ path('app_project_release_new', releasesRoute) }}" data-turbo-frame="modal">{{ 'release.new'|trans }}</twig:Ui:Button>{% endif %}
    {% endset %}
    <twig:Ui:PageHeader :title="'release.title'|trans" :count="releasesOpen|length">
        <twig:block name="actions">{{ releasesActions }}</twig:block>
        <twig:block name="description">{{ 'release.intro'|trans }}</twig:block>
    </twig:Ui:PageHeader>

    <div class="px-4 sm:px-6 py-5 max-w-5xl space-y-3.5">
        {% for summary in releasesOpen %}
            {% set release = summary.release %}
            <section class="rounded-[10px] border border-line bg-surface shadow-sm transition-colors hover:border-line-strong">
                <div class="px-4 py-3.5">
                <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                    <h2 class="font-mono text-lg font-semibold tracking-tight text-strong">{{ release.name }}</h2>
                    {% if release.plannedOn %}
                        <span class="inline-flex h-[22px] items-center gap-1.5 rounded-full px-2 text-xs tabular-nums {{ summary.late ? 'bg-amber-soft text-amber ring-1 ring-inset ring-amber-line' : 'bg-sunken text-body' }}" title="{{ (summary.late ? 'release.late' : 'release.planned')|trans }}"><twig:ux:icon name="lucide:clock" class="h-3 w-3 {{ summary.late ? '' : 'text-faint' }}" />{{ release.plannedOn|format_date('medium') }}</span>
                    {% endif %}
                    {% if releasesManage %}
                        <div class="ml-auto flex items-center gap-1.5">
                            {{ include('project/_release_status.html.twig', { status: 'delivered', icon: 'check', variant: summary.total > 0 and summary.progress == 100 ? 'success' : 'secondary' }) }}
                            <twig:Ui:IconButton icon="pencil" :label="'release.edit'|trans" href="{{ path('app_project_release_edit', releasesRoute|merge({ release: release.id })) }}" data-turbo-frame="modal" />
                        </div>
                    {% endif %}
                </div>
                {% if release.description %}<p class="mt-1 whitespace-pre-line text-[13.5px] text-muted">{{ release.description }}</p>{% endif %}
                {% if summary.total > 0 %}
                    <div class="mt-3.5">
                        <div class="flex items-baseline gap-2 text-[12.5px] text-muted">
                            <span>{{ 'release.done'|trans }} <span class="text-[13px] font-semibold tabular-nums text-strong">{{ summary.done }}</span> {{ 'release.out_of'|trans }} <span class="text-[13px] font-semibold tabular-nums text-strong">{{ summary.total }}</span></span>
                            <span class="ml-auto font-semibold tabular-nums text-body">{{ summary.progress }} %</span>
                        </div>
                        <twig:Ui:ProgressBar :value="summary.done" :max="summary.total" tone="emerald" size="sm" :label="'release.done'|trans" class="mt-2" />
                    </div>
                    {% if summary.steps is not empty %}
                        <div class="mt-3 flex flex-wrap items-center gap-1.5">
                            <span class="mr-0.5 text-xs text-faint">{{ 'release.left'|trans }}</span>
                            {% for releasesStep in summary.steps %}
                                <a href="{{ path('app_project_issues', releasesRoute|merge({ releases: [release.id], places: [releasesStep.place.id] })) }}" title="{{ 'release.see_step'|trans }}" class="inline-flex h-6 items-center gap-1.5 rounded-md bg-subtle pl-2 pr-1.5 text-xs text-body ring-1 ring-inset ring-line hover:bg-brand-soft hover:text-brand hover:ring-brand-line">
                                    <twig:Ui:Status:Dot :status="releasesStep.place.status.value" />{{ releasesStep.place.label }}
                                    <span class="min-w-4 rounded bg-surface px-1 text-center text-[11px] font-semibold tabular-nums text-strong">{{ releasesStep.issues }}</span>
                                </a>
                            {% endfor %}
                            {% if summary.blocking > 0 %}<span class="inline-flex h-6 items-center gap-1 rounded-md bg-red-soft px-2 text-xs font-medium text-red ring-1 ring-inset ring-red-line"><twig:ux:icon name="lucide:chevrons-up" class="h-3 w-3" />{{ 'release.urgent.blocking'|trans({ '%count%': summary.blocking }) }}</span>{% endif %}
                            {% if summary.high > 0 %}<span class="inline-flex h-6 items-center gap-1 rounded-md bg-orange-soft px-2 text-xs font-medium text-orange ring-1 ring-inset ring-orange-line"><twig:ux:icon name="lucide:chevron-up" class="h-3 w-3" />{{ 'release.urgent.high'|trans({ '%count%': summary.high }) }}</span>{% endif %}
                        </div>
                    {% endif %}
                {% endif %}
                </div>
                <div class="flex items-center border-t border-line-subtle px-4 py-2.5 text-xs text-muted">
                    <span>{{ summary.total == 0 ? 'issue.list.count'|trans({ '%count%': 0 }) : 'release.to_finish'|trans({ '%count%': summary.remaining }) }}</span>
                    {% if summary.total > 0 %}<a href="{{ path('app_project_issues', releasesRoute|merge({ releases: [release.id], closed: 1 })) }}" class="group/see ml-auto inline-flex items-center gap-1 font-medium text-brand hover:underline">{{ 'release.see_issues'|trans }}<twig:ux:icon name="lucide:arrow-right" class="h-3 w-3 transition-transform group-hover/see:translate-x-0.5" /></a>{% endif %}
                </div>
            </section>
        {% else %}
            <twig:Ui:EmptyState :title="'release.empty'|trans" icon="milestone" bordered>{{ (releasesManage ? 'release.empty_hint_manager' : 'release.empty_hint')|trans }}</twig:Ui:EmptyState>
        {% endfor %}

        {% if releasesPast is not empty %}
            <twig:Ui:Panel :title="'release.past'|trans" :count="releasesPast|length">
                <ul class="divide-y divide-line-subtle text-[13px]">
                    {% for summary in releasesPast %}
                        {% set release = summary.release %}
                        {# The line leads to the issues of the release, by the link of its name, stretched over it; what manages it stands above, and shows when the line is pointed at. #}
                        <li class="group relative flex min-h-11 flex-wrap items-center gap-x-3 gap-y-1 px-4 py-2 transition-colors last:rounded-b-lg hover:bg-subtle">
                            <a href="{{ path('app_project_issues', releasesRoute|merge({ releases: [release.id], closed: 1 })) }}" title="{{ 'release.see_issues'|trans }}" class="w-20 shrink-0 font-mono font-semibold text-body after:absolute after:inset-0">{{ release.name }}</a>
                            <span class="w-24 shrink-0"><twig:Ui:Badge :tone="release.status.value == 'delivered' ? 'emerald' : 'gray'" size="sm" :icon="release.status.value == 'delivered' ? 'check' : null">{{ ('release.status.' ~ release.status.value)|trans }}</twig:Ui:Badge></span>
                            <span class="min-w-0 flex-1 basis-40 truncate text-muted">{{ release.description }}</span>
                            <span class="w-28 shrink-0 text-right text-xs tabular-nums text-muted">{{ 'issue.list.count'|trans({ '%count%': summary.total }) }}</span>
                            <span class="w-24 shrink-0 text-right text-xs tabular-nums text-muted">{% if release.deliveredAt %}{{ release.deliveredAt|format_date('medium') }}{% endif %}</span>
                            {% if releasesManage %}
                                <span class="hover-actions relative z-[1] flex shrink-0 items-center gap-0.5">
                                    {{ include('project/_release_status.html.twig', { status: 'open', variant: 'ghost' }) }}
                                    <twig:Ui:IconButton icon="pencil" :label="'release.edit'|trans" href="{{ path('app_project_release_edit', releasesRoute|merge({ release: release.id })) }}" data-turbo-frame="modal" />
                                </span>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            </twig:Ui:Panel>
        {% endif %}
    </div>

{% endblock %}

{# The dialog creating a release, or changing `dialogRelease`: answered alone to a request made for the frame, so it reads only `project`, `form`, `dialogRelease` and `dialogIssueCount`. The forms abandoning and deleting the release sit beside the one of the dialog, in the frame: their buttons name them. #}
{% block modal %}
    {% set modalRoute = { workspaceKey: project.workspace.key, projectKey: project.key } %}
    {% set modalAbandonForm = '' %}
    {% set modalAbandon = '' %}
    {% if form and dialogRelease %}
        {% set modalAbandonForm %}
            <form id="release-delete" method="post" action="{{ path('app_project_release_delete', modalRoute|merge({ release: dialogRelease.id })) }}" class="hidden">
                <input type="hidden" name="_token" value="{{ csrf_token('submit') }}" data-controller="csrf-protection">
            </form>
            {% if dialogRelease.open %}
            <form id="release-abandon" method="post" action="{{ path('app_project_release_status', modalRoute|merge({ release: dialogRelease.id })) }}" class="hidden">
                <input type="hidden" name="_token" value="{{ csrf_token('submit') }}" data-controller="csrf-protection">
                <input type="hidden" name="status" value="abandoned">
            </form>
            {% endif %}
        {% endset %}
        {% set modalAbandon %}
            {% if dialogRelease.open %}
            <twig:Ui:Callout tone="danger" size="sm" class="mt-4 flex flex-wrap items-center gap-3">
                <p class="flex-1 basis-48">{{ 'release.abandon_help'|trans }}</p>
                <twig:Ui:Button type="submit" variant="danger" size="sm" form="release-abandon">{{ 'release.to_status.abandoned'|trans }}</twig:Ui:Button>
            </twig:Ui:Callout>
            {% endif %}
            <twig:Ui:Callout tone="danger" size="sm" class="mt-3">
                <p>{{ 'release.delete_help'|trans({ '%count%': dialogIssueCount }) }}</p>
                <twig:Ui:Disclosure :closedLabel="'release.delete'|trans" :openLabel="'issue.edit.cancel'|trans" class="mt-1.5">
                    <div class="mt-2 flex flex-wrap items-center gap-3" role="alertdialog">
                        <span class="flex-1 basis-48">{{ 'release.delete_confirm'|trans }}</span>
                        <twig:Ui:Button type="submit" variant="danger" size="sm" icon="trash-2" form="release-delete">{{ 'release.delete'|trans }}</twig:Ui:Button>
                    </div>
                </twig:Ui:Disclosure>
            </twig:Ui:Callout>
        {% endset %}
    {% endif %}
    {{ include('project/_form_dialog.html.twig', {
        title: dialogRelease ? dialogRelease.name : 'release.new'|trans,
        closeHref: path('app_project_releases', modalRoute),
        submitLabel: (dialogRelease ? 'release.save' : 'release.create')|trans,
        before: modalAbandonForm,
        after: modalAbandon,
    }) }}
{% endblock %}
