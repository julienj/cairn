{% extends 'layout/project.html.twig' %}

{% set issue = detail.issue %}

{% block page_title %}{{ issue.key }}{% endblock %}

{% block content %}
    {# Siblings, not nested: a live component's redraw must not touch another one.
       Header, side panel, then the body: on a phone they stack in that order, so that the properties are read with the title; on a wide screen the panel takes the right column beside both, sticks under the header and scrolls on its own when taller than the screen. #}
    <div class="px-4 sm:px-6 py-5 max-w-screen-2xl lg:grid lg:grid-cols-[minmax(0,1fr)_18rem] lg:gap-x-8">
        <div class="flex items-start gap-3 lg:col-start-1">
            <twig:Issue:Header :issue="issue" class="min-w-0 flex-1" />
            <twig:Issue:Follow :issue="issue" class="shrink-0" />
        </div>

        <aside class="mt-6 lg:mt-0 lg:col-start-2 lg:row-start-1 lg:row-span-2 lg:self-start lg:sticky lg:top-[calc(var(--spacing-header)+1rem)] lg:max-h-[calc(100vh-var(--spacing-header)-2rem)] lg:overflow-y-auto lg:overscroll-contain scrollbar-thin">
            <div class="space-y-3 lg:px-0.5 lg:pb-1">
                <twig:Issue:Properties :issue="issue" />
                <twig:Issue:Budget :issue="issue" />
                <twig:Issue:Fields :issue="issue" />
                <twig:Issue:Links :issue="issue" />
                <twig:Issue:CodeReferences :issue="issue" />
                <twig:Issue:Subscribers :issue="issue" />
            </div>
        </aside>

        <div class="min-w-0 lg:col-start-1">
            <section class="mt-5 rounded-lg border border-line bg-surface p-3 text-body leading-relaxed">
                <twig:Issue:Description :issue="issue" />
                <twig:Issue:Files :issue="issue" />
            </section>
            <twig:Issue:Activity :issue="issue" />
        </div>
    </div>
{% endblock %}

{# The workflow of the issue, drawn over its page when the address asks for it (`/workflow`). The block is rendered alone for the frame: it reads `detail`, not what the page sets. #}
{% block modal %}
    <turbo-frame id="modal" data-controller="modal-frame" data-action="turbo:submit-end->modal-frame#submitted">
        {% if workflow %}
            <twig:Ui:Dialog :title="'issue.workflow.title'|trans({ '%workflow%': workflow.label })" :closeHref="path('app_issue_show', { workspaceKey: project.workspace.key, projectKey: project.key, number: detail.issue.number })" size="xl">
                <twig:block name="description">
                    <p class="truncate"><span class="font-mono">{{ detail.issue.key }}</span> · {{ detail.issue.title }}</p>
                </twig:block>
                <twig:block name="content">
                    <twig:Workflow:Diagram :workflow="workflow" :current="detail.issue.place" />
                </twig:block>
            </twig:Ui:Dialog>
        {% endif %}
    </turbo-frame>
{% endblock %}
