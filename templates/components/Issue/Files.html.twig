{# The Files block of the issue page. The file input sends what is chosen with the `upload` action (`files|upload`), once the live controller has registered it (file-picker). #}
{% set filesList = this.files %}
{% set filesCanEdit = this.canEdit %}
<div {{ attributes }}>
{% if filesList is not empty or filesCanEdit %}
<div class="mt-3 border-t border-line-subtle px-2 pb-1 pt-3">
    <div class="flex items-center gap-2 text-xs font-medium text-muted">
        {{ ux_icon('lucide:paperclip', { class: 'h-3.5 w-3.5' }) }}
        {{ 'attachment.title'|trans }}
        <span class="text-[11px] tabular-nums text-faint">{{ filesList|length }}</span>
    </div>
    {% if error %}
        <twig:Ui:Callout tone="danger" size="sm" role="alert" class="mt-2">{{ error }}</twig:Ui:Callout>
    {% endif %}
    <div class="mt-2 flex flex-wrap gap-2" data-loading="addClass(opacity-60)">
        {% for file in filesList %}
            <twig:Ui:Attachment :name="file.filename" :size="file.size" :image="file.image" :uploader="file.uploadedBy.fullName"
                                :href="attachment_url(file)">
                <twig:block name="actions">
                    {% if filesCanEdit %}
                        <twig:Ui:IconButton icon="x" size="sm" :label="'attachment.remove'|trans" class="-mr-1" data-action="live#action" data-live-action-param="remove" data-live-uuid-param="{{ file.uuid.toRfc4122 }}" data-live-name-param="{{ file.filename }}" />
                    {% endif %}
                </twig:block>
            </twig:Ui:Attachment>
        {% endfor %}
        {% if filesCanEdit %}
            <label class="inline-flex min-h-[46px] cursor-pointer items-center gap-1.5 rounded-lg border border-dashed border-line-strong px-3.5 text-xs text-muted hover:border-brand-line hover:bg-brand-soft hover:text-brand has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-focus" title="{{ 'attachment.add_help'|trans }}">
                {{ ux_icon('lucide:plus', { class: 'h-3.5 w-3.5' }) }}
                {{ 'attachment.add'|trans }}
                <input type="file" name="files[]" multiple class="sr-only" data-controller="file-picker"
                       data-action="change->file-picker#chosen file-picker:chosen->live#action" data-live-action-param="files|upload">
            </label>
        {% endif %}
    </div>
</div>
{% endif %}
</div>
