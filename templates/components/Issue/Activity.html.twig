{# Thread of the issue page, a line down which every moment hangs under the date of its day, then what the viewer may do, on the same line: the actions of the workflow, one line each, and the comment box beside the face of who writes. The comment being written is the `body` prop, kept across every redraw, including those `issue:changed` triggers.
   The controls are plain HTML: a data-model attribute on a nested component would bind that component instead. #}
{% set activityDetail = this.detail %}
{% set activityTimeline = this.timeline %}
{% set activityHidden = this.hiddenKinds %}
{% set activityCounts = this.activityCounts %}
{% set activityTransitions = this.transitions %}
{% set activityAwaiting = this.awaitingTransition %}
{% set activityCanComment = this.canComment %}
{% set activityEditable = this.editableComments %}
{% set activityPendingFiles = this.pendingFiles %}
{% set activityEditorUrls = editor_urls(issue.project) %}
<div data-draft {{ attributes }}>

    <section class="mt-8">
        <div class="mb-1 flex flex-wrap items-center gap-2">
            <h2 class="font-semibold text-strong">{{ 'issue.show.activity'|trans }}</h2>
            {# Who reads chooses what to read, for every issue: the choice is kept on the account. #}
            <div class="ml-auto flex items-center gap-1.5" role="group" aria-label="{{ 'issue.activity.show'|trans }}">
                {% for activityKind in this.activityKinds %}
                    <twig:Ui:Filter:Toggle variant="chip" :icon="activityKind.value == 'code' ? 'git-branch' : 'history'" :checked="activityKind not in activityHidden" :count="activityCounts[activityKind.value]" data-action="change->live#action" data-live-action-param="toggleActivity" data-live-kind-param="{{ activityKind.value }}">{{ ('issue.activity.kind.' ~ activityKind.value)|trans }}</twig:Ui:Filter:Toggle>
                {% endfor %}
            </div>
            {% if this.filterError %}<p class="basis-full text-right text-sm text-red" role="alert">{{ this.filterError }}</p>{% endif %}
        </div>
        {# One line down the thread, each moment hung on it: a day opens with its date, so that a moment only says its hour. #}
        {% set activityDay = null %}
        <ol class="relative before:absolute before:bottom-0 before:left-[15.5px] before:top-4 before:w-px before:bg-line">
            {% for entry in activityTimeline %}
                {% set entryComment = entry.comment %}
                {% if entry.at|date('Y-m-d') != activityDay %}
                    {% set activityDay = entry.at|date('Y-m-d') %}
                    <li class="relative pb-1.5 pl-[46px] pt-5 text-[11px] font-semibold uppercase tracking-wider text-faint first:pt-2">
                        <span class="absolute bottom-[11px] left-[13px] h-1.5 w-1.5 rounded-full bg-line-strong ring-[3px] ring-canvas" aria-hidden="true"></span>
                        <time datetime="{{ activityDay }}">{{ entry.at|format_date('long') }}</time>
                    </li>
                {% endif %}
                {% if entry.event %}
                    <twig:Issue:JournalEntry :entry="entry.event" />
                {% endif %}
                {% if entryComment %}
                    <li class="relative my-3 pl-[46px]">
                        {% if entryComment.author %}
                            <span class="absolute left-0 top-1 flex rounded-full ring-[3px] ring-canvas"><twig:User:Avatar :user="entryComment.author" size="xl" /></span>
                        {% else %}
                            {# Written by an automation rule: a bolt where the avatar would be. #}
                            <span class="absolute left-0 top-1 flex h-8 w-8 items-center justify-center rounded-lg bg-sunken text-muted ring-[3px] ring-canvas" title="{{ 'automation.signature'|trans }}"><twig:ux:icon name="lucide:zap" class="h-4 w-4" /></span>
                        {% endif %}
                        {% set commentEditable = entryComment.id in activityEditable %}
                        {# Each comment has its own address, as on GitHub: its date is the link, the comment the address names is outlined, below the sticky header. #}
                        {% set commentAnchor = 'comment-' ~ entryComment.id %}
                        {# Who, of which company when they are not of the house, then what the comment is (private, rewritten); its actions wait beside its hour, which is its link, at the end of the line like the hour of every moment. #}
                        <div id="{{ commentAnchor }}" class="group scroll-mt-28 rounded-[10px] border px-3.5 pb-3 pt-2.5 shadow-sm transition-colors target:ring-2 target:ring-focus {{ entryComment.private ? 'border-amber-line border-l-[3px] border-l-amber-solid bg-amber-soft/70 private-hatching' : 'border-line bg-surface hover:border-line-strong' }}">
                            <div class="flex items-center gap-2 text-xs">
                                <span class="text-[13px] font-semibold text-strong">{{ entryComment.authorName }}</span>
                                {% if entryComment.author and not entryComment.author.internal and entryComment.author.company %}<span class="truncate text-faint">{{ entryComment.author.company }}</span>{% endif %}
                                {% if not entryComment.author %}<span class="text-faint">{{ 'automation.signature'|trans }}</span>{% endif %}
                                {% if entryComment.private %}<twig:Ui:Badge tone="amber" size="sm" icon="lock" class="shrink-0" title="{{ 'issue.comment.private_help'|trans }}">{{ 'issue.comment.private'|trans }}</twig:Ui:Badge>{% endif %}
                                {% if entryComment.editedAt %}<span class="truncate italic text-faint">{{ 'issue.comment.edited'|trans({ '%date%': entryComment.editedAt|format_datetime('short', 'short') }) }}</span>{% endif %}
                                <span class="flex-1"></span>
                                {% if editingCommentId != entryComment.id and deletingCommentId != entryComment.id %}
                                    <span class="hover-actions -my-1.5 flex shrink-0 items-center" data-controller="clipboard" data-clipboard-text-value="#{{ commentAnchor }}">
                                        <twig:Ui:CopyButton icon="link" size="sm" :label="'issue.comment.copy_link'|trans" :copiedLabel="'issue.comment.link_copied'|trans" />
                                        {% if commentEditable %}
                                            <twig:Ui:IconButton icon="pencil" size="sm" :label="'issue.comment.edit'|trans" data-action="live#action" data-live-action-param="editComment" data-live-id-param="{{ entryComment.id }}" />
                                            <twig:Ui:IconButton icon="trash-2" size="sm" tone="danger" :label="'issue.comment.delete'|trans" data-action="live#action" data-live-action-param="confirmDelete" data-live-id-param="{{ entryComment.id }}" />
                                        {% endif %}
                                    </span>
                                {% endif %}
                                <a href="#{{ commentAnchor }}" class="shrink-0 text-[11px] text-faint hover:text-body hover:underline" title="{{ entryComment.createdAt|format_datetime('long', 'short') }}" data-turbo="false" data-test="comment-permalink"><time datetime="{{ entryComment.createdAt|date('c') }}">{{ entryComment.createdAt|format_time('short') }}</time></a>
                            </div>
                            {% if editingCommentId == entryComment.id %}
                                {# ⌘/Ctrl Enter saves (autosubmit), Esc cancels. #}
                                <form class="mt-2" data-controller="autosubmit" data-action="live#action:prevent" data-live-action-param="saveComment">
                                    <twig:Ui:Form:Editor model="norender|commentBody" :rows="3" autofocus class="mt-0"
                                                         :issuesUrl="activityEditorUrls.issues" :usersUrl="activityEditorUrls.users" :uploadUrl="activityEditorUrls.upload"
                                                         data-action="editor:submit->autosubmit#submit editor:cancel->live#action" data-live-action-param="cancelComment">{{ commentBody }}</twig:Ui:Form:Editor>
                                    {% set editPendingFiles = this.editPendingFiles %}
                                    {% if editPendingFiles is not empty %}
                                        <div class="mt-2 flex flex-wrap gap-2" data-draft-pending>
                                            {% for file in editPendingFiles %}
                                                <twig:Ui:Attachment :name="file.filename" :size="file.size" :image="file.image" :href="attachment_url(file)" class="bg-surface py-1">
                                                    <twig:block name="actions">
                                                        <twig:Ui:IconButton icon="x" size="sm" :label="'attachment.remove'|trans" class="-mr-1" data-action="live#action" data-live-action-param="discard" data-live-uuid-param="{{ file.uuid.toRfc4122 }}" />
                                                    </twig:block>
                                                </twig:Ui:Attachment>
                                            {% endfor %}
                                        </div>
                                    {% endif %}
                                    <div class="mt-2 flex flex-wrap items-center gap-2">
                                        <twig:Ui:Button variant="primary" size="sm" type="submit" data-loading="addAttribute(disabled)">{{ 'issue.edit.save'|trans }}</twig:Ui:Button>
                                        <twig:Ui:Button variant="ghost" size="sm" data-action="live#action" data-live-action-param="cancelComment">{{ 'issue.edit.cancel'|trans }}</twig:Ui:Button>
                                        <label title="{{ 'attachment.attach'|trans }}" class="inline-flex cursor-pointer items-center rounded p-1 text-muted hover:bg-sunken hover:text-body" data-loading="action(attach)|addClass(opacity-50)">
                                            {{ ux_icon('lucide:paperclip', { class: 'h-4 w-4' }) }}
                                            <span class="sr-only">{{ 'attachment.attach'|trans }}</span>
                                            <input type="file" name="files[]" multiple class="sr-only" data-controller="file-picker"
                                                   data-action="change->file-picker#chosen file-picker:chosen->live#action" data-live-action-param="files|attach">
                                        </label>
                                        <span class="ml-auto text-xs text-faint"><twig:Ui:ModKey /> {{ 'issue.comment.edit_hint'|trans }}</span>
                                    </div>
                                </form>
                            {% else %}
                            {% if deletingCommentId == entryComment.id %}
                                <div class="mt-2 flex flex-wrap items-center gap-2 rounded-md border border-red-line bg-red-soft px-3 py-2 text-sm text-red" role="alertdialog">
                                    <span>{{ 'issue.comment.delete_confirm'|trans }}</span>
                                    <span class="ml-auto flex items-center gap-2">
                                        <twig:Ui:Button variant="danger" size="sm" data-action="live#action" data-live-action-param="deleteComment" data-loading="addAttribute(disabled)">{{ 'issue.comment.delete_yes'|trans }}</twig:Ui:Button>
                                        <twig:Ui:Button variant="ghost" size="sm" data-action="live#action" data-live-action-param="cancelDelete">{{ 'issue.edit.cancel'|trans }}</twig:Ui:Button>
                                    </span>
                                </div>
                            {% endif %}
                            <div class="prose prose-sm mt-1.5 max-w-none">{{ entryComment.body|markdown(issue.project) }}</div>
                            {% set commentFiles = activityDetail.commentAttachments(entryComment) %}
                            {% if commentFiles is not empty %}
                                <div class="mt-2 flex flex-wrap gap-2">
                                    {% for file in commentFiles %}
                                        <twig:Ui:Attachment :name="file.filename" :size="file.size" :image="file.image" :href="attachment_url(file)" class="bg-surface">
                                            <twig:block name="actions">
                                                {% if commentEditable %}
                                                    <twig:Ui:IconButton icon="x" size="sm" :label="'attachment.remove'|trans" class="-mr-1" data-action="live#action" data-live-action-param="removeAttachment" data-live-uuid-param="{{ file.uuid.toRfc4122 }}" data-live-name-param="{{ file.filename }}" />
                                                {% endif %}
                                            </twig:block>
                                        </twig:Ui:Attachment>
                                    {% endfor %}
                                </div>
                            {% endif %}
                            {% endif %}
                        </div>
                    </li>
                {% endif %}
            {% else %}
                {% if activityHidden is not empty %}
                    <li class="py-2 pl-[46px] text-sm text-muted">{{ 'issue.activity.filtered_empty'|trans }}</li>
                {% endif %}
            {% endfor %}
        </ol>
        {# The decision and the comment are two boxes. The decision keeps its slot even when empty, so that the comment editor, whose inside the morph ignores, stays the same sibling and is not recreated. #}
        {# The line of the thread goes on through both, down to whoever writes next. #}
        <div class="relative pl-[46px] before:absolute before:inset-y-0 before:left-[15.5px] before:w-px before:bg-line">
            {% if activityTransitions is not empty or activityAwaiting %}
                <span class="absolute left-0 top-6 grid h-5 w-8 place-items-center" aria-hidden="true"><span class="grid h-5 w-5 place-items-center rounded-full border border-line bg-canvas text-faint ring-2 ring-canvas"><twig:ux:icon name="lucide:corner-down-right" class="h-3 w-3" /></span></span>
                <div class="mt-3 rounded-[10px] border border-line-strong bg-surface shadow-sm">
                    {% if activityAwaiting %}
                        {# The action chosen asks for a comment: it is written here, and sent with it. ⌘/Ctrl Enter confirms. #}
                        <div class="space-y-2.5 p-3.5">
                            <p class="text-[13.5px] font-semibold text-strong">{{ activityAwaiting.label }}</p>
                            <p id="activity-reason" class="text-sm text-muted">{{ activityAwaiting.commentPrompt ?? 'issue.transition.comment_required'|trans }}</p>
                            <twig:Ui:Form:Editor model="norender|reason" :rows="3" autofocus class="mt-0" aria-labelledby="activity-reason"
                                                 :issuesUrl="activityEditorUrls.issues" :usersUrl="activityEditorUrls.users" :uploadUrl="activityEditorUrls.upload"
                                                 data-action="editor:submit->live#action" data-live-action-param="confirm">{{ reason }}</twig:Ui:Form:Editor>
                            {% if decisionError %}<twig:Ui:Callout tone="danger" size="sm" role="alert">{{ decisionError }}</twig:Ui:Callout>{% endif %}
                            <div class="flex flex-wrap items-center gap-2">
                                <twig:Ui:Button :variant="activityAwaiting.style.value == 'default' ? 'secondary' : activityAwaiting.style.value" data-action="live#action" data-live-action-param="confirm" data-loading="addAttribute(disabled)">{{ activityAwaiting.label }}</twig:Ui:Button>
                                <twig:Ui:Button variant="ghost" data-action="live#action" data-live-action-param="cancelDecision">{{ 'issue.edit.cancel'|trans }}</twig:Ui:Button>
                                <span class="ml-auto text-xs text-faint"><twig:Ui:ModKey /> {{ 'issue.transition.confirm_hint'|trans }}</span>
                            </div>
                        </div>
                    {% else %}
                        {# One line per action of the workflow the viewer may take: its button, in the style the configuration gives it, each as wide as the others, what it does, and the step the issue will stand at. #}
                        <p class="px-3.5 pb-2 pt-3 text-[13.5px] font-semibold text-strong">{{ 'issue.respond.question'|trans }}</p>
                        {% if decisionError %}<twig:Ui:Callout tone="danger" size="sm" role="alert" class="mx-3.5 mb-2">{{ decisionError }}</twig:Ui:Callout>{% endif %}
                        <ul>
                            {% for transition in activityTransitions %}
                                {% set transitionTarget = this.targetOf(transition) %}
                                <li class="grid items-center gap-x-4 gap-y-1.5 border-t border-line-subtle px-3.5 py-2.5 transition-colors last:rounded-b-[10px] hover:bg-subtle sm:grid-cols-[11rem_minmax(0,1fr)_auto]">
                                    <twig:Ui:Button :variant="transition.style.value == 'default' ? 'secondary' : transition.style.value" class="justify-self-start sm:w-full" data-action="live#action" data-live-action-param="apply" data-live-transition-param="{{ transition.id }}" data-loading="addAttribute(disabled)">{{ transition.label }}</twig:Ui:Button>
                                    <p class="min-w-0 text-[13px] leading-snug text-muted">{{ transition.description }}</p>
                                    {% if transitionTarget %}<span class="inline-flex items-center gap-1.5 whitespace-nowrap text-faint" title="{{ 'issue.transition.leads_to'|trans }}"><twig:ux:icon name="lucide:arrow-right" class="h-3 w-3" /><twig:Ui:Status:Step :status="transitionTarget.status.value" :label="transitionTarget.label" pill /></span>{% endif %}
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </div>
            {% endif %}
        </div>
        <div class="relative pl-[46px] pt-3 before:absolute before:left-[15.5px] before:top-0 before:h-5 before:w-px before:bg-line">
            {% if activityCanComment %}
                <span class="absolute left-0 top-4 flex rounded-full ring-[3px] ring-canvas"><twig:User:Avatar :user="app.user" size="xl" /></span>
                <div class="group/composer rounded-[10px] border bg-surface shadow-sm transition-[border-color,box-shadow] focus-within:ring-[3px] {{ private ? 'border-amber-line border-l-[3px] border-l-amber-solid bg-amber-soft/70 private-hatching focus-within:ring-amber-solid/20' : 'border-line-strong focus-within:border-focus focus-within:ring-focus/25' }}">
                    {# ⌘/Ctrl Enter sends; a posted comment empties the editor through editor:reset. #}
                    <twig:Ui:Form:Editor model="norender|body" :rows="3"
                                         class="mt-0 rounded-none rounded-t-[10px] border-0 bg-transparent focus-within:ring-0"
                                         :placeholder="'issue.comment.placeholder'|trans"
                                         :issuesUrl="activityEditorUrls.issues" :usersUrl="activityEditorUrls.users" :uploadUrl="activityEditorUrls.upload"
                                         data-action="editor:submit->live#action editor:reset@window->editor#reset" data-live-action-param="submit">{{ body }}</twig:Ui:Form:Editor>
                    {% if activityPendingFiles is not empty %}
                        <div class="flex flex-wrap gap-2 px-3 pb-2" data-draft-pending>
                            {% for file in activityPendingFiles %}
                                <twig:Ui:Attachment :name="file.filename" :size="file.size" :image="file.image" :href="attachment_url(file)" class="bg-surface py-1">
                                    <twig:block name="actions">
                                        <twig:Ui:IconButton icon="x" size="sm" :label="'attachment.remove'|trans" class="-mr-1" data-action="live#action" data-live-action-param="discard" data-live-uuid-param="{{ file.uuid.toRfc4122 }}" />
                                    </twig:block>
                                </twig:Ui:Attachment>
                            {% endfor %}
                        </div>
                    {% endif %}
                    {# A refusal sits just above the button that was pressed. #}
                    {% if error %}
                        <twig:Ui:Callout tone="danger" size="sm" role="alert" class="rounded-none border-x-0 border-b-0 border-red-line bg-red-soft text-red">{{ error }}</twig:Ui:Callout>
                    {% endif %}
                    <div class="flex flex-wrap items-center gap-1.5 px-2 pb-2 pt-1">
                        <label title="{{ 'attachment.attach'|trans }}" class="inline-flex h-7 w-7 cursor-pointer items-center justify-center rounded-md text-xs text-muted hover:bg-sunken hover:text-body has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-focus" data-loading="action(attach)|addClass(opacity-50)">
                            {{ ux_icon('lucide:paperclip', { class: 'h-4 w-4' }) }}
                            <span class="sr-only">{{ 'attachment.attach'|trans }}</span>
                            <input type="file" name="files[]" multiple class="sr-only" data-controller="file-picker"
                                   data-action="change->file-picker#chosen file-picker:chosen->live#action" data-live-action-param="files|attach">
                        </label>
                        {% if this.canMakePrivate %}
                            {# A switch that is pressed or not; the box around says the rest, before the comment is sent. #}
                            <label title="{{ 'issue.comment.private_help'|trans }}" class="inline-flex h-7 cursor-pointer select-none items-center gap-1.5 rounded-md px-2 text-xs font-medium has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-focus {{ private ? 'bg-amber-soft text-amber ring-1 ring-inset ring-amber-line' : 'text-muted hover:bg-sunken hover:text-body' }}">
                                <input type="checkbox" data-model="private" {{ private ? 'checked' }} class="sr-only">
                                <twig:ux:icon name="lucide:lock" class="h-3 w-3" />
                                {{ 'issue.comment.private'|trans }}
                            </label>
                        {% endif %}
                        <span class="ml-auto mr-1 text-[11px] text-faint opacity-0 transition-opacity group-focus-within/composer:opacity-100"><twig:Ui:ModKey /> {{ 'issue.comment.send_hint'|trans }}</span>
                        <twig:Ui:Button variant="primary" :icon="private ? 'lock' : null" data-action="live#action" data-live-action-param="submit" data-loading="addAttribute(disabled)">{{ (private ? 'issue.comment.submit_private' : 'issue.comment.submit')|trans }}</twig:Ui:Button>
                    </div>
                </div>
            {% endif %}
        </div>
    </section>
</div>
