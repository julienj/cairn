{# The fields of the issue's workflow, a card of the side panel: read, or edited as one form by whoever may edit the issue; while editing, the card does not fold. Nothing shows when there is nothing to read nor to fill in: a workflow without fields has no card. `this` is read before the nested component, whose blocks see their own `this`. #}
{% set fieldsCanEdit = this.canEdit %}
{% set fieldsValues = editing ? [] : this.values %}
{% set fieldsShown = editing or fieldsValues is not empty or fieldsCanEdit %}
<div {{ attributes.defaults({ class: fieldsShown ? '' : 'hidden' }) }} data-loading="addClass(opacity-60)">
    {% if fieldsShown %}
        <twig:Ui:Section :title="'issue.show.fields'|trans({ '%tracker%': issue.tracker.name })" icon="sliders-horizontal" :foldable="not editing">
            <twig:block name="actions">
                {% if fieldsCanEdit and not editing %}
                    <twig:Ui:IconButton icon="pencil" size="sm" :label="'issue.show.edit_fields'|trans" class="-my-1 opacity-0 focus-visible:opacity-100 group-hover/section:opacity-100 [@media(hover:none)]:opacity-100" data-action="live#action" data-live-action-param="edit" />
                {% endif %}
            </twig:block>
            <twig:block name="content">
                {% if editing %}
                    {{ form_start(form, { attr: form.vars.attr|merge({ 'data-action': 'live#action:prevent', 'data-live-action-param': 'save', class: 'space-y-3' }) }) }}
                        {% if error %}<twig:Ui:Callout tone="danger" size="sm" role="alert">{{ error }}</twig:Ui:Callout>{% endif %}
                        {% for field in form %}{{ form_row(field) }}{% endfor %}
                        <div class="flex items-center gap-2">
                            <twig:Ui:Button variant="primary" size="sm" type="submit" data-loading="addAttribute(disabled)">{{ 'issue.edit.save'|trans }}</twig:Ui:Button>
                            <twig:Ui:Button variant="ghost" size="sm" data-action="live#action" data-live-action-param="cancel">{{ 'issue.edit.cancel'|trans }}</twig:Ui:Button>
                        </div>
                    {{ form_end(form) }}
                {% elseif fieldsValues is empty %}
                    <p class="text-xs text-faint">{{ 'issue.show.no_fields'|trans }}</p>
                {% else %}
                    <dl class="space-y-1.5 text-[13px]">
                        {% for fieldValue in fieldsValues %}
                            <div class="flex items-start gap-3">
                                <dt class="w-22 shrink-0 pt-0.5 text-xs text-muted">{{ fieldValue.field.label }}</dt>
                                <dd class="min-w-0 flex-1 break-words text-body">
                                    {% if fieldValue.field.type.value == 'url' and fieldValue.value matches '#^https?://#i' %}
                                        {# An address stays on one line, cut at its end and read whole in its tooltip; it is copied from the button that shows on hover. #}
                                        <span class="group -my-0.5 flex min-w-0 items-center gap-0.5" data-controller="clipboard" data-clipboard-text-value="{{ fieldValue.value }}">
                                            <a href="{{ fieldValue.value }}" class="inline-flex min-w-0 items-center gap-1.5 text-brand hover:underline" title="{{ fieldValue.value }}" rel="noopener noreferrer" target="_blank"><span class="truncate">{{ fieldValue.value|replace({ 'https://': '', 'http://': '' }) }}</span><twig:ux:icon name="lucide:external-link" class="h-3 w-3 shrink-0 opacity-60" /></a>
                                            <twig:Ui:CopyButton size="sm" :label="'issue.show.copy_url'|trans" :copiedLabel="'issue.show.url_copied'|trans" class="hover-actions shrink-0" />
                                        </span>
                                    {% elseif fieldValue.field.type.value == 'date' %}
                                        {{ fieldValue.value|format_date('short') }}
                                    {% elseif fieldValue.field.type.value == 'bool' %}
                                        {{ (fieldValue.value ? 'issue.show.true' : 'issue.show.false')|trans }}
                                    {% else %}
                                        {{ fieldValue.value|nl2br }}
                                    {% endif %}
                                </dd>
                            </div>
                        {% endfor %}
                    </dl>
                {% endif %}
            </twig:block>
        </twig:Ui:Section>
    {% endif %}
</div>
