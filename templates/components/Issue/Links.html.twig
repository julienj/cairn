{# The links of the issue, a card of the side panel: grouped by label, each a row to the other issue with the colour of its place; folded, the header sums up the first label and its keys. Whoever may link adds one (label, then the other issue picked among the suggestions or typed as a key) and removes one after confirming in place.
   `this` is read before the nested components, whose blocks see their own `this`. The key field is plain HTML: a data-model on a nested component would bind the component instead. #}
{% set linksGroups = this.groups %}
{% set linksCanLink = this.canLink %}
{% set linksKinds = adding ? this.kinds : [] %}
{% set linksSuggestions = this.suggestions %}
{% set linksCount = linksGroups|reduce((count, group) => count + group|length, 0) %}
{% set linksShown = linksGroups is not empty or linksCanLink %}
<div {{ attributes.defaults({ class: linksShown ? '' : 'hidden' }) }} data-loading="addClass(opacity-60)">
    {% if linksShown %}
        <twig:Ui:Section :title="'issue.links.title'|trans" icon="link" tone="indigo" :count="linksCount > 0 ? linksCount : null">
            <twig:block name="summary">
                {% for linksLabel, linksOfLabel in linksGroups|slice(0, 1) %}
                    <span class="ml-1 min-w-0 truncate text-xs text-muted">{{ linksLabel }} <span class="font-mono text-body">{{ linksOfLabel|map(link => link.otherThan(issue).key)|join(', ') }}</span></span>
                {% endfor %}
            </twig:block>
            <twig:block name="content">
                {% if error %}<twig:Ui:Callout tone="danger" size="sm" role="alert" class="mb-2">{{ error }}</twig:Ui:Callout>{% endif %}
                {% for linksLabel, linksOfLabel in linksGroups %}
                    <div class="{{ loop.first ? '' : 'mt-2' }}">
                        <div class="text-[11px] font-medium uppercase tracking-wide text-faint">{{ linksLabel }}</div>
                        <ul class="mt-0.5">
                            {% for link in linksOfLabel %}
                                {% set linkOther = link.otherThan(issue) %}
                                {% set linkHref = path('app_issue_show', { workspaceKey: linkOther.project.workspace.key, projectKey: linkOther.project.key, number: linkOther.number }) %}
                                <li class="group -mx-1.5 rounded-md px-1.5 py-1 hover:bg-subtle">
                                    <div class="flex items-center gap-2">
                                        <twig:Ui:IssueKey :key="linkOther.key" size="sm" :href="linkHref" class="shrink-0" />
                                        <a href="{{ linkHref }}" class="min-w-0 flex-1 truncate text-[13px] text-body hover:text-brand" title="{{ linkOther.title }}">{{ linkOther.title }}</a>
                                        <span class="inline-flex shrink-0 items-center" title="{{ issue_place(linkOther) }}">
                                            <twig:Ui:Status:Dot :status="issue_status(linkOther)" />
                                            <span class="sr-only">{{ issue_place(linkOther) }}</span>
                                        </span>
                                        {% if linksCanLink %}
                                            <twig:Ui:IconButton icon="x" size="sm" tone="danger" :label="'issue.links.remove'|trans" class="hover-actions -my-1 -mr-1" data-action="live#action" data-live-action-param="confirmRemove" data-live-id-param="{{ link.id }}" />
                                        {% endif %}
                                    </div>
                                    {% if removingId == link.id %}
                                        <div class="mt-1.5 flex flex-wrap items-center gap-2 rounded-md border border-red-line bg-red-soft px-2 py-1.5 text-xs text-red" role="alertdialog">
                                            <span>{{ 'issue.links.remove_confirm'|trans }}</span>
                                            <span class="ml-auto flex items-center gap-1">
                                                <twig:Ui:Button variant="danger" size="sm" data-action="live#action" data-live-action-param="remove" data-loading="addAttribute(disabled)">{{ 'issue.links.remove_yes'|trans }}</twig:Ui:Button>
                                                <twig:Ui:Button variant="ghost" size="sm" data-action="live#action" data-live-action-param="cancelRemove">{{ 'issue.edit.cancel'|trans }}</twig:Ui:Button>
                                            </span>
                                        </div>
                                    {% endif %}
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endfor %}
                {% if linksCanLink %}
                    {% if adding %}
                        <div class="{{ linksGroups is not empty ? 'mt-3' : '' }} space-y-2">
                            <twig:Ui:Form:Select model="kind" class="h-8 w-full" :aria-label="'issue.links.kind'|trans">
                                {% for linksKind, linksKindLabel in linksKinds %}
                                    <option value="{{ linksKind }}" {{ linksKind == kind ? 'selected' }}>{{ linksKindLabel }}</option>
                                {% endfor %}
                            </twig:Ui:Form:Select>
                            <input type="text" data-model="debounce(300)|otherKey" value="{{ otherKey }}" placeholder="{{ 'issue.links.other_placeholder'|trans }}" aria-label="{{ 'issue.links.other'|trans }}" autocomplete="off" class="h-8 w-full rounded-md border border-line-strong px-2 text-sm focus:border-focus focus:outline-none focus:ring-2 focus:ring-brand-line">
                            {% if linksSuggestions is not empty %}
                                <ul class="divide-y divide-line-subtle rounded-md border border-line text-xs">
                                    {% for suggestion in linksSuggestions %}
                                        <li>
                                            <button type="button" class="flex w-full items-center gap-1.5 px-2 py-1.5 text-left hover:bg-subtle {{ suggestion.key == otherKey|upper ? 'bg-brand-soft' : '' }}" data-action="live#action" data-live-action-param="pick" data-live-key-param="{{ suggestion.key }}">
                                                <span class="shrink-0 whitespace-nowrap font-mono font-medium text-muted">{{ suggestion.key }}</span>
                                                <span class="min-w-0 truncate text-body">{{ suggestion.title }}</span>
                                            </button>
                                        </li>
                                    {% endfor %}
                                </ul>
                            {% endif %}
                            <div class="flex items-center gap-2">
                                <twig:Ui:Button variant="primary" size="sm" data-action="live#action" data-live-action-param="add" data-loading="addAttribute(disabled)">{{ 'issue.links.add'|trans }}</twig:Ui:Button>
                                <twig:Ui:Button variant="ghost" size="sm" data-action="live#action" data-live-action-param="close">{{ 'issue.edit.cancel'|trans }}</twig:Ui:Button>
                            </div>
                        </div>
                    {% else %}
                        <button type="button" class="{{ linksGroups is not empty ? 'mt-1.5' : '' }} -mx-1.5 -mb-1 flex w-[calc(100%+0.75rem)] items-center gap-1.5 rounded-md px-1.5 py-1.5 text-xs text-muted hover:bg-subtle hover:text-brand" data-action="live#action" data-live-action-param="open">
                            <twig:ux:icon name="lucide:plus" class="h-3.5 w-3.5" />{{ 'issue.links.new'|trans }}
                        </button>
                    {% endif %}
                {% endif %}
            </twig:block>
        </twig:Ui:Section>
    {% endif %}
</div>
