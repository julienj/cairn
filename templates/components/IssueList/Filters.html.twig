{# The bar of an issue list: its `title` and, at its right, the views of a tracker (list, kanban) as segments, then one menu per filter the list offers (`dimensions`) and, at the right, whether finished issues show (open, all) and the grouping menu. Places, never statuses.
   A GET form whose controls are the parameters of the address, submitted to the `issues` frame on every change by the `filters` controller; it is not redrawn, so the controller also keeps the counts of the menus and the "clear" button up to date. What only the list uses (the place filter, open or all, the grouping) hides while the kanban shows (`data-view`). #}
{# Inside the blocks of nested components `this` is that component: they read these. #}
{% set filtersScope = scope %}
{% set filtersChoices = this.choices %}
{% set filtersView = this.view %}
<form id="issue-filters" method="get" action="{{ scope.path }}"
    class="group/filters border-b border-line bg-surface px-4 sm:px-6"
    data-turbo-frame="issues" data-view="{{ filtersView }}"
    data-controller="filters" data-action="change->filters#submit input->filters#search" {{ attributes }}>
    {% if title or scope.hasBoard %}
        {% set filtersHasBoard = scope.hasBoard %}
        {# The band of the page, as on every page of a project: here inside the bar, which draws the ground and the border. #}
        <twig:Ui:PageHeader :title="title" class="border-b-0 bg-transparent px-0 sm:px-0 pb-0">
            <twig:block name="actions">
                {% if filtersHasBoard %}
                    {# The list is the view of an address that names none: its radio sends nothing. #}
                    <twig:Ui:Filter:Segments :label="'issue.board.views'|trans">
                        <twig:Ui:Filter:Segment name="view" value="" icon="list" :checked="filtersView != 'board'">{{ 'issue.board.list'|trans }}</twig:Ui:Filter:Segment>
                        <twig:Ui:Filter:Segment name="view" value="board" icon="kanban" :checked="filtersView == 'board'">{{ 'issue.board.title'|trans }}</twig:Ui:Filter:Segment>
                    </twig:Ui:Filter:Segments>
                {% endif %}
            </twig:block>
        </twig:Ui:PageHeader>
    {% endif %}
    {# Two blocks: the filters, which wrap among themselves when there are many, and what arranges the list (open or all, the grouping), which keeps its corner whatever they take. #}
    <div role="search" class="flex flex-wrap items-start gap-x-3 gap-y-2 py-3 md:flex-nowrap">
        <div class="flex min-w-0 flex-1 flex-wrap items-center gap-2">
        {% if scope.offers('place') %}
            <twig:Ui:Filter:Menu :label="'filter.place'|trans" :count="filters.places|length" class="group-data-[view=board]/filters:hidden">
                {% for filtersPlace in filtersChoices.places(filtersScope) %}
                    <twig:Ui:Filter:Option name="places[]" :value="filtersPlace.id" :checked="filtersPlace.id in filters.places">
                        <twig:Ui:Status:Dot :status="filtersPlace.status.value" />
                        <span class="truncate">{{ filtersPlace.label }}</span>
                    </twig:Ui:Filter:Option>
                {% endfor %}
            </twig:Ui:Filter:Menu>
        {% endif %}
        {% if scope.offers('project') %}
            <twig:Ui:Filter:Menu :label="'filter.project'|trans" :count="filters.projects|length">
                {% for filtersSummary in filtersChoices.projects %}
                    <twig:Ui:Filter:Option name="projects[]" :value="filtersSummary.project.id" :checked="filtersSummary.project.id in filters.projects">
                        <span class="truncate">{{ filtersSummary.project.name }}</span>
                        <span class="truncate text-xs text-faint">{{ filtersSummary.project.workspace.name }}</span>
                    </twig:Ui:Filter:Option>
                {% endfor %}
            </twig:Ui:Filter:Menu>
        {% endif %}
        {% if scope.offers('tracker') %}
            <twig:Ui:Filter:Menu :label="'filter.tracker'|trans" :count="filters.trackers|length">
                {% for filtersTracker in filtersChoices.trackers(filtersScope) %}
                    <twig:Ui:Filter:Option name="trackers[]" :value="filtersTracker.id" :checked="filtersTracker.id in filters.trackers">
                        <span class="truncate {{ filtersTracker.archived ? 'text-faint' : '' }}" {% if filtersTracker.archived %}title="{{ 'project.settings.tracker.archived_badge'|trans }}"{% endif %}>{{ filtersTracker.name }}</span>
                        {% if filtersTracker.private %}<twig:ux:icon name="lucide:lock" class="h-3 w-3 shrink-0 text-faint" />{% endif %}
                    </twig:Ui:Filter:Option>
                {% endfor %}
            </twig:Ui:Filter:Menu>
        {% endif %}
        {% if scope.offers('criticality') %}
            <twig:Ui:Filter:Menu :label="'filter.criticality'|trans" :count="filters.criticality|length">
                {% for filtersCriticality in enum_cases('App\\Entity\\Enum\\Criticality')|reverse %}
                    <twig:Ui:Filter:Option name="criticality[]" :value="filtersCriticality.value" :checked="filtersCriticality.value in filters.criticalityValues">
                        {{ ('criticality.' ~ filtersCriticality.value)|trans }}
                    </twig:Ui:Filter:Option>
                {% endfor %}
            </twig:Ui:Filter:Menu>
        {% endif %}
        {% if scope.offers('assignee') %}
            <twig:Ui:Filter:Menu :label="'filter.assignee'|trans" :count="filters.assignees|length + filters.teams|length">
                <twig:Ui:Filter:Option name="assignees[]" value="0" :checked="0 in filters.assignees">
                    <twig:User:Line size="sm" :nobody="'issue.unassigned'|trans" />
                </twig:Ui:Filter:Option>
                {% for filtersMember in filtersChoices.members(filtersScope) %}
                    <twig:Ui:Filter:Option name="assignees[]" :value="filtersMember.id" :checked="filtersMember.id in filters.assignees">
                        <twig:User:Line :user="filtersMember" size="sm" />
                    </twig:Ui:Filter:Option>
                {% endfor %}
                {% for filtersTeam in filtersChoices.teams(filtersScope) %}
                    <twig:Ui:Filter:Option name="teams[]" :value="filtersTeam.id" :checked="filtersTeam.id in filters.teams">
                        <twig:Team:Line :team="filtersTeam" size="sm" :hint="false" />
                    </twig:Ui:Filter:Option>
                {% endfor %}
            </twig:Ui:Filter:Menu>
        {% endif %}
        {% if filtersChoices.offersReleases(scope) %}
            <twig:Ui:Filter:Menu :label="'filter.release'|trans" :count="filters.releases|length">
                <twig:Ui:Filter:Option name="releases[]" value="0" :checked="0 in filters.releases">{{ 'issue.list.no_release'|trans }}</twig:Ui:Filter:Option>
                {% for filtersRelease in filtersChoices.releases(filtersScope) %}
                    <twig:Ui:Filter:Option name="releases[]" :value="filtersRelease.id" :checked="filtersRelease.id in filters.releases">
                        <span class="truncate font-mono text-xs {{ filtersRelease.open ? '' : 'text-faint' }}">{{ filtersRelease.name }}</span>
                        {% if not filtersRelease.open %}<span class="text-xs text-faint">{{ ('release.status.' ~ filtersRelease.status.value)|trans }}</span>{% endif %}
                    </twig:Ui:Filter:Option>
                {% endfor %}
            </twig:Ui:Filter:Menu>
        {% endif %}
        {% if filtersChoices.offersTags(scope) %}
            <twig:Ui:Filter:Menu :label="'filter.tag'|trans" :count="filters.tags|length">
                <twig:Ui:Filter:Option name="tags[]" value="0" :checked="0 in filters.tags"><span class="text-xs text-muted">{{ 'issue.list.no_tag'|trans }}</span></twig:Ui:Filter:Option>
                {% for filtersTag in filtersChoices.tags(filtersScope) %}
                    <twig:Ui:Filter:Option name="tags[]" :value="filtersTag.id" :checked="filtersTag.id in filters.tags">
                        <twig:Ui:Tag :colour="filtersTag.colour.value">{{ filtersTag.name }}</twig:Ui:Tag>
                    </twig:Ui:Filter:Option>
                {% endfor %}
            </twig:Ui:Filter:Menu>
        {% endif %}
        <twig:Ui:Filter:Search :value="filters.q" class="w-48 xl:w-60" />
        <button type="button" class="inline-flex h-7 items-center gap-1 rounded-md px-2 text-xs text-muted hover:bg-sunken hover:text-body [&[hidden]]:hidden" data-filters-target="clear" data-action="filters#clear" {{ filters.hasFilters ? '' : 'hidden' }}><twig:ux:icon name="lucide:x" class="h-3 w-3" />{{ 'filter.clear'|trans }}</button>
        </div>
        <div class="flex shrink-0 items-center gap-2">
        {% set filtersGrouping = filtersChoices.grouping(scope, filters) %}
        {# Open issues are the list of an address that says nothing: that radio sends nothing. #}
        <twig:Ui:Filter:Segments :label="'issue.list.scope.label'|trans" class="group-data-[view=board]/filters:hidden">
            <twig:Ui:Filter:Segment name="closed" value="" :checked="not filters.closed">{{ 'issue.list.scope.open'|trans }}</twig:Ui:Filter:Segment>
            <twig:Ui:Filter:Segment name="closed" value="1" :checked="filters.closed">{{ 'issue.list.scope.all'|trans }}</twig:Ui:Filter:Segment>
        </twig:Ui:Filter:Segments>
        <twig:Ui:Filter:Menu :label="'issue.list.group.label'|trans" :active="filtersGrouping is not null" align="right" class="group-data-[view=board]/filters:hidden">
            <twig:Ui:Filter:Option single name="group" value="" :checked="filtersGrouping is null">{{ 'issue.list.group.none'|trans }}</twig:Ui:Filter:Option>
            {% for filtersGroupingChoice in filtersChoices.groupings(filtersScope) %}
                <twig:Ui:Filter:Option single name="group" :value="filtersGroupingChoice.value" :checked="filtersGrouping == filtersGroupingChoice">{{ ('issue.list.group.' ~ filtersGroupingChoice.value)|trans }}</twig:Ui:Filter:Option>
            {% endfor %}
        </twig:Ui:Filter:Menu>
        </div>
    </div>
</form>
