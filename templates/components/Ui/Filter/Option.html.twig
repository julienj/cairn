{# A checkbox line of a Filter:Menu, a radio one with `single` (one choice among the options, such as a grouping); `name`, `value`, `id`, `required` and `disabled` go to the checkbox (name="criticality[]"); `model` becomes its `data-model` in a live component. The content is the label, preceded by a dot, an avatar or a chip when relevant. #}
{% props checked = false, count = null, model = null, single = false %}
{% set filterOptionClasses = html_cva(base: 'flex items-center gap-2 px-2.5 py-1.5 text-sm hover:bg-subtle has-[:focus-visible]:bg-subtle cursor-pointer') %}
{% set filterOptionInputClasses = html_cva(
    base: 'h-3.5 w-3.5 border-line-strong text-brand',
    variants: { single: { true: 'rounded-full', false: 'rounded' } },
) %}
{% set filterOptionCountClasses = html_cva(base: 'text-xs text-faint tabular-nums', variants: { empty: { true: 'opacity-40' } }) %}
<label class="{{ filterOptionClasses.apply({}, attributes.render('class'))|tailwind_merge }}" {{ attributes.without('name', 'value', 'id', 'required', 'disabled', 'class') }}>
    <input type="{{ single ? 'radio' : 'checkbox' }}" {{ attributes.only('name', 'value', 'id', 'required', 'disabled') }}{% if model %} data-model="{{ model }}"{% endif %} {{ checked ? 'checked' }} class="{{ filterOptionInputClasses.apply({ single: single }) }}">
    <span class="flex-1 min-w-0 flex items-center gap-2 truncate">{% block content %}{% endblock %}</span>
    {% if count is not null %}<span class="{{ filterOptionCountClasses.apply({ empty: count == 0 }) }}">{{ count }}</span>{% endif %}
</label>
