{# Page shell: the header (block `header`), the project sidebar when given (block `sidebar`), a breadcrumb (block `breadcrumb`) and the page (content).
   Drives the mobile sidebar through the `sidebar` Stimulus controller: the header's burger calls sidebar#open. #}
{% set layoutShellClasses = html_cva(base: 'min-h-screen') %}
<div class="{{ layoutShellClasses.apply({}, attributes.render('class'))|tailwind_merge }}" data-controller="sidebar" {{ attributes }}>
    {% block header %}{% endblock %}
    <div class="flex min-h-[calc(100vh-var(--spacing-header))]">
        {% if block('sidebar') is not empty %}
            <div data-sidebar-target="backdrop" data-action="click->sidebar#close" class="hidden fixed inset-0 z-30 bg-black/30 md:hidden"></div>
            {% block sidebar %}{% endblock %}
        {% endif %}
        <div class="flex-1 min-w-0 flex flex-col">
            {% block breadcrumb %}{% endblock %}
            <main class="flex-1 min-w-0">{% block content %}{% endblock %}</main>
        </div>
    </div>
</div>
