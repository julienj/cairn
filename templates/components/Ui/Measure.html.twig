{# A measure and how it rates: its `label`, its `value` as people read it, and, when it has a scale, its `rating` (good, average, poor) and where it stands (`position`, 0 to 100) on a gauge drawn in three equal parts, one per rating. `caption` says what it measures. #}
{% props label, value, rating = null, position = null, caption = null %}
{% set measureClasses = html_cva(base: 'rounded-lg border border-line bg-surface p-3') %}
{% set measureToneClasses = html_cva(
    variants: { rating: { good: 'text-emerald', average: 'text-amber', poor: 'text-red', none: 'text-strong' } },
) %}
<div class="{{ measureClasses.apply({}, attributes.render('class'))|tailwind_merge }}" {{ attributes }}>
    <div class="flex items-baseline justify-between gap-2 text-xs">
        <span class="truncate font-medium text-muted">{{ label }}</span>
        {% if rating %}<span class="shrink-0 font-medium {{ measureToneClasses.apply({ rating: rating }) }}">{{ ('measure.rating.' ~ rating)|trans }}</span>{% endif %}
    </div>
    <div class="mt-0.5 text-xl font-semibold tabular-nums {{ measureToneClasses.apply({ rating: rating ?? 'none' }) }}">{{ value }}</div>
    {% if position is not null %}
        <div class="relative mt-2 flex h-1.5 gap-0.5" aria-hidden="true">
            <div class="flex-1 rounded-l-full bg-emerald-solid opacity-70"></div>
            <div class="flex-1 bg-amber-solid opacity-70"></div>
            <div class="flex-1 rounded-r-full bg-red-solid opacity-70"></div>
            <div class="absolute -top-1 h-3.5 w-1 -translate-x-1/2 rounded-full bg-inverse ring-2 ring-surface" style="left: {{ position }}%"></div>
        </div>
    {% endif %}
    {% if caption %}<div class="mt-1.5 text-xs text-faint">{{ caption }}</div>{% endif %}
</div>
