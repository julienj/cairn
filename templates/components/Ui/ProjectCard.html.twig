{# A project as a card leading to it: its key, name and workspace, the open issues, then those waiting and those blocking when there are any. `archived` adds its badge, nothing else: an archived project is written like the others. #}
{% props href, code, name, workspace, open = 0, waiting = 0, blocking = 0, archived = false %}
{% set projectCardClasses = html_cva(base: 'group flex flex-col rounded-lg border border-line bg-surface p-4 hover:border-brand-line hover:shadow-sm') %}
<a href="{{ href }}" class="{{ projectCardClasses.apply({}, attributes.render('class'))|tailwind_merge }}" {{ attributes }}>
    <div class="flex items-center gap-2">
        <twig:Ui:Chip>{{ code }}</twig:Ui:Chip>
        {% if archived %}<twig:Ui:Badge size="sm" class="ml-auto">{{ 'project.summary.archived'|trans }}</twig:Ui:Badge>{% endif %}
    </div>
    <div class="mt-2 font-medium text-strong group-hover:text-brand truncate">{{ name }}</div>
    <div class="text-xs text-muted truncate">{{ workspace }}</div>
    <div class="mt-auto pt-3 flex items-center gap-3 text-xs text-muted">
        <span>{{ 'project.summary.open'|trans({ '%count%': open }) }}</span>
        <span class="ml-auto inline-flex items-center gap-2">
            {% if waiting %}<span class="inline-flex items-center gap-1" title="{{ 'project.summary.waiting'|trans }}"><twig:Ui:Status:Dot status="waiting" />{{ waiting }}</span>{% endif %}
            {% if blocking %}<span class="inline-flex items-center gap-1 text-red" title="{{ 'project.summary.blocking'|trans }}"><twig:ux:icon name="lucide:chevrons-up" class="h-3 w-3 [&_*]:stroke-3" />{{ blocking }}</span>{% endif %}
        </span>
    </div>
</a>
