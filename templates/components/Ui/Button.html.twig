{# Renders <a> with `href`, <button> otherwise. `icon` is a Lucide name. A `disabled` button is dimmed; the others give a little under the finger. #}
{% props variant = 'secondary', size = 'md', href = null, icon = null, type = 'button' %}
{% set buttonClasses = html_cva(
    base: 'inline-flex items-center justify-center gap-1.5 rounded-md whitespace-nowrap active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-50 disabled:active:scale-100',
    variants: {
        size: { sm: 'h-7 px-2 text-xs', md: 'h-8 px-3 text-sm', lg: 'h-9 px-4 text-sm' },
        variant: {
            primary: 'bg-brand-solid text-white font-medium hover:bg-brand-solid-hover',
            secondary: 'border border-line-strong bg-surface text-body hover:bg-subtle',
            danger: 'border border-red-line bg-surface text-red hover:bg-red-soft',
            dark: 'bg-inverse text-on-inverse font-medium hover:bg-inverse/90',
            success: 'bg-emerald-solid text-white font-medium hover:bg-emerald-solid/90',
            ghost: 'text-muted hover:bg-sunken',
            icon: 'w-8 px-0 border border-line-strong bg-surface text-muted hover:bg-subtle',
        },
    },
) %}
{% set buttonTag = href ? 'a' : 'button' %}
<{{ buttonTag }} {% if href %}href="{{ href }}"{% else %}type="{{ type }}"{% endif %} class="{{ buttonClasses.apply({ size: size, variant: variant }, attributes.render('class'))|tailwind_merge }}" {{ attributes }}>
    {% if icon %}{{ ux_icon('lucide:' ~ icon, { class: 'h-4 w-4' }) }}{% endif %}
    {% block content %}{% endblock %}
</{{ buttonTag }}>
