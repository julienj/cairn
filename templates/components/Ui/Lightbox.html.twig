{# A picture opened over the page instead of leaving it: the `lightbox` controller of what holds the picture (Ui:Attachment) shows a copy of this figure, closed by a click anywhere or Escape. Drawn once, by the base template. #}
{% set lightboxClasses = html_cva(base: 'group/lightbox fixed inset-0 z-[90] flex cursor-zoom-out flex-col items-center justify-center gap-3 bg-black/70 p-12 opacity-0 backdrop-blur-[3px] transition-opacity duration-200 data-open:opacity-100') %}
<template data-lightbox-template {{ attributes }}>
    <figure class="{{ lightboxClasses.apply({}, attributes.render('class'))|tailwind_merge }}">
        <img src="" alt="" class="max-h-[calc(100vh-140px)] max-w-full scale-95 rounded-lg shadow-2xl transition-transform duration-200 group-data-open/lightbox:scale-100">
        <figcaption class="text-xs text-white opacity-75"><span data-lightbox-caption></span> · {{ 'attachment.lightbox_hint'|trans }}</figcaption>
    </figure>
</template>
