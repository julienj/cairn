{# The key of a shortcut, named as the keyboard under the fingers has it: Ctrl, or ⌘ on a Mac (`platform` controller, `mac` variant). Written before the rest of a hint: "<ModKey /> Enter to send". #}
{% set modKeyClasses = html_cva(base: "font-sans before:content-['Ctrl'] mac:before:content-['⌘']") %}
<kbd class="{{ modKeyClasses.apply({}, attributes.render('class'))|tailwind_merge }}" {{ attributes }}></kbd>
