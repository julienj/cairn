{# A choice among many: a field-like button shows what is chosen (`label`, or `placeholder` when nothing is) and opens a list narrowed by a search field. Put `Ui:Dropdown:Item`s in the content, each with `data-list-filter-target="item"` and a `data-text`, its action picking (a live action, then `dropdown#close`); group them in `Ui:Picker:Group`s when they are. Structure only: the picker holds no data. In a plain form the `picker` controller around it writes the choice (PickerType). `invalid` turns the border red. With `src` the list is not narrowed in the page: the address is asked for the items matching what is typed (`q`) and its answer replaces the content of the element marked `data-list-filter-target="results"`. #}
{% props label = null, placeholder = '', searchPlaceholder = '', empty = '', width = 'full', invalid = false, src = null %}
{% set pickerClasses = html_cva(base: 'block') %}
{% set pickerTriggerClasses = html_cva(
    base: 'inline-flex h-9 w-full items-center gap-2 rounded-md border bg-surface pl-3 pr-2 text-left text-sm hover:bg-subtle focus:border-focus focus:outline-none focus:ring-2 focus:ring-brand-line',
    variants: {
        chosen: { true: 'text-body', false: 'text-faint' },
        invalid: { true: 'border-red-solid', false: 'border-line-strong' },
    },
) %}
{% set pickerLabel = label %}
{% set pickerPlaceholder = placeholder %}
{% set pickerSearchPlaceholder = searchPlaceholder %}
{% set pickerEmpty = empty %}
{% set pickerSrc = src %}
{% set pickerTriggerClass = pickerTriggerClasses.apply({ chosen: label is not null, invalid: invalid }) %}
{# The caller's items, read before the nested dropdown whose own `content` block hosts them. #}
{% set pickerItems %}{% block content %}{% endblock %}{% endset %}
{# What is chosen, when it is more than a label (a person with their avatar): drawn on the button in place of the label. #}
{% set pickerChosenLine %}{% block chosen %}{% endblock %}{% endset %}
<twig:Ui:Dropdown :width="width" class="{{ pickerClasses.apply({}, attributes.render('class'))|tailwind_merge }}" {{ ...attributes.without('class') }}>
    <twig:block name="trigger">
        <button type="button" data-action="dropdown#toggle" aria-expanded="false" aria-haspopup="listbox" class="{{ pickerTriggerClass }}">
            <span class="flex min-w-0 flex-1 items-center gap-2.5 truncate" data-picker-target="label">{% if pickerChosenLine|trim is not empty %}{{ pickerChosenLine }}{% else %}<span class="truncate" data-picker-target="chosen">{{ pickerLabel ?? pickerPlaceholder }}</span>{% endif %}</span>
            <twig:ux:icon name="lucide:chevrons-up-down" class="h-3.5 w-3.5 shrink-0 text-faint" />
        </button>
    </twig:block>
    <twig:block name="content">
        <div data-controller="list-filter"{% if pickerSrc %} data-list-filter-url-value="{{ pickerSrc }}"{% endif %}>
            <label class="-mt-1 flex items-center gap-2 border-b border-line-subtle px-3 py-2 text-faint">
                <twig:ux:icon name="lucide:search" class="h-3.5 w-3.5 shrink-0" />
                <input type="search" data-dropdown-target="search" data-action="input->list-filter#filter" placeholder="{{ pickerSearchPlaceholder }}" aria-label="{{ pickerSearchPlaceholder }}" autocomplete="off" class="w-full border-0 bg-transparent p-0 text-sm text-body placeholder:text-faint focus:outline-none focus:ring-0">
            </label>
            <div class="max-h-72 overflow-y-auto py-1">
                {{ pickerItems }}
                <p data-list-filter-target="empty" hidden class="px-3 py-3 text-center text-sm text-faint">{{ pickerEmpty }}</p>
            </div>
        </div>
    </twig:block>
</twig:Ui:Dropdown>
