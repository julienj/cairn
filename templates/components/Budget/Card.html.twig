{# One budget with its lines, the latest first (all of them on the page of the budget, where they are also read by status; the latest five among the other budgets, which lead there for the rest): its name (a link to its own page), what it amounts to (`project/_budget_meter.html.twig`: what was consumed out of the volume, the bar, full once the budget is used up or overspent, and never past its end; what is left comes right after what was consumed, what waits for an approval last, since it is not taken from the budget yet), then each line: what it is for (an issue, a label or both; an issue the reader does not see is not named), its status and its quantity (the draft of a line to estimate greyed and a refused one struck, since they count for nothing, and kept from who may not read it). Whoever manages the budgets marks the status from the menu of the line (`mark`), and opens the dialogs of the page to write a line or change the rest (links aimed at the `modal` frame); a status that asks for a quantity the line does not have opens the dialog of the line instead, that status chosen. On the page of its budget (`standalone`) the card says so in the address of its dialogs, which then lead back there.
   The table is not a `Ui:Table`: its frame hides what overflows, and the menu of a last line would be cut. `this` is read before the nested components, whose blocks see their own `this`. #}
{% set cardStatement = this.statement %}
{% set cardSummary = cardStatement.summary %}
{% set cardManage = this.canManage %}
{% set cardStatuses = this.statuses %}
{% set cardProject = budget.project %}
{% set cardRoute = { workspaceKey: cardProject.workspace.key, projectKey: cardProject.key, budget: budget.id } %}
{% set cardDialogRoute = cardRoute|merge(standalone ? { from: 'budget' } : {}) %}
{# Among the other budgets a card shows its latest lines, and leads to the page of its budget for the rest. #}
{% set cardShown = standalone ? cardStatement.lines : cardStatement.lines|slice(0, 5) %}
{% set cardByStatus = standalone ? this.byStatus : [] %}
{# On its own page, the lines are read by status: a radio per status that has lines, which hides the others without asking the server. #}
{% set cardFilterClasses = standalone ? "has-[[value=to_estimate]:checked]:[&_tr[data-status]:not([data-status=to_estimate])]:hidden has-[[value=pending]:checked]:[&_tr[data-status]:not([data-status=pending])]:hidden has-[[value=approved]:checked]:[&_tr[data-status]:not([data-status=approved])]:hidden has-[[value=refused]:checked]:[&_tr[data-status]:not([data-status=refused])]:hidden" : '' %}
<section {{ attributes.defaults({ class: 'rounded-[10px] border border-line bg-surface shadow-sm ' ~ cardFilterClasses }) }} data-loading="addClass(opacity-60)">
    <div class="px-4 py-3.5">
        <div class="mb-3.5 flex flex-wrap items-center gap-x-3 gap-y-2">
            <h2 class="text-base font-semibold text-strong"><a href="{{ path('app_project_budget', cardRoute) }}" class="hover:text-brand hover:underline">{{ budget.name }}</a></h2>
            {% if not budget.open %}<twig:Ui:Badge tone="gray" size="sm">{{ 'budget.form.closed'|trans }}</twig:Ui:Badge>{% endif %}
            {% if cardSummary.remaining < 0 %}
                <twig:Ui:Badge tone="red" size="sm">{{ 'budget.overspent'|trans({ '%quantity%': (-cardSummary.remaining)|quantity(cardProject) }) }}</twig:Ui:Badge>
            {% elseif cardSummary.remaining == 0 and budget.volume > 0 %}
                <twig:Ui:Badge tone="gray" size="sm">{{ 'budget.used_up'|trans }}</twig:Ui:Badge>
            {% endif %}
            <span class="text-xs text-muted">{{ 'budget.lines'|trans({ '%count%': cardSummary.lines }) }}</span>
            {% if cardManage %}
                <div class="ml-auto flex items-center gap-1.5">
                    {% if budget.open %}
                        <twig:Ui:Button size="sm" icon="plus" href="{{ path('app_project_budget_line_new', cardDialogRoute) }}" data-turbo-frame="modal">{{ 'budget.line.new'|trans }}</twig:Ui:Button>
                    {% endif %}
                    <twig:Ui:IconButton icon="pencil" :label="'budget.edit'|trans" href="{{ path('app_project_budget_edit', cardDialogRoute) }}" data-turbo-frame="modal" />
                </div>
            {% endif %}
        </div>
        {% if error %}<twig:Ui:Callout tone="danger" size="sm" role="alert" class="mb-3">{{ error }}</twig:Ui:Callout>{% endif %}
        {{ include('project/_budget_meter.html.twig', { consumed: cardSummary.consumed, pending: cardSummary.pending, volume: budget.volume, project: cardProject }) }}
    </div>
    {% if cardStatement.lines is empty %}
        <p class="border-t border-line-subtle px-4 py-3 text-sm text-faint">{{ 'budget.line.empty'|trans }}</p>
    {% else %}
        {% if cardByStatus|length > 1 %}
            <fieldset class="flex flex-wrap items-center gap-1.5 border-t border-line-subtle px-4 py-2.5">
                <legend class="sr-only">{{ 'budget.line.status'|trans }}</legend>
                <label class="inline-flex h-7 cursor-pointer items-center gap-1.5 rounded-md px-2 text-xs text-muted ring-1 ring-inset ring-line hover:bg-subtle has-[:checked]:bg-brand-soft has-[:checked]:text-brand has-[:checked]:ring-brand-line has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-focus">
                    <input type="radio" name="budget-{{ budget.id }}-status" value="" checked class="sr-only">{{ 'budget.all_lines'|trans }} <span class="font-semibold tabular-nums">{{ cardStatement.lines|length }}</span>
                </label>
                {% for cardStatusKey, cardStatusTotal in cardByStatus %}
                    <label class="inline-flex h-7 cursor-pointer items-center gap-1.5 rounded-md px-2 text-xs text-muted ring-1 ring-inset ring-line hover:bg-subtle has-[:checked]:bg-brand-soft has-[:checked]:text-brand has-[:checked]:ring-brand-line has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-focus">
                        <input type="radio" name="budget-{{ budget.id }}-status" value="{{ cardStatusKey }}" class="sr-only">{{ ('budget.status.' ~ cardStatusKey)|trans }}
                        <span class="font-semibold tabular-nums">{{ cardStatusTotal.quantity is null ? 'budget.lines'|trans({ '%count%': cardStatusTotal.lines }) : cardStatusTotal.quantity|quantity(cardProject) }}</span>
                    </label>
                {% endfor %}
            </fieldset>
        {% endif %}
        <table class="w-full border-t border-line text-sm">
            <thead class="sr-only">
                <tr>
                    <th scope="col">{{ 'budget.line.date'|trans }}</th>
                    <th scope="col">{{ 'budget.line.subject'|trans }}</th>
                    <th scope="col">{{ 'budget.line.status'|trans }}</th>
                    <th scope="col">{{ 'budget.line.quantity'|trans }}</th>
                    {% if cardManage %}<th scope="col">{{ 'budget.edit'|trans }}</th>{% endif %}
                </tr>
            </thead>
            <tbody class="divide-y divide-line-subtle">
                {% for line in cardShown %}
                    <twig:Ui:Table:Row data-status="{{ line.status.value }}">
                        <td class="sm:py-2 sm:pl-4 sm:pr-3 whitespace-nowrap text-xs tabular-nums text-muted">{{ line.createdAt|format_date('medium') }}</td>
                        <td class="sm:px-3 sm:py-2 w-full min-w-0 basis-full">
                            {% if line.issue and cardStatement.hides(line) %}
                                <span class="text-muted">{{ 'budget.line.private_issue'|trans }}</span>
                            {% elseif line.issue %}
                                <twig:Ui:IssueKey :key="line.issue.key" href="{{ path('app_issue_show', { workspaceKey: cardProject.workspace.key, projectKey: cardProject.key, number: line.issue.number }) }}" />
                                <span class="ml-1.5 text-body">{{ line.issue.title }}</span>
                            {% endif %}
                            {% if line.label %}<span class="{{ line.issue ? 'ml-1.5 text-muted' : 'text-body' }}">{{ line.label }}</span>{% endif %}
                        </td>
                        <td class="ml-auto sm:ml-0 sm:px-3 sm:py-2 whitespace-nowrap">
                            {% if cardManage %}
                                <twig:Ui:Dropdown align="right" width="sm">
                                    <twig:block name="trigger">
                                        <button type="button" class="-mx-1 inline-flex items-center gap-1 rounded-md px-1 py-0.5 hover:bg-sunken aria-expanded:bg-sunken" aria-expanded="false" aria-haspopup="menu" aria-label="{{ 'budget.line.change_status'|trans }}" data-action="dropdown#toggle">
                                            {{ include('project/_budget_line_status.html.twig', { status: line.status }) }}
                                            <twig:ux:icon name="lucide:chevron-down" class="h-3.5 w-3.5 shrink-0 text-faint" />
                                        </button>
                                    </twig:block>
                                    <twig:block name="content">
                                        {% for cardStatus in cardStatuses %}
                                            {% if cardStatus == line.status %}
                                                <twig:Ui:Dropdown:Item active data-action="dropdown#close">
                                                    <span class="min-w-0 flex-1 truncate">{{ ('budget.status.' ~ cardStatus.value)|trans }}</span>
                                                    <twig:ux:icon name="lucide:check" class="h-4 w-4 shrink-0 text-brand" />
                                                </twig:Ui:Dropdown:Item>
                                            {% elseif line.quantity is null and cardStatus.needsQuantity %}
                                                <twig:Ui:Dropdown:Item href="{{ path('app_project_budget_line_edit', cardDialogRoute|merge({ line: line.id, status: cardStatus.value })) }}" data-turbo-frame="modal" data-action="dropdown#close">
                                                    <span class="min-w-0 flex-1 truncate">{{ ('budget.status.' ~ cardStatus.value)|trans }}</span>
                                                </twig:Ui:Dropdown:Item>
                                            {% else %}
                                                <twig:Ui:Dropdown:Item data-action="live#action dropdown#close" data-live-action-param="mark" data-live-line-param="{{ line.id }}" data-live-status-param="{{ cardStatus.value }}">
                                                    <span class="min-w-0 flex-1 truncate">{{ ('budget.status.' ~ cardStatus.value)|trans }}</span>
                                                </twig:Ui:Dropdown:Item>
                                            {% endif %}
                                        {% endfor %}
                                    </twig:block>
                                </twig:Ui:Dropdown>
                            {% else %}
                                {{ include('project/_budget_line_status.html.twig', { status: line.status }) }}
                            {% endif %}
                        </td>
                        {% set cardQuantity = cardStatement.quantityOf(line) %}
                        <td class="sm:px-3 sm:py-2 whitespace-nowrap text-right font-medium tabular-nums {{ line.status.value == 'to_estimate' ? 'text-muted' : (line.status.value == 'refused' ? 'text-faint line-through' : 'text-strong') }}">{{ cardQuantity is null ? '—' : cardQuantity|quantity(cardProject) }}</td>
                        {% if cardManage %}
                            <td class="sm:py-1.5 sm:pl-1 sm:pr-3 text-right">
                                <twig:Ui:IconButton icon="pencil" :label="'budget.edit'|trans" class="hover-actions" href="{{ path('app_project_budget_line_edit', cardDialogRoute|merge({ line: line.id })) }}" data-turbo-frame="modal" />
                            </td>
                        {% endif %}
                    </twig:Ui:Table:Row>
                {% endfor %}
            </tbody>
        </table>
        {% if cardShown|length < cardStatement.lines|length %}
            <a href="{{ path('app_project_budget', cardRoute) }}" class="group/see flex items-center justify-end gap-1 rounded-b-[10px] border-t border-line-subtle px-4 py-2.5 text-xs font-medium text-brand hover:bg-subtle">{{ 'budget.see_lines'|trans({ '%count%': cardStatement.lines|length }) }}<twig:ux:icon name="lucide:arrow-right" class="h-3 w-3 transition-transform group-hover/see:translate-x-0.5" /></a>
        {% endif %}
    {% endif %}
</section>
