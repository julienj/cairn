{# Administration level: projects, workspaces, project templates, users, teams, imports; then the configuration, one entry per subject. The entry is active on its own pages and on the pages under it.
   `this` is read before the nested components, whose blocks see their own `this`. #}
{% set adminNavRoute = app.current_route ?? '' %}
{% set adminNavCounts = { projects: this.projectCount, workspaces: this.workspaceCount, users: this.userCount, templates: this.templateCount, teams: this.teamCount } %}
<twig:Ui:Layout:Sidebar :title="'admin.title'|trans">
    <twig:Ui:Layout:Sidebar:Section :label="'admin.title'|trans">
        <twig:Ui:Layout:Sidebar:Item href="{{ path('app_admin_projects') }}" icon="list" :count="adminNavCounts.projects" :active="adminNavRoute starts with 'app_admin_project'">{{ 'admin.nav.projects'|trans }}</twig:Ui:Layout:Sidebar:Item>
        <twig:Ui:Layout:Sidebar:Item href="{{ path('app_admin_workspaces') }}" icon="folders" :count="adminNavCounts.workspaces" :active="adminNavRoute starts with 'app_admin_workspace'">{{ 'admin.nav.workspaces'|trans }}</twig:Ui:Layout:Sidebar:Item>
        <twig:Ui:Layout:Sidebar:Item href="{{ path('app_admin_templates') }}" icon="copy" :count="adminNavCounts.templates" :active="adminNavRoute starts with 'app_admin_template'">{{ 'admin.nav.templates'|trans }}</twig:Ui:Layout:Sidebar:Item>
        <twig:Ui:Layout:Sidebar:Item href="{{ path('app_admin_users') }}" icon="users" :count="adminNavCounts.users" :active="adminNavRoute starts with 'app_admin_user'">{{ 'admin.nav.users'|trans }}</twig:Ui:Layout:Sidebar:Item>
        <twig:Ui:Layout:Sidebar:Item href="{{ path('app_admin_teams') }}" icon="users-round" :count="adminNavCounts.teams" :active="adminNavRoute starts with 'app_admin_team'">{{ 'admin.nav.teams'|trans }}</twig:Ui:Layout:Sidebar:Item>
        <twig:Ui:Layout:Sidebar:Item href="{{ path('app_admin_imports') }}" icon="archive-restore" :active="adminNavRoute starts with 'app_admin_import'">{{ 'admin.nav.imports'|trans }}</twig:Ui:Layout:Sidebar:Item>
    </twig:Ui:Layout:Sidebar:Section>
    <twig:Ui:Layout:Sidebar:Section :label="'admin.nav.configuration'|trans">
        <twig:Ui:Layout:Sidebar:Item href="{{ path('app_admin_configuration_roles') }}" icon="shield" :active="adminNavRoute starts with 'app_admin_configuration_role'">{{ 'admin.configuration.nav.roles'|trans }}</twig:Ui:Layout:Sidebar:Item>
        <twig:Ui:Layout:Sidebar:Item href="{{ path('app_admin_configuration_places') }}" icon="milestone" :active="adminNavRoute starts with 'app_admin_configuration_place'">{{ 'admin.configuration.nav.places'|trans }}</twig:Ui:Layout:Sidebar:Item>
        <twig:Ui:Layout:Sidebar:Item href="{{ path('app_admin_configuration_fields') }}" icon="text-cursor-input" :active="adminNavRoute starts with 'app_admin_configuration_field' or adminNavRoute starts with 'app_admin_configuration_link'">{{ 'admin.configuration.nav.fields'|trans }}</twig:Ui:Layout:Sidebar:Item>
        <twig:Ui:Layout:Sidebar:Item href="{{ path('app_admin_configuration_workflows') }}" icon="workflow" :active="adminNavRoute starts with 'app_admin_configuration_workflow' or adminNavRoute starts with 'app_admin_configuration_transition'">{{ 'admin.configuration.nav.workflows'|trans }}</twig:Ui:Layout:Sidebar:Item>
        <twig:Ui:Layout:Sidebar:Item href="{{ path('app_admin_configuration_history') }}" icon="history" :active="adminNavRoute == 'app_admin_configuration_history'">{{ 'admin.configuration.nav.history'|trans }}</twig:Ui:Layout:Sidebar:Item>
    </twig:Ui:Layout:Sidebar:Section>
</twig:Ui:Layout:Sidebar>
