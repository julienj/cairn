{# Project level: the issue lists and the releases, the trackers the viewer may see (archived ones at their place, under the archive icon), each list with its count of open issues, then the configuration of the project, one item per subject, for those who manage it (the access under `project.manage_members`, the rest under `project.configure`). On a wide screen it folds away (`sidebar-collapsed`), from the button of the breadcrumb (`layout/project.html.twig`). #}
{% set route = { workspaceKey: project.workspace.key, projectKey: project.key } %}
{% set navTrackers = this.trackers %}
{% set navCounts = this.counts %}
{% set navRoute = app.current_route %}
{% set navReleases = this.hasReleases or is_granted('release.manage', project) %}
{% set navBudgets = this.readsBudgets %}
<twig:Ui:Layout:Sidebar :title="project.name" class="md:sidebar-collapsed:hidden">
    <twig:Ui:Layout:Sidebar:Section :label="'nav.project.issues'|trans">
        <twig:Ui:Layout:Sidebar:Item href="{{ path('app_project_issues', route) }}" icon="list" :count="navCounts.all" :active="app.current_route == 'app_project_issues'">{{ 'nav.issues.all'|trans }}</twig:Ui:Layout:Sidebar:Item>
        <twig:Ui:Layout:Sidebar:Item href="{{ path('app_project_issues_assigned', route) }}" icon="user" :count="navCounts.assigned" :active="app.current_route == 'app_project_issues_assigned'">{{ 'nav.issues.assigned'|trans }}</twig:Ui:Layout:Sidebar:Item>
        <twig:Ui:Layout:Sidebar:Item href="{{ path('app_project_issues_created', route) }}" icon="pencil" :count="navCounts.created" :active="app.current_route == 'app_project_issues_created'">{{ 'nav.issues.created'|trans }}</twig:Ui:Layout:Sidebar:Item>
        {% if navReleases %}
            <twig:Ui:Layout:Sidebar:Item href="{{ path('app_project_releases', route) }}" icon="milestone" :active="app.current_route starts with 'app_project_release'">{{ 'nav.project.releases'|trans }}</twig:Ui:Layout:Sidebar:Item>
        {% endif %}
        {% if navBudgets %}
            <twig:Ui:Layout:Sidebar:Item href="{{ path('app_project_budgets', route) }}" icon="hourglass" :active="app.current_route starts with 'app_project_budget'">{{ 'nav.project.budgets'|trans }}</twig:Ui:Layout:Sidebar:Item>
        {% endif %}
    </twig:Ui:Layout:Sidebar:Section>
    {% if navTrackers is not empty %}
        <twig:Ui:Layout:Sidebar:Section :label="'nav.project.trackers'|trans">
            {% for tracker in navTrackers %}
                <twig:Ui:Layout:Sidebar:Item href="{{ path('app_project_issues_tracker', route|merge({ tracker: tracker.id })) }}" :icon="tracker.archived ? 'archive' : 'kanban'" :count="navCounts.of(tracker)" :locked="tracker.private" :active="app.current_route == 'app_project_issues_tracker' and app.current_route_parameters.tracker == tracker.id">{{ tracker.name }}</twig:Ui:Layout:Sidebar:Item>
            {% endfor %}
        </twig:Ui:Layout:Sidebar:Section>
    {% endif %}
    {% set navManagesMembers = is_granted('project.manage_members', project) %}
    {% set navConfigures = is_granted('project.configure', project) %}
    {% if navManagesMembers or navConfigures %}
        <twig:Ui:Layout:Sidebar:Section :label="'nav.project.configuration.title'|trans">
            {% if navConfigures %}
                <twig:Ui:Layout:Sidebar:Item href="{{ path('app_project_settings_general', route) }}" icon="settings" :active="navRoute == 'app_project_settings_general'">{{ 'nav.project.configuration.general'|trans }}</twig:Ui:Layout:Sidebar:Item>
                <twig:Ui:Layout:Sidebar:Item href="{{ path('app_project_settings', route) }}" icon="kanban" :active="navRoute in ['app_project_settings', 'app_project_settings_tracker', 'app_project_settings_tracker_new']">{{ 'nav.project.configuration.trackers'|trans }}</twig:Ui:Layout:Sidebar:Item>
                <twig:Ui:Layout:Sidebar:Item href="{{ path('app_project_settings_tags', route) }}" icon="tags" :active="navRoute starts with 'app_project_settings_tag'">{{ 'nav.project.configuration.tags'|trans }}</twig:Ui:Layout:Sidebar:Item>
            {% endif %}
            {% if navManagesMembers %}
                <twig:Ui:Layout:Sidebar:Item href="{{ path('app_project_access', route) }}" icon="users" :active="navRoute == 'app_project_access'">{{ 'nav.project.configuration.access'|trans }}</twig:Ui:Layout:Sidebar:Item>
            {% endif %}
            {% if navConfigures %}
                <twig:Ui:Layout:Sidebar:Item href="{{ path('app_project_settings_automations', route) }}" icon="zap" :active="navRoute starts with 'app_project_settings_automation'">{{ 'nav.project.configuration.automations'|trans }}</twig:Ui:Layout:Sidebar:Item>
                <twig:Ui:Layout:Sidebar:Item href="{{ path('app_project_settings_repositories', route) }}" icon="git-branch" :active="navRoute starts with 'app_project_settings_repositor'">{{ 'nav.project.configuration.repositories'|trans }}</twig:Ui:Layout:Sidebar:Item>
                <twig:Ui:Layout:Sidebar:Item href="{{ path('app_project_settings_widget', route) }}" icon="message-square" :active="navRoute starts with 'app_project_settings_widget'">{{ 'nav.project.configuration.widget'|trans }}</twig:Ui:Layout:Sidebar:Item>
            {% endif %}
        </twig:Ui:Layout:Sidebar:Section>
    {% endif %}
</twig:Ui:Layout:Sidebar>
