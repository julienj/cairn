{# The editor of an automation rule, of a project (Automation:RuleForm) or of a project template (Template:RuleForm): its name and where it applies, then When (one trigger), If (the conditions, all true) and Then (the actions, in order); beside it, the rule in one sentence. A row is the choice of its type followed by the fields that type asks for; the form is redrawn at each change.
   `this` is read before the nested components, whose blocks see their own `this`. #}
{% set ruleFormSentence = this.sentence %}
{% set ruleFormTimed = this.timed %}
{% set ruleFormCancel = this.cancelUrl %}
{# One rhythm for every row: controls 2rem high, the type of a step in a column of its own width, its values beside it. #}
{% set ruleFormRowClasses = 'flex flex-wrap items-center gap-2' %}
{% set ruleFormStepClasses = 'flex flex-wrap gap-x-4 gap-y-2 px-4 py-3.5' %}
{% set ruleFormLabelClasses = 'w-28 shrink-0 space-y-1' %}
{% set ruleFormTypeClasses = 'w-full sm:w-72' %}
{% set ruleFormValueClasses = 'w-full sm:w-72' %}
{% set ruleFormControl = 'mt-0 h-8 py-0' %}
{% set ruleFormPillClasses = 'my-1 inline-flex h-6 items-center gap-1.5 rounded-md px-2 text-xs font-semibold uppercase tracking-wide' %}
{% set ruleFormAddClasses = 'mt-2.5 inline-flex h-8 items-center gap-1.5 self-start rounded-md border border-dashed border-line-strong bg-surface px-2.5 text-sm text-body hover:bg-subtle' %}
{# A condition or an action is a card of its own, its values and its help inside; the word that joins two cards reads as the sentence does. #}
{% set ruleFormCardClasses = 'space-y-2.5 rounded-md border border-line bg-subtle/50 p-2.5' %}
{% set ruleFormJoinClasses = 'ml-5 flex h-7 items-center border-l-2 pl-3 text-[11px] font-semibold uppercase tracking-wide' %}
{% set ruleFormValuesClasses = 'space-y-1.5 border-t border-line-subtle pt-2.5' %}
{% set ruleFormValuesLabelClasses = 'text-xs font-medium text-muted' %}
<div {{ attributes }} class="grid max-w-6xl items-start gap-5 lg:grid-cols-[minmax(0,1fr)_18rem]" data-loading="addClass(opacity-60)">
    {{ form_start(form, { attr: form.vars.attr|merge({ class: 'space-y-4', 'data-action': 'live#action:prevent', 'data-live-action-param': 'save' }) }) }}
        {{ form_errors(form) }}
        {% if error %}<twig:Ui:Callout tone="danger" size="sm" role="alert">{{ error }}</twig:Ui:Callout>{% endif %}

        <section class="grid gap-x-4 gap-y-3 rounded-lg border border-line bg-surface p-4 sm:grid-cols-[minmax(0,1fr)_15rem]">
            {{ form_row(form.name) }}
            {{ form_row(form.tracker) }}
        </section>

        <section class="divide-y divide-line-subtle rounded-lg border border-line bg-surface">
            <div class="{{ ruleFormStepClasses }}">
                <div class="{{ ruleFormLabelClasses }}">
                    <span class="{{ ruleFormPillClasses }} bg-brand-soft text-brand"><twig:ux:icon name="{{ ruleFormTimed ? 'lucide:clock' : 'lucide:zap' }}" class="h-3 w-3" />{{ 'automation.form.when'|trans }}</span>
                </div>
                <div class="min-w-0 flex-1 basis-72 space-y-1.5">
                    <div class="{{ ruleFormRowClasses }}">
                        <div class="{{ ruleFormTypeClasses }}">{{ form_widget(form.trigger.type, { attr: { class: ruleFormControl, 'aria-label': 'automation.form.when'|trans } }) }}</div>
                        {% for field in form.trigger.params %}
                            {% if 'integer' in field.vars.block_prefixes %}
                                <div class="flex items-center gap-2 text-sm text-body">{{ form_widget(field, { attr: field.vars.attr|merge({ class: ruleFormControl ~ ' w-20' }) }) }} {{ 'automation.form.days'|trans }}</div>
                            {% else %}
                                <div class="{{ ruleFormValueClasses }}">{{ form_widget(field, { attr: field.vars.attr|merge({ class: ruleFormControl }) }) }}</div>
                            {% endif %}
                            {{ form_errors(field) }}
                        {% endfor %}
                    </div>
                    <p class="text-xs text-muted">{{ (ruleFormTimed ? 'automation.form.timed_help' : 'automation.form.event_help')|trans }}</p>
                </div>
            </div>

            <div class="{{ ruleFormStepClasses }}">
                <div class="{{ ruleFormLabelClasses }}">
                    <span class="{{ ruleFormPillClasses }} bg-amber-soft text-amber"><twig:ux:icon name="lucide:filter" class="h-3 w-3" />{{ 'automation.form.if'|trans }}</span>
                    <p class="text-xs leading-snug text-muted">{{ 'automation.form.if_help'|trans }}</p>
                </div>
                <div class="flex min-w-0 flex-1 basis-72 flex-col">
                    {% for index, row in form.conditions %}
                        {% if not loop.first %}<div class="{{ ruleFormJoinClasses }} border-amber-line text-amber">{{ 'automation.form.and'|trans }}</div>{% endif %}
                        <div class="{{ ruleFormCardClasses }}">
                            <div class="flex items-start gap-2">
                                <div class="{{ ruleFormRowClasses }} min-w-0 flex-1">
                                    <div class="{{ ruleFormTypeClasses }}">{{ form_widget(row.type, { attr: { class: ruleFormControl, 'aria-label': 'automation.form.if'|trans } }) }}</div>
                                    {% for field in row.params %}
                                        {% if not field.vars.expanded|default(false) %}
                                            <div class="{{ ruleFormValueClasses }}">{{ form_widget(field, { attr: field.vars.attr|merge({ class: ruleFormControl }) }) }}{{ form_errors(field) }}</div>
                                        {% endif %}
                                    {% endfor %}
                                </div>
                                <twig:Ui:IconButton icon="x" :label="'automation.form.remove'|trans" class="mt-0.5" data-action="live#action" data-live-action-param="removeCondition" data-live-index-param="{{ index }}" />
                            </div>
                            {# Several values: one box each, any of them holds. #}
                            {% for field in row.params %}
                                {% if field.vars.expanded|default(false) %}
                                    <div class="{{ ruleFormValuesClasses }}">
                                        <p class="{{ ruleFormValuesLabelClasses }}">{{ 'automation.form.any_of'|trans }}</p>
                                        <div class="flex flex-wrap gap-x-5 gap-y-1.5">
                                            {% for ruleFormBox in field %}
                                                <twig:Ui:Form:Checkbox :label="ruleFormBox.vars.label" :checked="ruleFormBox.vars.checked" :id="ruleFormBox.vars.id" :name="ruleFormBox.vars.full_name" :value="ruleFormBox.vars.value" />
                                                {% do ruleFormBox.setRendered %}
                                            {% endfor %}
                                        </div>
                                        {% do field.setRendered %}
                                        {{ form_errors(field) }}
                                    </div>
                                {% endif %}
                            {% endfor %}
                        </div>
                    {% else %}
                        <p class="flex min-h-8 items-center text-sm text-muted">{{ 'automation.form.no_condition'|trans }}</p>
                    {% endfor %}
                    <button type="button" class="{{ ruleFormAddClasses }}" data-action="live#action" data-live-action-param="addCondition"><twig:ux:icon name="lucide:plus" class="h-3.5 w-3.5" />{{ 'automation.form.add_condition'|trans }}</button>
                </div>
            </div>

            <div class="{{ ruleFormStepClasses }}">
                <div class="{{ ruleFormLabelClasses }}">
                    <span class="{{ ruleFormPillClasses }} bg-emerald-soft text-emerald"><twig:ux:icon name="lucide:play" class="h-3 w-3" />{{ 'automation.form.then'|trans }}</span>
                    <p class="text-xs leading-snug text-muted">{{ 'automation.form.then_help'|trans }}</p>
                </div>
                <div class="flex min-w-0 flex-1 basis-72 flex-col">
                    {% for index, row in form.actions %}
                        {% if not loop.first %}<div class="{{ ruleFormJoinClasses }} border-emerald-line text-emerald">{{ 'automation.form.next'|trans }}</div>{% endif %}
                        <div class="{{ ruleFormCardClasses }}">
                            <div class="flex items-start gap-2">
                                <div class="{{ ruleFormRowClasses }} min-w-0 flex-1">
                                    <div class="{{ ruleFormTypeClasses }}">{{ form_widget(row.type, { attr: { class: ruleFormControl, 'aria-label': 'automation.form.then'|trans } }) }}</div>
                                    {% for field in row.params %}
                                        {% if 'textarea' not in field.vars.block_prefixes and not field.vars.expanded|default(false) %}
                                            <div class="{{ 'checkbox' in field.vars.block_prefixes ? 'min-w-0 flex-1 basis-48 px-1' : ruleFormValueClasses }}">{{ form_widget(field, { attr: field.vars.attr|merge({ class: ruleFormControl }) }) }}{{ form_errors(field) }}</div>
                                        {% endif %}
                                    {% endfor %}
                                </div>
                                <twig:Ui:IconButton icon="x" :label="'automation.form.remove'|trans" class="mt-0.5" data-action="live#action" data-live-action-param="removeAction" data-live-index-param="{{ index }}" />
                            </div>
                            {% for field in row.params %}
                                {% if field.vars.expanded|default(false) %}
                                    {# Several values: one box each, the action holds on any of them. #}
                                    <div class="{{ ruleFormValuesClasses }}">
                                        <p class="{{ ruleFormValuesLabelClasses }}">{{ ('automation.form.' ~ row.type.vars.value ~ '_' ~ field.vars.name)|trans }}</p>
                                        <div class="flex flex-wrap gap-x-5 gap-y-1.5">
                                            {% for ruleFormBox in field %}
                                                <twig:Ui:Form:Checkbox :label="ruleFormBox.vars.label" :checked="ruleFormBox.vars.checked" :id="ruleFormBox.vars.id" :name="ruleFormBox.vars.full_name" :value="ruleFormBox.vars.value" />
                                                {% do ruleFormBox.setRendered %}
                                            {% endfor %}
                                        </div>
                                        {% do field.setRendered %}
                                        <p class="text-xs text-muted">{{ ('automation.form.' ~ row.type.vars.value ~ '_help')|trans }}</p>
                                        {{ form_errors(field) }}
                                    </div>
                                {% elseif 'textarea' in field.vars.block_prefixes %}
                                    <div class="space-y-1.5">
                                        {{ form_widget(field, { attr: field.vars.attr|merge({ class: 'mt-0 block' }) }) }}
                                        {{ form_errors(field) }}
                                        <p class="text-xs text-muted">{{ 'automation.form.body_help'|trans }}</p>
                                    </div>
                                {% elseif field.vars.name == 'target' %}
                                    {# A referent is a role, not a person: who it leads to today, or that nobody answers for it. #}
                                    {% set ruleFormReferent = this.referentToday(field.vars.value ?? '') %}
                                    {% if ruleFormReferent is not null %}
                                        <p class="text-xs {{ ruleFormReferent.answers ? 'text-muted' : 'text-amber' }}">{{ (ruleFormReferent.answers ? 'automation.form.referent_today' : (ruleFormReferent.name ? 'automation.form.referent_unavailable' : 'automation.form.referent_missing'))|trans({ '%name%': ruleFormReferent.name }) }}</p>
                                    {% endif %}
                                {% endif %}
                            {% endfor %}
                        </div>
                    {% endfor %}
                    <button type="button" class="{{ ruleFormAddClasses }}" data-action="live#action" data-live-action-param="addAction"><twig:ux:icon name="lucide:plus" class="h-3.5 w-3.5" />{{ 'automation.form.add_action'|trans }}</button>
                </div>
            </div>
        </section>

        <div class="flex flex-wrap items-center gap-2">
            <twig:Ui:Button type="submit" variant="primary" data-loading="addAttribute(disabled)">{{ 'automation.form.save'|trans }}</twig:Ui:Button>
            <twig:Ui:Button variant="secondary" href="{{ ruleFormCancel }}">{{ 'automation.form.cancel'|trans }}</twig:Ui:Button>
            {% if rule and not deleting %}
                <twig:Ui:Button variant="danger" class="ml-auto" data-action="live#action" data-live-action-param="confirmDelete">{{ 'automation.delete'|trans }}</twig:Ui:Button>
            {% endif %}
        </div>
        {% if rule and deleting %}
            <div class="flex flex-wrap items-center gap-2 rounded-md border border-red-line bg-red-soft px-3 py-2 text-sm text-red" role="alertdialog">
                <span>{{ 'automation.delete_confirm'|trans }}</span>
                <span class="ml-auto flex items-center gap-2">
                    <twig:Ui:Button variant="danger" size="sm" data-action="live#action" data-live-action-param="delete" data-loading="addAttribute(disabled)">{{ 'automation.delete'|trans }}</twig:Ui:Button>
                    <twig:Ui:Button variant="ghost" size="sm" data-action="live#action" data-live-action-param="cancelDelete">{{ 'admin.cancel'|trans }}</twig:Ui:Button>
                </span>
            </div>
        {% endif %}
    {{ form_end(form, { render_rest: false }) }}

    <aside class="space-y-4 lg:sticky lg:top-4">
        <section class="space-y-2 rounded-lg border border-brand-line bg-brand-soft p-4">
            <h2 class="text-xs font-semibold uppercase tracking-wider text-brand">{{ 'automation.form.in_plain'|trans }}</h2>
            <p class="text-sm text-strong">{{ ruleFormSentence }}</p>
        </section>
        <section class="space-y-2 rounded-lg border border-line bg-surface p-4 text-xs text-muted">
            <h2 class="text-sm font-semibold text-strong">{{ 'automation.form.how'|trans }}</h2>
            <p>{{ 'automation.form.how_author'|trans }}</p>
            <p>{{ 'automation.form.how_rights'|trans }}</p>
            <p>{{ 'automation.form.how_chain'|trans }}</p>
        </section>
    </aside>
</div>
