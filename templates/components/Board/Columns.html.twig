{# The kanban of a tracker: one column per place of its workflow, each loaded when it shows (loading="lazy"), or at once in the answer of the frame (`eager`) so that a change of filter shows no placeholder, and by batches, the closed places folded, then the component that moves cards. Columns and the mover are siblings: none redraws another. Each column receives the filters of the address as the list reads them. #}
<div {{ attributes }}>
    <div class="flex items-stretch gap-3 overflow-x-auto px-4 sm:px-6 py-4" style="height: calc(100vh - 14.5rem)">
        {% for columnsPlace in this.places %}
            <twig:Board:Column
                :loading="eager ? false : 'lazy'"
                :tracker="scope.tracker"
                :placeId="columnsPlace.id"
                :open="columnsPlace.status.value != 'closed'"
                :query="filters.toQuery"
            />
        {% endfor %}
    </div>
    <twig:Board:Move />
</div>
