{# The memberships of a workspace or a project (one row per person) or of a user (one row per workspace or project). The role of a row is a select bound to `roles`, applied on change; removing a row asks for a confirmation in place; a member still waiting for their password can be invited again. The administration adds with a form closing the list, picking a person, or a workspace or a project, in a searchable list; on a project, someone is added by email in a dialog (`adding`). On a workspace and on a project, a card says first who answers for each role and is the one place where a referent is designated (on a project: its own, or else the one of the workspace); on a project come then the roles inherited from the workspace, read-only. #}
{% set grantsSelectClasses = 'h-8 rounded-md border border-line-strong bg-surface py-0 pl-2 pr-8 text-sm text-body focus:border-focus focus:outline-none focus:ring-0' %}
{% set grantsMemberships = this.memberships %}
{% set grantsInherited = this.inherited %}
{% set grantsAdmin = is_granted('ROLE_ADMIN') %}
{# Only the lists fade while the component reloads: the dialog is drawn inside it and would flash with them. #}
<div {{ attributes }} class="space-y-4">
{% set grantsReferentRows = this.referentRows %}
{% if grantsReferentRows is not empty %}
    {# The referents, managed here only: who each role answers through. On a project, its own referent replaces the one of the workspace. #}
    <section class="rounded-lg border border-line bg-surface" data-loading="addClass(opacity-60)">
        <header class="flex flex-wrap items-baseline gap-2 px-4 py-3 border-b border-line-subtle rounded-t-lg">
            <h2 class="font-semibold text-strong">{{ 'admin.access.referents.title'|trans }}</h2>
            <span class="text-xs text-muted">{{ (project ? 'admin.access.referents.help_project' : 'admin.access.referents.help_workspace')|trans }}</span>
        </header>
        <ul class="divide-y divide-line-subtle">
            {% for row in grantsReferentRows %}
                {% set grantsBack = row.fallback ? 'admin.access.referents.use_workspace'|trans({ '%name%': row.fallback.fullName }) : (project ? 'admin.access.referents.use_nobody' : 'admin.access.referents.nobody')|trans %}
                <li class="flex flex-wrap items-center gap-x-3 gap-y-1 px-4 py-2.5" data-role="{{ row.role }}">
                    <span class="w-36 shrink-0 text-sm text-muted">{{ row.label }}</span>
                    <div class="min-w-0 flex-1 basis-64 flex items-center gap-2.5">
                        <twig:User:Avatar :user="row.user" size="lg" />
                        <div class="min-w-0 leading-tight">
                            <span class="flex flex-wrap items-center gap-2">
                                <span class="text-sm truncate {{ row.user ? 'text-strong' : 'text-faint' }}">{{ row.user ? row.user.fullName : 'admin.access.referents.nobody'|trans }}</span>
                                {% if row.origin %}
                                    <twig:Ui:Badge :tone="row.origin == 'from_project' ? 'indigo' : 'gray'" :icon="row.origin == 'from_project' ? 'user-check' : 'corner-down-right'" size="sm">{{ ('admin.access.referents.' ~ row.origin)|trans }}</twig:Ui:Badge>
                                {% endif %}
                            </span>
                            <span class="block text-xs {{ row.warning ? 'text-amber' : 'text-muted' }}">{{ ('admin.access.referents.' ~ row.note)|trans({ '%name%': row.name }) }}</span>
                        </div>
                    </div>
                    {% if row.candidates is not empty or row.own %}
                        <twig:Ui:Dropdown align="right" width="lg" class="shrink-0">
                            <twig:block name="trigger">
                                <twig:Ui:Button size="sm" aria-expanded="false" aria-haspopup="menu" aria-label="{{ 'admin.access.referents.choose'|trans({ '%role%': row.label }) }}" data-action="dropdown#toggle">
                                    {{ (row.own ? 'admin.access.referents.change' : 'admin.access.referents.designate')|trans }}
                                    <twig:ux:icon name="lucide:chevron-down" class="h-3.5 w-3.5 text-faint" />
                                </twig:Ui:Button>
                            </twig:block>
                            <twig:block name="content">
                                {% for candidate in row.candidates %}
                                    <twig:Ui:Dropdown:Item :active="candidate.referent" data-action="live#action dropdown#close" data-live-action-param="setReferent" data-live-membership-param="{{ candidate.id }}" data-live-referent-param="1">
                                        <twig:User:Line :user="candidate.user" />
                                        {% if candidate.referent %}<twig:ux:icon name="lucide:check" class="h-4 w-4 shrink-0 text-brand" />{% endif %}
                                    </twig:Ui:Dropdown:Item>
                                {% endfor %}
                                {# Back to nobody here: on a project, to what its workspace says. #}
                                <div class="{{ row.candidates ? 'mt-1 border-t border-line-subtle pt-1' }}">
                                    {% if row.own %}
                                        <twig:Ui:Dropdown:Item :icon="project ? 'corner-down-right' : 'user-x'" data-action="live#action dropdown#close" data-live-action-param="setReferent" data-live-membership-param="{{ row.own.id }}" data-live-referent-param="0">
                                            <span class="min-w-0 flex-1 truncate">{{ grantsBack }}</span>
                                        </twig:Ui:Dropdown:Item>
                                    {% else %}
                                        <twig:Ui:Dropdown:Item active :icon="project ? 'corner-down-right' : 'user-x'" data-action="dropdown#close">
                                            <span class="min-w-0 flex-1 truncate">{{ grantsBack }}</span>
                                            <twig:ux:icon name="lucide:check" class="h-4 w-4 shrink-0 text-brand" />
                                        </twig:Ui:Dropdown:Item>
                                    {% endif %}
                                </div>
                            </twig:block>
                        </twig:Ui:Dropdown>
                    {% elseif project and grantsAdmin %}
                        <a href="{{ path('app_admin_workspace_access', { key: project.workspace.key }) }}" class="shrink-0 text-xs text-brand hover:underline">{{ 'admin.access.referents.designate_in_workspace'|trans }}</a>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    </section>
{% endif %}
{% if project %}
    <section class="rounded-lg border border-line bg-surface" data-loading="addClass(opacity-60)">
        <header class="flex flex-wrap items-center gap-2 px-4 py-3 border-b border-line-subtle bg-subtle/60 rounded-t-lg">
            <h2 class="font-semibold text-strong">{{ 'project.access.inherited'|trans({ '%workspace%': project.workspace.name }) }}</h2>
            <span class="text-xs text-faint">{{ grantsInherited|length }}</span>
            {% if grantsAdmin %}
                <a href="{{ path('app_admin_workspace_access', { key: project.workspace.key }) }}" class="ml-auto text-xs text-brand hover:underline">{{ 'project.access.edit_in_workspace'|trans }}</a>
            {% endif %}
        </header>
        {% if grantsInherited is empty %}
            <p class="px-4 py-4 text-center text-sm text-faint">{{ 'project.access.no_inherited'|trans }}</p>
        {% else %}
            <ul class="divide-y divide-line-subtle">
                {% for membership in grantsInherited %}
                    {% set grantsUser = membership.user %}
                    <li class="flex items-center gap-3 px-4 py-2">
                        <twig:User:Identity :user="grantsUser">
                            <twig:block name="badges">{% if not grantsUser.active %}<twig:Ui:Badge tone="gray" size="sm">{{ 'admin.user.state.deactivated'|trans }}</twig:Ui:Badge>{% endif %}</twig:block>
                        </twig:User:Identity>
                        {% set grantsRoleLabel = this.roleLabel(membership.role) %}
                        <twig:Ui:Badge>{{ grantsRoleLabel }}</twig:Ui:Badge>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </section>
{% endif %}
<section class="rounded-lg border border-line bg-surface" data-loading="addClass(opacity-60)">
    {% if project %}
        <header class="flex flex-wrap items-center gap-2 px-4 py-3 border-b border-line-subtle">
            <h2 class="font-semibold text-strong">{{ 'project.access.direct'|trans }}</h2>
            <span class="text-xs text-faint">{{ grantsMemberships|length }}</span>
            <span class="text-xs text-muted">{{ 'project.access.direct_help'|trans }}</span>
        </header>
    {% endif %}
    {% if error and not adding %}
        <twig:Ui:Callout tone="danger" size="sm" role="alert" class="m-3">{{ error }}</twig:Ui:Callout>
    {% endif %}
    {% if grantsMemberships is empty %}
        <p class="px-4 py-6 text-center text-sm text-faint">{{ (project ? 'project.access.empty' : workspace ? 'admin.access.empty_workspace' : 'admin.access.empty_user')|trans }}</p>
    {% else %}
        <ul class="divide-y divide-line-subtle">
            {% for membership in grantsMemberships %}
                {% set grantsUser = membership.user %}
                {% set grantsPending = (workspace or project) and grantsUser.awaitsPassword %}
                <li class="group px-4 py-2">
                    <div class="flex flex-wrap items-center gap-3">
                        {% if workspace or project %}
                            {% set grantsHeld = grantsInherited[grantsUser.id] ?? null %}
                            {# `this` is read before the component, whose blocks see their own. #}
                            {% set grantsHeldNote = grantsHeld ? 'project.access.inherits'|trans({ '%role%': this.roleLabel(grantsHeld.role) }) : null %}
                            <twig:User:Identity :user="grantsUser" :href="grantsAdmin ? path('app_admin_user', { id: grantsUser.id }) : null" :detail="grantsHeldNote">
                                <twig:block name="badges">{% if not grantsUser.active %}<twig:Ui:Badge tone="gray" size="sm">{{ 'admin.user.state.deactivated'|trans }}</twig:Ui:Badge>{% elseif grantsPending %}<twig:Ui:Badge tone="amber" size="sm">{{ 'admin.user.state.invited'|trans }}</twig:Ui:Badge>{% endif %}</twig:block>
                            </twig:User:Identity>
                        {% else %}
                            <div class="min-w-0 flex-1 flex items-center gap-2 text-sm">
                                {% if membership.project %}
                                    <twig:Ui:Chip>{{ membership.project.issuePrefix }}</twig:Ui:Chip>
                                    <span class="text-strong truncate">{{ membership.project.name }}</span>
                                {% else %}
                                    <twig:Ui:Chip>{{ membership.workspace.key }}</twig:Ui:Chip>
                                    <a href="{{ path('app_admin_workspace_access', { key: membership.workspace.key }) }}" class="text-strong hover:text-brand truncate">{{ 'admin.access.whole_workspace'|trans({ '%name%': membership.workspace.name }) }}</a>
                                {% endif %}
                            </div>
                        {% endif %}
                        {% set grantsRowRoles = this.rolesFor(grantsUser) %}
                        <select data-model="norender|roles.{{ membership.id }}" data-action="change->live#action" data-live-action-param="changeRole" data-live-membership-param="{{ membership.id }}" aria-label="{{ 'admin.access.role'|trans }}" class="{{ grantsSelectClasses }}">
                            {% for roleId, roleLabel in grantsRowRoles %}
                                <option value="{{ roleId }}" {{ roles[membership.id] is defined and roles[membership.id] == roleId ? 'selected' }}>{{ roleLabel }}</option>
                            {% endfor %}
                            {% if grantsRowRoles[membership.role] is not defined %}
                                <option value="{{ membership.role }}" selected disabled>{{ this.roleLabel(membership.role) }}</option>
                            {% endif %}
                        </select>
                        {# A fixed width, for two buttons: a row with an invitation to send again must not push its role aside. #}
                        <span class="hover-actions flex w-15 shrink-0 items-center justify-end gap-1">
                            {% if grantsPending %}
                                <twig:Ui:IconButton icon="send" :label="'project.access.resend'|trans" data-action="live#action" data-live-action-param="resend" data-live-user-param="{{ grantsUser.id }}" />
                            {% endif %}
                            <twig:Ui:IconButton icon="x" tone="danger" :label="'admin.access.revoke'|trans" data-action="live#action" data-live-action-param="confirmRevoke" data-live-access-param="{{ membership.id }}" />
                        </span>
                    </div>
                    {% if revoking == membership.id %}
                        {{ include('components/_revoke_confirm.html.twig') }}
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    {% endif %}
    {% if not project %}
        <form class="flex flex-wrap items-center gap-2 border-t border-line-subtle bg-subtle/60 px-4 py-3 rounded-b-lg" data-action="live#action:prevent" data-live-action-param="grant">
            {% if workspace %}
                {% set grantsNewUser = this.newUser %}
                {% set grantsCandidates = this.candidates %}
                <twig:Ui:Picker :label="grantsNewUser ? grantsNewUser.fullName : null" :placeholder="'admin.access.choose_user'|trans" :searchPlaceholder="'admin.access.search_user'|trans" :empty="'admin.access.no_match'|trans" class="min-w-0 flex-1 basis-64">
                    <twig:block name="chosen">{% if grantsNewUser %}<twig:User:Line :user="grantsNewUser" />{% endif %}</twig:block>
                    {% for candidate in grantsCandidates %}
                        <twig:Ui:Dropdown:Item :active="candidate.id == newUserId" data-list-filter-target="item" data-text="{{ candidate.fullName }} {{ candidate.email }} {{ candidate.company }}" data-action="live#action dropdown#close" data-live-action-param="chooseUser" data-live-user-param="{{ candidate.id }}">
                            <twig:User:Line :user="candidate" hint />
                        </twig:Ui:Dropdown:Item>
                    {% endfor %}
                </twig:Ui:Picker>
                {% set grantsRoles = this.rolesFor(grantsNewUser) %}
            {% else %}
                {% set grantsTargets = this.targets %}
                {% set grantsTargetLabel = this.targetLabel %}
                <twig:Ui:Picker :label="grantsTargetLabel" :placeholder="'admin.access.choose_target'|trans" :searchPlaceholder="'admin.access.search_target'|trans" :empty="'admin.access.no_match'|trans" class="min-w-0 flex-1 basis-64">
                    {% for target in grantsTargets %}
                        {% set grantsWorkspace = target.workspace %}
                        <twig:Ui:Picker:Group :label="grantsWorkspace.name">
                            <twig:Ui:Dropdown:Item :active="newTarget == 'workspace-' ~ grantsWorkspace.id" data-list-filter-target="item" data-text="{{ grantsWorkspace.name }} {{ grantsWorkspace.key }}" data-action="live#action dropdown#close" data-live-action-param="chooseTarget" data-live-target-param="workspace-{{ grantsWorkspace.id }}">
                                <twig:Ui:Chip class="shrink-0">{{ grantsWorkspace.key }}</twig:Ui:Chip>
                                <span class="truncate">{{ 'admin.access.whole_workspace'|trans({ '%name%': grantsWorkspace.name }) }}</span>
                            </twig:Ui:Dropdown:Item>
                            {% for grantsProject in target.projects %}
                                <twig:Ui:Dropdown:Item :active="newTarget == 'project-' ~ grantsProject.id" data-list-filter-target="item" data-text="{{ grantsProject.name }} {{ grantsProject.issuePrefix }} {{ grantsWorkspace.name }}" data-action="live#action dropdown#close" data-live-action-param="chooseTarget" data-live-target-param="project-{{ grantsProject.id }}">
                                    <twig:Ui:Chip class="shrink-0">{{ grantsProject.issuePrefix }}</twig:Ui:Chip>
                                    <span class="truncate">{{ grantsProject.name }}</span>
                                    {% if grantsProject.readOnly %}<twig:ux:icon name="lucide:archive" class="ml-auto h-3.5 w-3.5 shrink-0 text-faint" />{% endif %}
                                </twig:Ui:Dropdown:Item>
                            {% endfor %}
                        </twig:Ui:Picker:Group>
                    {% endfor %}
                </twig:Ui:Picker>
                {% set grantsRoles = this.rolesFor(user) %}
            {% endif %}
            <select data-model="newRole" aria-label="{{ 'admin.access.role'|trans }}" class="{{ grantsSelectClasses }}">
                <option value="">{{ 'admin.access.choose_role'|trans }}</option>
                {% for roleId, roleLabel in grantsRoles %}
                    <option value="{{ roleId }}" {{ roleId == newRole ? 'selected' }}>{{ roleLabel }}</option>
                {% endfor %}
            </select>
            <twig:Ui:Button type="submit" variant="primary" icon="plus" data-loading="addAttribute(disabled)">{{ 'admin.access.grant'|trans }}</twig:Ui:Button>
        </form>
    {% endif %}
</section>
{% if project and adding %}
    {# Someone is added from one field: an account found by what is typed gets a role, an address no account uses gets an account, a role and an invitation. #}
    {% set grantsChosen = this.chosen %}
    {% set grantsInviting = inviting and this.canInvite %}
    {% set grantsFound = this.suggestions %}
    {% set grantsOffersInvite = not grantsChosen and not grantsInviting and this.canInvite %}
    {% set grantsDialogRoles = grantsChosen ? this.rolesFor(grantsChosen) : (grantsInviting ? this.rolesFor(null, true) : []) %}
    {% set grantsCompanies = grantsInviting ? this.companies : [] %}
    {% set grantsOptionClass = 'flex w-full items-center gap-3 px-3 py-2 text-left hover:bg-subtle aria-selected:bg-brand-soft disabled:cursor-not-allowed disabled:opacity-60 disabled:hover:bg-transparent' %}
    <form data-action="live#action:prevent" data-live-action-param="{{ grantsInviting ? 'invite' : 'grant' }}">
        <twig:Ui:Dialog :title="'project.access.add_title'|trans({ '%project%': project.name })" closeAction="close" size="lg">
            <twig:block name="content">
                <div class="space-y-4">
                    {% if error %}
                        <twig:Ui:Callout tone="danger" size="sm" role="alert">{{ error }}</twig:Ui:Callout>
                    {% endif %}
                    {% if grantsChosen %}
                        <div class="flex items-center gap-3 rounded-md border border-line bg-subtle px-3 py-2">
                            <twig:User:Identity :user="grantsChosen" />
                            <twig:Ui:IconButton icon="x" :label="'project.access.choose_another'|trans" data-action="live#action" data-live-action-param="unchoose" />
                        </div>
                    {% elseif grantsInviting %}
                        <div class="space-y-3 rounded-md border border-amber-line bg-amber-soft p-3">
                            <div class="flex items-start gap-3">
                                <p class="min-w-0 flex-1 text-sm text-amber">{{ 'project.access.new_account'|trans({ '%email%': search|trim }) }}</p>
                                <twig:Ui:IconButton icon="x" :label="'project.access.choose_another'|trans" data-action="live#action" data-live-action-param="unchoose" />
                            </div>
                            <div class="grid sm:grid-cols-2 gap-3">
                                <twig:Ui:Form:Field :label="'admin.user.first_name'|trans" for="grants-first-name" required compact>
                                    <twig:Ui:Form:Input id="grants-first-name" model="norender|firstName" :value="firstName" autocomplete="off" data-controller="autofocus" />
                                </twig:Ui:Form:Field>
                                <twig:Ui:Form:Field :label="'admin.user.last_name'|trans" for="grants-last-name" required compact>
                                    <twig:Ui:Form:Input id="grants-last-name" model="norender|lastName" :value="lastName" autocomplete="off" />
                                </twig:Ui:Form:Field>
                            </div>
                            <twig:Ui:Form:Field :label="'admin.user.company'|trans" for="grants-company" optional compact>
                                <twig:Ui:Form:Combobox id="grants-company" model="norender|company" :value="company" :suggestions="grantsCompanies" />
                            </twig:Ui:Form:Field>
                        </div>
                    {% else %}
                        <div data-controller="suggestions" data-suggestions-for-value="{{ search|trim }}" class="space-y-2">
                            <twig:Ui:Form:Field :label="'project.access.search'|trans" for="grants-search" :help="'project.access.search_help'|trans" compact>
                                <twig:Ui:Form:Input type="search" id="grants-search" model="debounce(300)|search" :value="search" :placeholder="'project.access.search_placeholder'|trans" autocomplete="off" data-controller="autofocus" data-action="keydown->suggestions#navigate" />
                            </twig:Ui:Form:Field>
                            {% if grantsFound.accounts is not empty or grantsOffersInvite %}
                                <ul role="listbox" aria-label="{{ 'project.access.search'|trans }}" class="divide-y divide-line-subtle overflow-hidden rounded-md border border-line">
                                    {% for grantsRow in grantsFound.accounts %}
                                        {% set grantsAccount = grantsRow.user %}
                                        <li>
                                            <button type="button" role="option" tabindex="-1" class="{{ grantsOptionClass }}" {% if grantsRow.state == 'existing' %}data-suggestions-target="option" data-action="live#action" data-live-action-param="choose" data-live-user-param="{{ grantsAccount.id }}"{% else %}disabled{% endif %}>
                                                <twig:User:Identity :user="grantsAccount" size="md" />
                                                {% if grantsRow.state != 'existing' %}<span class="shrink-0 text-xs text-muted">{{ ('project.access.state.' ~ grantsRow.state)|trans }}</span>{% endif %}
                                            </button>
                                        </li>
                                    {% endfor %}
                                    {% if grantsOffersInvite %}
                                        <li>
                                            <button type="button" role="option" tabindex="-1" class="{{ grantsOptionClass }}" data-suggestions-target="option" data-action="live#action" data-live-action-param="startInvite">
                                                <twig:ux:icon name="lucide:user-plus" class="h-4 w-4 shrink-0 text-faint" />
                                                <span class="min-w-0 flex-1 truncate text-sm text-body">{{ 'project.access.invite_address'|trans({ '%email%': search|trim }) }}</span>
                                                <span class="shrink-0 text-xs text-muted">{{ 'project.access.state.new'|trans }}</span>
                                            </button>
                                        </li>
                                    {% endif %}
                                </ul>
                                {% if grantsFound.more > 0 %}
                                    <p class="text-xs text-faint">{{ 'project.access.more_accounts'|trans({ '%count%': grantsFound.more }) }}</p>
                                {% endif %}
                            {% elseif search|trim|length >= 2 %}
                                <p class="text-sm text-muted">{{ 'project.access.no_match'|trans }}</p>
                            {% endif %}
                        </div>
                    {% endif %}
                    {% if grantsDialogRoles is not empty %}
                        <twig:Ui:Form:Field :label="'admin.access.role'|trans" for="grants-role" required compact>
                            <select id="grants-role" data-model="newRole" class="{{ grantsSelectClasses }} w-full"{% if grantsChosen %} data-controller="autofocus"{% endif %}>
                                <option value="">{{ 'admin.access.choose_role'|trans }}</option>
                                {% for roleId, roleLabel in grantsDialogRoles %}
                                    <option value="{{ roleId }}" {{ roleId == newRole ? 'selected' }}>{{ roleLabel }}</option>
                                {% endfor %}
                            </select>
                        </twig:Ui:Form:Field>
                    {% endif %}
                </div>
            </twig:block>
            <twig:block name="footer">
                {% if grantsInviting %}
                    <twig:Ui:Button type="submit" variant="primary" icon="user-plus" data-loading="addAttribute(disabled)">{{ 'project.access.invite'|trans }}</twig:Ui:Button>
                {% else %}
                    <twig:Ui:Button type="submit" variant="primary" icon="plus" :disabled="not grantsChosen" data-loading="addAttribute(disabled)">{{ 'project.access.grant_submit'|trans }}</twig:Ui:Button>
                {% endif %}
                <twig:Ui:Button variant="ghost" data-action="live#action" data-live-action-param="close">{{ 'admin.cancel'|trans }}</twig:Ui:Button>
                {% if grantsInviting %}<span class="ml-auto text-xs text-muted">{{ 'project.access.invite_hint'|trans }}</span>{% endif %}
            </twig:block>
        </twig:Ui:Dialog>
    </form>
{% endif %}
</div>
