{# What happened on a project, for one subscriber: the project as a heading, then one card per issue with what each command did to it (the journal lines, the comment that came with it), the description of an issue created in the meantime, a link to it. The caller left out what the recipient may not see; the comment and description HTML were rendered for them. Tables and inline styles: mail clients know little else. #}
{% extends 'email/_layout.html.twig' %}

{% block title %}{{ project.name }}{% endblock %}

{% block card %}
    {# The paragraphs of rendered markdown carry no style: a mail has no stylesheet to give them their margins. #}
    {% set paragraph = '<p style="margin:0 0 8px;">' %}
    <div style="padding:0 4px 16px;">
        <p style="margin:0;font-size:20px;line-height:1.3;font-weight:700;color:#111827;">{{ project.name }}</p>
        <p style="margin:2px 0 0;font-size:13px;color:#6b7280;">{{ project.workspace.name }} · {{ 'email.issue.heading'|trans({ '%count%': cards|length }) }}</p>
    </div>

    {% for card in cards %}
        {% set issue = card.issue %}
        {% set blocking = issue.criticality.value == 'blocking' %}
        <div style="margin:0 0 12px;background:#ffffff;border:1px solid #e5e7eb;border-radius:12px;overflow:hidden;">
            <div style="padding:16px 20px 14px;border-bottom:1px solid #e5e7eb;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;">
                    <tr>
                        <td style="font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px;color:#6b7280;">{{ issue.key }}</td>
                        {% if blocking %}
                            <td align="right"><span style="display:inline-block;padding:1px 8px;border-radius:999px;background:#fee2e2;color:#b91c1c;font-size:12px;font-weight:600;line-height:18px;">{{ 'criticality.blocking'|trans }}</span></td>
                        {% endif %}
                    </tr>
                </table>
                <p style="margin:4px 0 6px;font-size:17px;line-height:1.3;font-weight:600;"><a href="{{ card.url }}" style="color:#111827;text-decoration:none;">{{ issue.title }}</a></p>
                <p style="margin:0;font-size:13px;color:#6b7280;">
                    <span style="display:inline-block;padding:1px 8px;border-radius:999px;background:#f3f4f6;color:#374151;font-size:12px;font-weight:600;line-height:18px;">{{ issue_place(issue) }}</span>
                    {% if not blocking %}&nbsp;{{ ('criticality.' ~ issue.criticality.value)|trans }}{% endif %}
                    &nbsp;·&nbsp;{{ issue.assignee ? issue.assignee.fullName : 'issue.unassigned'|trans }}
                </p>
            </div>

            <div style="padding:14px 20px;">
                {% for row in card.changes %}
                    {% set change = row.change %}
                    {% set comment = change.comment %}
                    {# Someone who did several things in a row is named once. #}
                    {% set sameActor = not loop.first and card.changes[loop.index0 - 1].change.authorKey == change.authorKey %}
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;margin:{{ loop.first ? '0' : (sameActor ? '4px' : '14px') }} 0 0;">
                        <tr>
                            <td width="38" valign="top">
                                {% if not sameActor and change.actor %}
                                    <span style="display:inline-block;width:28px;height:28px;line-height:28px;border-radius:50%;text-align:center;font-size:11px;font-weight:700;background:{{ change.actor.internal ? '#eef2ff' : '#d1fae5' }};color:{{ change.actor.internal ? '#4f46e5' : '#047857' }};">{{ (change.actor.firstName|first ~ change.actor.lastName|first)|upper }}</span>
                                {% elseif not sameActor %}
                                    {# An automation rule acted: a bolt where the initials would be. #}
                                    <span style="display:inline-block;width:28px;height:28px;line-height:28px;border-radius:8px;text-align:center;font-size:14px;background:#f3f4f6;color:#667080;">&#9889;&#xFE0E;</span>
                                {% endif %}
                            </td>
                            <td valign="top" style="font-size:14px;color:#374151;">
                                {% if not sameActor %}
                                    <span style="font-weight:600;color:#111827;">{{ change.by }}</span>{% if not change.actor %}<span style="font-size:12px;color:#667080;">&nbsp;· {{ 'automation.signature'|trans }}</span>{% endif %}
                                    <span style="font-size:12px;color:#9ca3af;">&nbsp;{{ change.at|format_time('short', locale: app.locale) }}</span>
                                {% endif %}
                                {% for entry in change.entries %}
                                    <p style="margin:2px 0 0;">{{ entry|journal_label }}</p>
                                {% else %}
                                    <p style="margin:2px 0 0;">{{ 'email.issue.commented'|trans }}</p>
                                {% endfor %}
                                {% if comment %}
                                    <div style="margin:6px 0 0;padding:10px 14px 2px;background:{{ comment.private ? '#fef3c7' : '#f6f7f9' }};border-radius:4px 12px 12px 12px;">
                                        {% if comment.private %}<p style="margin:0 0 5px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:#92400e;">{{ 'issue.comment.private_badge'|trans }}</p>{% endif %}
                                        {{ row.commentHtml|replace({ '<p>': paragraph })|raw }}
                                    </div>
                                {% endif %}
                            </td>
                        </tr>
                    </table>
                {% endfor %}

                {% if card.descriptionHtml %}
                    <div style="margin:14px 0 0;padding:10px 14px 2px;border:1px dashed #e5e7eb;border-radius:12px;">
                        <p style="margin:0 0 5px;font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.04em;color:#9ca3af;">{{ 'email.issue.description'|trans }}</p>
                        <div style="font-size:14px;color:#374151;">{{ card.descriptionHtml|replace({ '<p>': paragraph })|raw }}</div>
                    </div>
                {% endif %}
            </div>

            <div style="padding:12px 20px;background:#f6f7f9;font-size:13px;font-weight:600;">
                <a href="{{ card.url }}" style="color:#4f46e5;text-decoration:none;">{{ 'email.issue.open'|trans({ '%key%': issue.key }) }} →</a>
            </div>
        </div>
    {% endfor %}

    <p style="margin:0;padding:8px 4px 0;font-size:12px;color:#9ca3af;">{{ 'email.issue.footer'|trans({ '%count%': cards|length, '%project%': project.name }) }}</p>
{% endblock %}
