{# One issue on a line, in a short list (the home page): key, title with an optional `reason` it is listed for, criticality, place, last update. #}
{% set reason = reason ?? null %}
{% set issueHref = path('app_issue_show', { workspaceKey: issue.project.workspace.key, projectKey: issue.project.key, number: issue.number }) %}
<li class="flex items-center gap-3 px-4 py-2 hover:bg-subtle">
    <twig:Ui:IssueKey :key="issue.key" :href="issueHref" class="w-28 shrink-0" />
    <span class="flex-1 min-w-0">
        <a href="{{ issueHref }}" class="block truncate text-strong hover:text-brand">{{ issue.title }}</a>
        {% if reason %}<span class="block text-xs text-amber">{{ reason }}</span>{% endif %}
    </span>
    <twig:Ui:Criticality:Badge :criticality="issue.criticality.value" />
    <span class="hidden sm:block w-40 shrink-0"><twig:Ui:Status:Step :status="issue_status(issue)" :label="issue_place(issue)" /></span>
    <span class="hidden md:inline w-20 shrink-0 text-right text-xs text-faint">{{ issue.updatedAt|format_date('short') }}</span>
</li>
