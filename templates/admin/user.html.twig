{% extends 'layout/admin.html.twig' %}

{% block page_title %}{{ user.fullName }}{% endblock %}

{% block breadcrumb %}
    <twig:ux:icon name="lucide:chevron-right" class="h-3 w-3 text-ghost shrink-0" />
    <a href="{{ path('app_admin_users') }}" class="hover:text-strong">{{ 'admin.nav.users'|trans }}</a>
{% endblock %}

{% block content %}
    {% set userPending = user.awaitsPassword %}
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-5 space-y-5">
        <div class="flex flex-wrap items-center gap-4">
            <twig:User:Avatar :user="user" size="2xl" />
            <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                    <h1 class="text-xl font-semibold text-strong">{{ user.fullName }}</h1>
                    {% if not user.active %}
                        <twig:Ui:Badge>{{ 'admin.user.state.deactivated'|trans }}</twig:Ui:Badge>
                    {% elseif userPending %}
                        <twig:Ui:Badge tone="amber">{{ 'admin.user.state.invited'|trans }}</twig:Ui:Badge>
                    {% else %}
                        <twig:Ui:Badge tone="emerald">{{ 'admin.user.state.active'|trans }}</twig:Ui:Badge>
                    {% endif %}
                    {% if user.usesSso %}<twig:Ui:Badge tone="blue">{{ ssoName }}</twig:Ui:Badge>{% endif %}
                    {% if user.admin %}<twig:Ui:Badge tone="indigo">{{ 'admin.user.type.admin'|trans }}</twig:Ui:Badge>{% endif %}
                    {% if user.hasTotp %}<twig:Ui:Badge tone="emerald" icon="shield-check" data-test="two-factor-badge">{{ 'admin.user.two_factor.badge'|trans }}</twig:Ui:Badge>{% endif %}
                </div>
                <p class="mt-0.5 text-sm text-muted">{{ user.email }}{% if user.company %} · {{ user.company }}{% endif %} · {{ (user.internal ? 'admin.user.type.internal' : 'admin.user.type.external')|trans }}</p>
            </div>
            {% if userPending %}
                <form method="post" action="{{ path('app_admin_user_invite', { id: user.id }) }}" class="ml-auto">
                    <input type="hidden" name="_token" value="{{ csrf_token('submit') }}" data-controller="csrf-protection">
                    <twig:Ui:Button type="submit" icon="send">{{ 'admin.user.invitation_resend'|trans }}</twig:Ui:Button>
                </form>
            {% endif %}
        </div>

        {% if userPending %}
            <twig:Ui:Callout tone="amber" size="sm">{{ 'admin.user.invitation_pending'|trans({ '%email%': user.email }) }}</twig:Ui:Callout>
        {% endif %}

        {% if user.active and user.usesSso and user.oidcSubject is null %}
            <twig:Ui:Callout tone="amber" size="sm">{{ 'admin.user.sso_pending'|trans({ '%provider%': ssoName, '%email%': user.email }) }}</twig:Ui:Callout>
        {% endif %}

        {{ form_start(form, { attr: { class: 'rounded-lg border border-line bg-surface p-4 sm:p-5 space-y-4' } }) }}
            {{ form_errors(form) }}
            <div class="grid sm:grid-cols-2 gap-4">
                {{ form_row(form.firstName) }}
                {{ form_row(form.lastName) }}
            </div>
            <div class="grid sm:grid-cols-2 gap-4">
                {{ form_row(form.email) }}
                {{ form_row(form.company) }}
            </div>
            {{ form_row(form.type) }}
            {% if form.authMethod is defined %}{{ form_row(form.authMethod) }}{% endif %}
            {{ form_row(form.active) }}
            <twig:Ui:Button type="submit" variant="primary" size="lg">{{ 'admin.save'|trans }}</twig:Ui:Button>
        {{ form_end(form) }}

        <section class="space-y-2">
            <h2 class="font-semibold text-strong">{{ 'admin.workspace.tab.access'|trans }}</h2>
            <p class="text-xs text-muted">{{ 'admin.access.user_intro'|trans }}</p>
            <twig:Membership:Grants :user="user" />
        </section>

        {% if user.hasTotp and user.id != app.user.id %}
            <section class="rounded-lg border border-line bg-surface p-4 sm:p-5">
                <h2 class="font-semibold text-strong">{{ 'admin.user.two_factor.title'|trans }}</h2>
                <p class="text-xs text-muted">{{ 'admin.user.two_factor.help'|trans }}</p>
                <twig:Ui:Disclosure :closedLabel="'admin.user.two_factor.reset'|trans" :openLabel="'issue.edit.cancel'|trans" class="mt-2">
                    <div class="mt-2 flex flex-wrap items-center gap-2" role="alertdialog">
                        <span class="flex-1 text-sm">{{ 'admin.user.two_factor.reset_confirm'|trans({ '%name%': user.fullName }) }}</span>
                        <form method="post" action="{{ path('app_admin_user_two_factor_reset', { id: user.id }) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('submit') }}" data-controller="csrf-protection">
                            <twig:Ui:Button type="submit" size="sm" variant="danger" icon="shield-alert">{{ 'admin.user.two_factor.reset'|trans }}</twig:Ui:Button>
                        </form>
                    </div>
                </twig:Ui:Disclosure>
            </section>
        {% endif %}

        {% if user.id != app.user.id %}
            <twig:Ui:Callout tone="danger">
                <h2 class="font-semibold text-strong">{{ 'admin.user.delete'|trans }}</h2>
                {% if hasHistory %}
                    <p class="text-xs text-muted">{{ 'admin.user.delete_blocked'|trans }}</p>
                {% else %}
                    <p class="text-xs text-muted">{{ 'admin.user.delete_help'|trans }}</p>
                    <twig:Ui:Disclosure :closedLabel="'admin.user.delete'|trans" :openLabel="'issue.edit.cancel'|trans" class="mt-2">
                        <div class="mt-2 flex flex-wrap items-center gap-2" role="alertdialog">
                            <span class="flex-1 text-sm">{{ 'admin.user.delete_confirm'|trans({ '%name%': user.fullName }) }}</span>
                            <form method="post" action="{{ path('app_admin_user_delete', { id: user.id }) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('submit') }}" data-controller="csrf-protection">
                                <twig:Ui:Button type="submit" size="sm" variant="danger" icon="trash-2">{{ 'admin.user.delete'|trans }}</twig:Ui:Button>
                            </form>
                        </div>
                    </twig:Ui:Disclosure>
                {% endif %}
            </twig:Ui:Callout>
        {% endif %}
    </div>
{% endblock %}
