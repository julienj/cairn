{# The page of an import outside its configuration: its progress while a worker is on it, then its report. A stopped import may be resumed or abandoned. #}
{% extends 'admin/import/base.html.twig' %}

{% block import_content %}
    {% if import.error %}
        <twig:Ui:Callout tone="danger" role="alert">
            <p class="font-medium text-strong">{{ 'admin.import.stopped'|trans }}</p>
            <p class="mt-1 break-words">{{ import.error }}</p>
        </twig:Ui:Callout>
    {% endif %}

    {% if import.status.inProgress %}
        <twig:Import:Progress :import="import" />
    {% endif %}

    {% if import.resumable %}
        <div class="flex flex-wrap items-center gap-2 rounded-lg border border-line bg-surface px-4 py-3">
            <p class="text-sm text-body">{{ (import.stale ? 'admin.import.stale' : 'admin.import.resume_help')|trans }}</p>
            <form method="post" action="{{ path('app_admin_import_start', { id: import.id }) }}" class="ml-auto">
                <input type="hidden" name="_token" value="{{ csrf_token('submit') }}" data-controller="csrf-protection">
                <twig:Ui:Button type="submit" variant="primary">{{ 'admin.import.resume'|trans }}</twig:Ui:Button>
            </form>
            {{ include('admin/import/_abandon.html.twig') }}
        </div>
    {% endif %}

    {% if import.startedAt and not import.status.inProgress %}
        <section class="space-y-3">
            <div class="flex flex-wrap items-center gap-2">
                <h2 class="font-semibold text-strong">{{ 'admin.import.report.title'|trans }}</h2>
                {% if import.finishedAt %}<span class="text-xs text-muted">{{ 'admin.import.report.finished'|trans({ '%date%': import.finishedAt|format_datetime('short', 'short') }) }}</span>{% endif %}
                <twig:Ui:Button href="{{ path('app_project_issues', { workspaceKey: import.project.workspace.key, projectKey: import.project.key }) }}" class="ml-auto">{{ 'admin.import.report.open_project'|trans }}</twig:Ui:Button>
            </div>
            <div class="grid grid-cols-2 sm:grid-cols-5 gap-3">
                <twig:Ui:StatTile :label="'admin.import.count.issues'|trans" :value="counts.issue" />
                <twig:Ui:StatTile :label="'admin.import.count.comments'|trans" :value="import.commentsWritten" />
                <twig:Ui:StatTile :label="'admin.import.count.files'|trans" :value="import.filesWritten" />
                <twig:Ui:StatTile :label="'admin.import.count.accounts'|trans" :value="counts.user" />
                <twig:Ui:StatTile :label="'admin.import.count.access'|trans" :value="counts.membership" />
            </div>

            {% if import.status.value == 'completed' %}
                <p class="flex items-center gap-2 rounded-lg border border-line bg-surface px-4 py-3 text-sm text-body"><twig:ux:icon name="lucide:check" class="h-4 w-4 text-emerald" />{{ 'admin.import.report.archived'|trans }}</p>
            {% endif %}

            {% if toInvite is not empty %}
                <twig:Ui:Callout tone="blue">
                    <p class="font-medium">{{ 'admin.import.report.to_invite'|trans({ '%count%': toInvite|length }) }}</p>
                    <ul class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-sm">
                        {% for user in toInvite %}
                            <li><a href="{{ path('app_admin_user', { id: user.id }) }}" class="underline">{{ user.fullName }}</a></li>
                        {% endfor %}
                    </ul>
                </twig:Ui:Callout>
            {% endif %}

            {% if refused is not empty %}
                <section class="rounded-lg border border-line bg-surface">
                    <h3 class="border-b border-line-subtle px-4 py-3 font-semibold text-strong">{{ 'admin.import.report.left_out'|trans({ '%count%': refused|length }) }}</h3>
                    <ul class="divide-y divide-line-subtle text-sm">
                        {% for record in refused %}
                            <li class="flex flex-wrap items-baseline gap-x-3 px-4 py-2">
                                <twig:Ui:Badge size="sm">{{ ('admin.import.kind.' ~ record.kind.value)|trans }}</twig:Ui:Badge>
                                <span class="text-strong">{{ record.label }}</span>
                                <span class="basis-full sm:basis-auto sm:ml-auto text-xs text-muted">{{ record.problem }}</span>
                            </li>
                        {% endfor %}
                    </ul>
                </section>
            {% endif %}
        </section>
    {% endif %}
{% endblock %}
