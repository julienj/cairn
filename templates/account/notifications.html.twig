{% extends 'layout/account.html.twig' %}

{% block page_title %}{{ 'account.nav.notifications'|trans }}{% endblock %}

{% block page_intro %}{{ 'account.notifications.intro'|trans }}{% endblock %}

{# How the notification mails of the signed-in user are grouped: `form` holds one choice, drawn as a card per grouping, the last sending none. #}
{% block content %}
    {{ form_start(form, { attr: { class: 'space-y-5' } }) }}
        <fieldset class="rounded-lg border border-line bg-surface p-4 sm:p-5">
            <legend class="contents"><span class="font-semibold text-strong">{{ 'account.notifications.grouping.label'|trans }}</span></legend>
            <div class="mt-3 grid gap-3 lg:grid-cols-3">
                {% for notificationsChoice in form.mailGrouping %}
                    <twig:Ui:Form:RadioCard
                        :title="notificationsChoice.vars.label|trans"
                        :description="('account.notifications.grouping.' ~ notificationsChoice.vars.value ~ '.description')|trans"
                        :checked="notificationsChoice.vars.checked"
                        :id="notificationsChoice.vars.id"
                        :name="notificationsChoice.vars.full_name"
                        :value="notificationsChoice.vars.value"
                    />
                    {% do notificationsChoice.setRendered %}
                {% endfor %}
            </div>
            {{ form_errors(form.mailGrouping) }}
            {% do form.mailGrouping.setRendered %}
        </fieldset>
        <twig:Ui:Button type="submit" variant="primary" size="lg">{{ 'account.notifications.save'|trans }}</twig:Ui:Button>
    {{ form_end(form) }}
{% endblock %}
