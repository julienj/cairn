{% extends 'layout/account.html.twig' %}

{% block page_title %}{{ 'mcp.title'|trans }}{% endblock %}

{% block page_intro %}{{ 'mcp.intro'|trans }}{% endblock %}

{% block page_actions %}<twig:Ui:Button icon="key-round" href="{{ path('app_api_tokens') }}">{{ 'mcp.tokens'|trans }}</twig:Ui:Button>{% endblock %}

{# How to plug an assistant on the MCP server of this instance: the command for Claude Code, with the address of the server and the place of the token, and what its token and its comments are worth. The assistant lists its tools itself. #}
{% block content %}
    <section class="rounded-lg border border-line bg-surface p-4 sm:p-5">
        <h2 class="font-semibold text-strong">{{ 'mcp.connect.title'|trans }}</h2>
        <p class="mt-1 text-sm text-muted">{{ 'mcp.connect.hint'|trans }}</p>
        <div class="mt-3 flex items-start gap-2" data-controller="clipboard">
            <pre class="min-w-0 flex-1 overflow-x-auto rounded-md bg-slate-900 px-3 py-2 font-mono text-xs text-slate-100" data-clipboard-target="source" data-test="mcp-command">claude mcp add --scope user --transport http cairn {{ url('_mcp_endpoint_cairn') }} --header "Authorization: Bearer cairn_…"</pre>
            <twig:Ui:CopyButton :label="'mcp.connect.copy'|trans" :copiedLabel="'mcp.connect.copied'|trans" />
        </div>
        <p class="mt-3 text-xs text-muted">{{ 'mcp.connect.scope'|trans }}</p>
        <p class="mt-1 text-xs text-muted">{{ 'mcp.connect.private'|trans }}</p>
    </section>

{% endblock %}
